<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ember</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Mono', monospace;
            background: #0a0a0a;
            color: #e0e0e0;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        #header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid #333;
        }

        #header h1 {
            font-size: 24px;
            color: #ff6b35;
        }

        #chat {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .message {
            padding: 15px 20px;
            border-radius: 8px;
            max-width: 80%;
            line-height: 1.6;
        }

        .user {
            background: #1a1a1a;
            align-self: flex-end;
            border: 1px solid #333;
        }

        .assistant {
            background: linear-gradient(135deg, #1a1a1a 0%, #2a1a1a 100%);
            align-self: flex-start;
            border: 1px solid #ff6b35;
        }

        .image-display {
            margin: 10px 0;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #333;
        }

        .image-display img {
            width: 100%;
            display: block;
        }

        .html-display {
            margin: 10px 0;
            border: 1px solid #333;
            border-radius: 8px;
            overflow: hidden;
        }

        .html-display iframe {
            width: 100%;
            height: 400px;
            border: none;
            display: block;
        }

        .video-display {
            margin: 10px 0;
            border-radius: 8px;
            overflow: hidden;
        }

        .video-display video {
            width: 100%;
            display: block;
        }

        .audio-display {
            margin: 10px 0;
            padding: 15px;
            background: #1a1a1a;
            border-radius: 8px;
            border: 1px solid #333;
        }

        .audio-display audio {
            width: 100%;
        }

        #input-area {
            padding: 20px;
            border-top: 1px solid #333;
            display: flex;
            gap: 10px;
        }

        #input {
            flex: 1;
            padding: 15px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 8px;
            color: #e0e0e0;
            font-family: inherit;
            font-size: 14px;
        }

        #input:focus {
            outline: none;
            border-color: #ff6b35;
        }

        #send-btn {
            padding: 15px 30px;
            background: #ff6b35;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.2s;
        }

        #send-btn:hover {
            background: #ff8555;
        }

        #send-btn:disabled {
            background: #333;
            cursor: not-allowed;
        }

        #status {
            padding: 10px;
            text-align: center;
            font-size: 12px;
            color: #666;
            border-top: 1px solid #222;
        }

        .thinking {
            padding: 15px 20px;
            background: #1a1a1a;
            border: 1px solid #ff6b35;
            border-radius: 8px;
            max-width: 80%;
            align-self: flex-start;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .file-header {
            padding: 8px 12px;
            background: #111;
            border-bottom: 1px solid #333;
            font-size: 12px;
            color: #999;
        }
    </style>
</head>
<body>
    <div id="header">
        <h1>🔥 EMBER</h1>
    </div>

    <div id="chat"></div>

    <div id="input-area">
        <input type="text" id="input" placeholder="Ask Ember to create something..." />
        <button id="send-btn">Send</button>
    </div>

    <div id="status">Ready</div>

    <script>
        const API_URL = 'http://localhost:8080';
        const chat = document.getElementById('chat');
        const input = document.getElementById('input');
        const sendBtn = document.getElementById('send-btn');
        const statusDiv = document.getElementById('status');

        let isProcessing = false;

        function addMessage(text, isUser = false) {
            const div = document.createElement('div');
            div.className = `message ${isUser ? 'user' : 'assistant'}`;
            div.textContent = text;
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
            return div;
        }

        function showThinking() {
            const div = document.createElement('div');
            div.className = 'thinking';
            div.id = 'thinking-indicator';
            div.textContent = 'Ember is creating...';
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
        }

        function hideThinking() {
            const thinking = document.getElementById('thinking-indicator');
            if (thinking) thinking.remove();
        }

        function detectCreatedFiles(response) {
            const files = {
                images: [],
                html: [],
                videos: [],
                audio: []
            };

            // Look for file paths in response
            const imagePattern = /([^\s]+\.(?:png|jpg|jpeg|gif|webp))/gi;
            const htmlPattern = /([^\s]+\.html)/gi;
            const videoPattern = /([^\s]+\.(?:mp4|webm))/gi;
            const audioPattern = /([^\s]+\.(?:wav|mp3|ogg))/gi;

            const imageMatches = response.match(imagePattern);
            const htmlMatches = response.match(htmlPattern);
            const videoMatches = response.match(videoPattern);
            const audioMatches = response.match(audioPattern);

            if (imageMatches) files.images = imageMatches;
            if (htmlMatches) files.html = htmlMatches;
            if (videoMatches) files.videos = videoMatches;
            if (audioMatches) files.audio = audioMatches;

            return files;
        }

        function displayFiles(files, messageDiv) {
            // Display images
            files.images.forEach(img => {
                const container = document.createElement('div');
                container.className = 'image-display';
                container.innerHTML = `
                    <div class="file-header">🖼️ ${img}</div>
                    <img src="${API_URL}/image/${img}" alt="${img}" />
                `;
                messageDiv.appendChild(container);
            });

            // Display HTML
            files.html.forEach(html => {
                const container = document.createElement('div');
                container.className = 'html-display';
                container.innerHTML = `
                    <div class="file-header">🌐 ${html} <a href="${API_URL}/html/${html}" target="_blank" style="float: right; color: #ff6b35;">Open ↗</a></div>
                    <iframe src="${API_URL}/html/${html}"></iframe>
                `;
                messageDiv.appendChild(container);
            });

            // Display videos
            files.videos.forEach(video => {
                const container = document.createElement('div');
                container.className = 'video-display';
                container.innerHTML = `
                    <div class="file-header">🎬 ${video}</div>
                    <video controls autoplay loop>
                        <source src="${API_URL}/video/${video}">
                    </video>
                `;
                messageDiv.appendChild(container);
            });

            // Display audio
            files.audio.forEach(audio => {
                const container = document.createElement('div');
                container.className = 'audio-display';
                container.innerHTML = `
                    <div class="file-header">🎵 ${audio}</div>
                    <audio controls autoplay>
                        <source src="${API_URL}/audio/${audio}">
                    </audio>
                `;
                messageDiv.appendChild(container);
            });
        }

        async function sendMessage() {
            if (isProcessing || !input.value.trim()) return;

            const message = input.value.trim();
            input.value = '';
            isProcessing = true;
            sendBtn.disabled = true;
            statusDiv.textContent = 'Thinking...';

            // Show user message
            addMessage(message, true);
            showThinking();

            try {
                const response = await fetch(`${API_URL}/chat`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });

                const data = await response.json();
                hideThinking();

                if (data.error) {
                    addMessage(`❌ Error: ${data.error}`);
                } else {
                    const msgDiv = addMessage(data.response);
                    
                    // Detect and display created files
                    const files = detectCreatedFiles(data.response);
                    displayFiles(files, msgDiv);
                }

            } catch (error) {
                hideThinking();
                addMessage(`❌ Connection error: ${error.message}`);
            }

            isProcessing = false;
            sendBtn.disabled = false;
            statusDiv.textContent = 'Ready';
            input.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // Check status on load
        fetch(`${API_URL}/status`)
            .then(r => r.json())
            .then(data => {
                statusDiv.textContent = `Ready - ${data.model}`;
            })
            .catch(() => {
                statusDiv.textContent = 'Disconnected';
            });
    </script>
</body>
</html>

