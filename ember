def nexus_ask(question: str):
    """Ask Nexus for multi-agent synthesis"""
    try:
        from nexus_gen3 import Nexus
        nexus = Nexus()
        result = nexus.think_collaboratively(question)
        return result.get('nexus_insight', result.get('response', 'No response'))
    except Exception as e:
