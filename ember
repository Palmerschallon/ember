def interactive_mode():
    """Simple interactive REPL"""
    print("\n🔥 EMBER\n")
    print("Commands:")
    print("  /phoenix [question] - Ask Phoenix (historical wisdom)")
    print("  /nexus [question]   - Ask Nexus (multi-agent synthesis)")
    print("  /exit               - Exit")
    print("  Otherwise: Talk to Ember\n")

    while True:
        try:
            user_input = input("🔥 > ").strip()

            if not user_input:
                continue

            if user_input == "/exit":
                break

            print()

            if user_input.startswith("/phoenix "):
                question = user_input[9:]
                response = phoenix_ask(question)
            elif user_input.startswith("/nexus "):
                question = user_input[7:]
                response = nexus_ask(question)
            else:
                response = quick_ask(user_input)

            print(response)
            print()

        except KeyboardInterrupt:
            print("\n\nUse /exit to quit\n")
            continue
        except EOFError:
            break

    print("\n👋 Goodbye!\n")

