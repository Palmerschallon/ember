            update(neurons) {
                // Flocking behavior
                let sep = { x: 0, y: 0 };
                let ali = { x: 0, y: 0 };
                let coh = { x: 0, y: 0 };
                let count = 0;
                
                this.connections = [];
                
                for (let other of neurons) {
