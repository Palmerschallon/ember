                        {"role": "user", "content": varied_prompt}
                    ],
                    temperature=0.7 + (index * 0.05),  # Vary temperature
                    max_tokens=1000
                )
                return response.choices[0].message.content
            elif model == "claude":
                import anthropic
                client = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)
