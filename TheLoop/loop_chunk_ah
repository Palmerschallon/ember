            "file": file_to_read,
            "result": read_own_file(file_to_read)
        }
    
    # Check for file EDIT requests
    edit_match = re.search(r'```edit\s+(.+?)\s+(.+?)\s*->\s*(.+?)\s*```', response_text, re.DOTALL)
    if edit_match:
        file_to_edit = edit_match.group(1).strip()
