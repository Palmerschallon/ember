        class Neuron {
            constructor() {
                this.x = width / 2 + (Math.random() - 0.5) * 600;
                this.y = height / 2 + (Math.random() - 0.5) * 600;
                this.vx = (Math.random() - 0.5) * 1.5;
                this.vy = (Math.random() - 0.5) * 1.5;
                this.type = 'idle';
                this.energy = 0.5;
                this.baseSize = 3 + Math.random() * 3;
                this.pulsePhase = Math.random() * Math.PI * 2;
                this.age = 0;
                this.connections = [];
                this.pulseColor = null; // FOR CODE TYPE COLORS
                
                this.colors = {
                    'idle': '#4a90e2',
                    'thinking': '#2196F3',
                    'reading': '#FFC107',
                    'writing': '#FF9800',
                    'executing': '#F44336',
                    'complete': '#4CAF50'
                };
            }
            
            update(neurons) {
                // Flocking behavior
                let sep = { x: 0, y: 0 };
                let ali = { x: 0, y: 0 };
                let coh = { x: 0, y: 0 };
                let count = 0;
                
                this.connections = [];
                
                for (let other of neurons) {
                    if (other === this) continue;
                    
                    const dx = other.x - this.x;
                    const dy = other.y - this.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    
                    if (dist < 100) {
                        this.connections.push({ neuron: other, distance: dist });
                        
                        if (dist < 40) {
                            sep.x -= dx / dist;
                            sep.y -= dy / dist;
                        }
                        
                        ali.x += other.vx;
                        ali.y += other.vy;
                        coh.x += other.x;
                        coh.y += other.y;
                        count++;
                    }
                }
                
                if (count > 0) {
                    ali.x /= count;
                    ali.y /= count;
                    coh.x /= count;
                    coh.y /= count;
                    
                    this.vx += sep.x * 0.05 + (ali.x - this.vx) * 0.02 + (coh.x - this.x) * 0.001;
                    this.vy += sep.y * 0.05 + (ali.y - this.vy) * 0.02 + (coh.y - this.y) * 0.001;
                }
                
                // Limit speed
                const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
                if (speed > 2) {
                    this.vx = (this.vx / speed) * 2;
                    this.vy = (this.vy / speed) * 2;
                }
                
                this.x += this.vx;
                this.y += this.vy;
                
                // Gentle attraction to center
                const centerX = width / 2;
                const centerY = height / 2;
                const toCenterX = centerX - this.x;
                const toCenterY = centerY - this.y;
                this.vx += toCenterX * 0.0001;
                this.vy += toCenterY * 0.0001;
                
                // Wrap around
                if (this.x < 0) this.x = width;
                if (this.x > width) this.x = 0;
                if (this.y < 0) this.y = height;
                if (this.y > height) this.y = 0;
                
                // Energy decay
                this.age++;
                if (this.age > 60 && this.type !== 'idle') {
                    this.energy *= 0.97;
                    if (this.energy < 0.5) {
                        this.type = 'idle';
                        this.energy = 0.5;
                        this.age = 0;
                        this.pulseColor = null; // Clear color override
                    }
                }
                
                this.pulsePhase += 0.02;
            }
            
            draw() {
                // Use pulseColor if set (from code analysis), otherwise use type color
                const color = this.pulseColor || this.colors[this.type] || '#4a90e2';  // Fallback to blue
                const breathe = Math.sin(this.pulsePhase) * 0.3 + 1;
                const size = this.baseSize * breathe;
                const glowSize = 30 * this.energy * breathe;
                
                // Outer glow
                const outerGradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, glowSize * 1.5);
                outerGradient.addColorStop(0, color);
                outerGradient.addColorStop(0.5, color + '44');  // Add alpha
                outerGradient.addColorStop(1, 'transparent');
                ctx.globalAlpha = this.energy * 0.4;
                ctx.fillStyle = outerGradient;
                ctx.beginPath();
                ctx.arc(this.x, this.y, glowSize * 1.5, 0, Math.PI * 2);
