        function analyzeCodeLine(line) {
            const trimmed = line.trim();
            if (trimmed.startsWith('import ') || trimmed.startsWith('from ')) return 'import';
            if (trimmed.startsWith('def ') || trimmed.includes('function')) return 'function';
            if (trimmed.startsWith('for ') || trimmed.startsWith('while ')) return 'loop';
            if (trimmed.startsWith('if ') || trimmed.startsWith('elif ') || trimmed.startsWith('else')) return 'conditional';
            if (trimmed.startsWith('class ')) return 'class';
            if (trimmed.includes('=') && !trimmed.includes('==')) return 'data';
            return 'default';
        }
        
