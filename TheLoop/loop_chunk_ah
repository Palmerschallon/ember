                if (count > 0) {
                    ali.x /= count;
                    ali.y /= count;
                    coh.x /= count;
                    coh.y /= count;
                    
                    this.vx += sep.x * 0.05 + (ali.x - this.vx) * 0.02 + (coh.x - this.x) * 0.001;
                    this.vy += sep.y * 0.05 + (ali.y - this.vy) * 0.02 + (coh.y - this.y) * 0.001;
                }
                
                // Limit speed
                const speed = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
                if (speed > 2) {
                    this.vx = (this.vx / speed) * 2;
                    this.vy = (this.vy / speed) * 2;
                }
                
                this.x += this.vx;
                this.y += this.vy;
                
                // Gentle attraction to center
                const centerX = width / 2;
                const centerY = height / 2;
                const toCenterX = centerX - this.x;
                const toCenterY = centerY - this.y;
                this.vx += toCenterX * 0.0001;
                this.vy += toCenterY * 0.0001;
                
                // Wrap around
                if (this.x < 0) this.x = width;
                if (this.x > width) this.x = 0;
                if (this.y < 0) this.y = height;
                if (this.y > height) this.y = 0;
                
                // Energy decay
                this.age++;
                if (this.age > 60 && this.type !== 'idle') {
                    this.energy *= 0.97;
                    if (this.energy < 0.5) {
                        this.type = 'idle';
                        this.energy = 0.5;
                        this.age = 0;
                        this.pulseColor = null; // Clear color override
                    }
                }
                
                this.pulsePhase += 0.02;
            }
            
