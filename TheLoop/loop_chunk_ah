    """Search semantic mesh for related knowledge - ChromaDB or SQLite fallback"""
    
    # 🔥 USE CHROMADB IF AVAILABLE (semantic search!)
    if CHROMA_AVAILABLE:
        try:
            results = chroma_recall(query, limit=limit)
            # Convert ChromaDB format to our format
