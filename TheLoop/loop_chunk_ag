        let droneOscillators = [];
        let droneGains = [];
        
        function startBrainwaveDrone() {
            if (!audioCtx) return;
            
            console.log('🧘 Starting brainwave drone...');
            
            // Base frequencies for continuous presence
            const drones = [
                { freq: 128, gain: 0.03, detune: 0 },      // Sub-bass foundation
                { freq: 128, gain: 0.03, detune: 2 },      // Slight detuning for richness
                { freq: 192, gain: 0.025, detune: -1 },    // Perfect fifth above
                { freq: 256, gain: 0.02, detune: 1 },      // Octave up
            ];
            
            drones.forEach((drone, i) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const filter = audioCtx.createBiquadFilter();
                
                osc.type = 'sine';
                osc.frequency.value = drone.freq;
                osc.detune.value = drone.detune;
                
                // Slow breathing modulation
                const lfo = audioCtx.createOscillator();
                const lfoGain = audioCtx.createGain();
                lfo.type = 'sine';
                lfo.frequency.value = 0.05 + (i * 0.02);  // Very slow
                lfoGain.gain.value = 0.3;
                
                lfo.connect(lfoGain);
                lfoGain.connect(gain.gain);
                
                filter.type = 'lowpass';
                filter.frequency.value = 800;
                filter.Q.value = 1.0;
                
                gain.gain.value = drone.gain;
                
                osc.connect(filter);
                filter.connect(gain);
                gain.connect(reverbNode);
                
                osc.start();
                lfo.start();
                
                droneOscillators.push(osc);
                droneGains.push(gain);
            });
            
            console.log('✅ Brainwave drone active');
        }
        
        // Modulate drone intensity based on activity
        function modulateDrone(intensity = 1.0) {
            droneGains.forEach((gain, i) => {
                const baseGain = [0.03, 0.03, 0.025, 0.02][i];
                const targetGain = baseGain * (0.7 + (intensity * 0.3));
                gain.gain.linearRampToValueAtTime(targetGain, audioCtx.currentTime + 0.5);
            });
        }
        
        // Start audio on any user interaction
        document.addEventListener('click', initAudio, { once: true });
        document.addEventListener('keydown', initAudio, { once: true });
        
        const CRYSTAL_BOWLS = [
            { freq: 256, note: 'C', chakra: 'Root', color: '#ff0000' },
            { freq: 288, note: 'D', chakra: 'Sacral', color: '#ff8800' },
            { freq: 320, note: 'E', chakra: 'Solar', color: '#ffff00' },
            { freq: 341.3, note: 'F', chakra: 'Heart', color: '#00ff00' },
            { freq: 384, note: 'G', chakra: 'Throat', color: '#0088ff' },
            { freq: 426.7, note: 'A', chakra: 'Third Eye', color: '#8800ff' },
            { freq: 480, note: 'B', chakra: 'Crown', color: '#ff00ff' }
        ];
        
        let noteHistory = [];
        
        function playCrystalBowl(bowlIndex, intensity = 1.0, duration = 3.0) {
            if (!audioCtx) {
                console.warn('⚠️ AudioContext not ready');
                return;
            }
            
            console.log(`🎵 Playing bowl ${bowlIndex} (${CRYSTAL_BOWLS[bowlIndex].note})`);
            
            const bowl = CRYSTAL_BOWLS[bowlIndex];
            const now = audioCtx.currentTime;
            
            const harmonics = [
                { mult: 1.0, gain: 1.0 },
                { mult: 2.0, gain: 0.6 },
                { mult: 3.0, gain: 0.4 },
                { mult: 4.0, gain: 0.25 },
                { mult: 5.0, gain: 0.15 }
            ];
            
            harmonics.forEach((harmonic) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const filter = audioCtx.createBiquadFilter();
                const lfo = audioCtx.createOscillator();
                const lfoGain = audioCtx.createGain();
                
                osc.type = 'sine';
                osc.frequency.value = bowl.freq * harmonic.mult;
                
                lfo.type = 'sine';
                lfo.frequency.value = 4 + Math.random() * 2;
                lfoGain.gain.value = 0.5;
                
                lfo.connect(lfoGain);
                lfoGain.connect(osc.frequency);
                
                filter.type = 'lowpass';
                filter.frequency.value = 2000;
                filter.Q.value = 0.7;
                
                const maxGain = (0.08 * intensity * harmonic.gain) / harmonics.length;
                gain.gain.value = 0;
                gain.gain.linearRampToValueAtTime(maxGain, now + 0.8);
                gain.gain.linearRampToValueAtTime(maxGain * 0.9, now + duration - 0.5);
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
                
                osc.connect(filter);
                filter.connect(gain);
                
                // Connect to destination - simple and direct
                if (reverbNode) {
                    gain.connect(reverbNode);
                } else {
                    gain.connect(audioCtx.destination);
                }
                
                osc.start(now);
                lfo.start(now);
                osc.stop(now + duration);
                lfo.stop(now + duration);
            });
            
            // Skip addNoteToHistory if it causes issues
            try {
                addNoteToHistory(bowl.note, bowl.chakra);
            } catch (e) {
                console.warn('Note history error:', e);
            }
        }
        
        function tokenToNote(token) {
            let hash = 0;
            for (let i = 0; i < token.length; i++) {
                hash = ((hash << 5) - hash) + token.charCodeAt(i);
                hash |= 0;
            }
            const bowlIndex = Math.abs(hash) % CRYSTAL_BOWLS.length;
            const intensity = Math.min(1.0, token.length / 20);
            const keywords = ['function', 'class', 'const', 'let', 'import', 'export', 'if', 'for', 'while'];
            const isKeyword = keywords.some(kw => token.toLowerCase().includes(kw));
            const duration = isKeyword ? 2.5 : 1.5;
            
            playCrystalBowl(bowlIndex, intensity, duration);
            return { bowl: CRYSTAL_BOWLS[bowlIndex].note, token };
        }
        
        function fileToChord(filename) {
            const ext = filename.split('.').pop().toLowerCase();
            const chordMap = {
                'py': [0, 2, 4],
                'js': [1, 3, 5],
                'html': [0, 4, 6],
                'css': [2, 4, 6],
                'json': [1, 3, 6],
                'md': [0, 2, 5]
            };
            
            const chord = chordMap[ext] || [0, 2, 4];
            chord.forEach((bowlIndex, i) => {
                setTimeout(() => {
                    playCrystalBowl(bowlIndex, 0.8, 3.0);
                }, i * 150);
            });
            
            addNoteToHistory(`${filename} chord`, 'file');
        }
        
        function documentToMelody(docType) {
            const melodies = {
                'thinking': [0, 2, 4, 2],
                'reading': [0, 1, 2, 3, 4],
                'writing': [4, 2, 0, 2, 4],
                'executing': [0, 4, 6, 4, 0]
            };
            
            const melody = melodies[docType] || melodies['thinking'];
            melody.forEach((bowlIndex, i) => {
                setTimeout(() => {
                    playCrystalBowl(bowlIndex, 0.6, 2.0);
                }, i * 400);
            });
        }
        
        function addNoteToHistory(note, context) {
            noteHistory.unshift({ note, context, time: Date.now() });
            if (noteHistory.length > 15) noteHistory.pop();
            updateNoteDisplay();
        }
        
        function updateNoteDisplay() {
            const container = document.getElementById('notes-content');
            container.innerHTML = noteHistory.map(n => {
                const bowl = CRYSTAL_BOWLS.find(b => n.note.includes(b.note));
                const color = bowl ? bowl.color : '#888';
                return `<div class="note-line" style="color: ${color}">${n.note}</div>`;
            }).join('');
        }

        // Play single note (for quick events)
        function playNote(note, volume = 0.1) {
            if (!audioCtx) return; // Skip if audio not initialized
            
            const freq = noteToFreq(note);
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            
            osc.frequency.value = freq;
            osc.type = 'sine';
            
            gain.gain.setValueAtTime(volume, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
            
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            
            osc.start();
            osc.stop(audioCtx.currentTime + 0.5);
            
            addNoteToHistory(note, 'event');
        }
        
        // Play chord (for compound events)
        function playChord(notes, volume = 0.08) {
            notes.forEach((note, i) => {
                setTimeout(() => playNote(note, volume), i * 50);
            });
        }
        
        function noteToFreq(note) {
            const notes = { 'C': 0, 'D': 2, 'E': 4, 'F': 5, 'G': 7, 'A': 9, 'B': 11 };
            const octave = parseInt(note[1]) || 4;
            const semitone = notes[note[0]];
            return 440 * Math.pow(2, (semitone + (octave - 4) * 12 - 9) / 12);
        }

        // ═══════════════════════════════════════════════════════════════
        // VISUAL - Glowing particles with neural connections
        // ═══════════════════════════════════════════════════════════════
        
        class Neuron {
            constructor() {
                this.x = width / 2 + (Math.random() - 0.5) * 600;
                this.y = height / 2 + (Math.random() - 0.5) * 600;
                this.vx = (Math.random() - 0.5) * 1.5;
                this.vy = (Math.random() - 0.5) * 1.5;
                this.type = 'idle';
                this.energy = 0.5;
                this.baseSize = 3 + Math.random() * 3;
                this.pulsePhase = Math.random() * Math.PI * 2;
                this.age = 0;
                this.connections = [];
                this.pulseColor = null; // FOR CODE TYPE COLORS
                
                this.colors = {
                    'idle': '#4a90e2',
                    'thinking': '#2196F3',
                    'reading': '#FFC107',
                    'writing': '#FF9800',
                    'executing': '#F44336',
                    'complete': '#4CAF50'
                };
            }
            
            update(neurons) {
                // Flocking behavior
                let sep = { x: 0, y: 0 };
                let ali = { x: 0, y: 0 };
                let coh = { x: 0, y: 0 };
                let count = 0;
                
                this.connections = [];
                
                for (let other of neurons) {
                    if (other === this) continue;
                    
                    const dx = other.x - this.x;
                    const dy = other.y - this.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    
                    if (dist < 100) {
                        this.connections.push({ neuron: other, distance: dist });
                        
                        if (dist < 40) {
                            sep.x -= dx / dist;
                            sep.y -= dy / dist;
                        }
                        
