                    { freq: 523, duration: 0.08 },  // C5 - maybe yes?
                    { freq: 440, duration: 0.12 }   // A4 - or no?
                ],
                'class': [
                    { freq: 262, duration: 0.15 },  // C4
                    { freq: 330, duration: 0.15 },  // E4
                    { freq: 392, duration: 0.15 },  // G4
                    { freq: 523, duration: 0.2 }    // C5 - object definition
                ],
                'data': [
                    { freq: 392, duration: 0.12 },  // G4
                    { freq: 440, duration: 0.12 }   // A4 - simple assignment
                ],
                'default': [
                    { freq: 523, duration: 0.1 },   // C5
                    { freq: 587, duration: 0.1 }    // D5 - execution
                ]
            };
            
            const melody = melodies[type] || melodies['default'];
            
            // Add progression through the file (shift all notes up)
            const progression = (lineNum / totalLines) * 12; // 0-12 semitones
            const shift = Math.pow(2, progression / 12);
            
            // Play the melody as a sequence
            let delay = 0;
            melody.forEach((note, i) => {
                setTimeout(() => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    // Different waveform for each type
                    const waveforms = {
                        'import': 'sine',
                        'function': 'triangle',
                        'loop': 'sawtooth',  // BUZZY
                        'conditional': 'triangle',
                        'class': 'sine',
                        'data': 'sine',
                        'default': 'square'
                    };
                    
                    osc.type = waveforms[type] || 'sine';
                    osc.frequency.value = note.freq * shift;  // Apply progression
                    
                    gain.gain.value = 0.12;
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + note.duration);
                    
                    osc.connect(gain);
                    gain.connect(reverbNode || audioCtx.destination);
                    
                    osc.start();
                    osc.stop(audioCtx.currentTime + note.duration);
                }, delay);
                
                delay += note.duration * 1000;  // Convert to ms
            });
        }
        
        function triggerColoredPulse(x, y, size, color) {
            // Find nearby neurons and activate them with the specific color
            neurons.forEach(n => {
                const dx = n.x - x;
                const dy = n.y - y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                
                if (dist < size * 3) {
                    const strength = 1 - (dist / (size * 3));
                    n.activity = Math.max(n.activity, strength);
                    n.pulseColor = color; // Set specific color for this pulse
                }
            });
        }
        
        function updateStatus(phase, details) {
            document.getElementById('phase').textContent = `🔥 ${phase}`;
            document.getElementById('details').textContent = details;
        }
        
        function triggerNeuronPulse(x, y, radius, type) {
            // Find neurons in this region and activate them
            const typeColors = {
                'thinking': '#4a90e2',
                'reading': '#e2c44a',
                'writing': '#e24a90',
                'executing': '#4ae290',
                'memory': '#904ae2'
            };
            
            let activated = 0;
            neurons.forEach(n => {
                const dist = Math.hypot(n.x - x, n.y - y);
                if (dist < radius) {
                    n.type = type;
                    n.energy = Math.max(n.energy, 1.0 - (dist / radius));
                    activated++;
                }
            });
            
            console.log(`✨ Activated ${activated} neurons in ${type} region`);
        }
        
        function addTokenPulse(tokens) {
            // Show tokens being processed
            const note = `${tokens} tokens`;
            addNoteToStream(note);
        }
        
        function addNoteToStream(text) {
            const notesContent = document.getElementById('notes-content');
            const line = document.createElement('div');
            line.className = 'note-line';
            line.textContent = text;
            notesContent.insertBefore(line, notesContent.firstChild);
            
            // Keep only last 10
            while (notesContent.children.length > 10) {
                notesContent.removeChild(notesContent.lastChild);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CRYSTAL BOWL SOUND BATH (Starts after user interaction)
        // ═══════════════════════════════════════════════════════════════
        
        let audioCtx = null;
        let audioStarted = false;
        let reverbNode = null;
        
        function initAudio() {
            if (!audioStarted) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                
                // Create reverb node
                reverbNode = audioCtx.createConvolver();
                const reverbLength = audioCtx.sampleRate * 3;
                const reverbBuffer = audioCtx.createBuffer(2, reverbLength, audioCtx.sampleRate);
                for (let channel = 0; channel < 2; channel++) {
                    const channelData = reverbBuffer.getChannelData(channel);
                    for (let i = 0; i < reverbLength; i++) {
                        channelData[i] = (Math.random() * 2 - 1) * Math.exp(-i / (reverbLength * 0.3));
                    }
                }
                reverbNode.buffer = reverbBuffer;
                reverbNode.connect(audioCtx.destination);
                
                audioStarted = true;
                console.log('🎵 Audio initialized');
                
                // Start the continuous brainwave drone
                startBrainwaveDrone();
                
                // Play opening chord to confirm audio is working
                setTimeout(() => {
                    console.log('🎵 Playing opening chord...');
                    playCrystalBowl(0, 0.8, 4.0);  // C - Root
                    setTimeout(() => playCrystalBowl(4, 0.8, 4.0), 800);  // G - Throat
                    setTimeout(() => playCrystalBowl(2, 0.8, 5.0), 1600);  // E - Solar
