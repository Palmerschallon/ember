            } else if (activity_type === 'mesh') {
                console.log('💾 Memory access - bottom region');
                modulateDrone(0.9);  // Subtle drone shift
                // Memory access - memory region (bottom)
                triggerNeuronPulse(width * 0.4, height * 0.7, 100, 'memory');
                if (audioCtx) playNote('A4', 0.15);
            }
            
            // Token pulse
            if (tokens > 0) {
                addTokenPulse(tokens);
            }
        });
        
        // NEW: Listen for streaming tokens (individual words/tokens)
        socket.on('token', (data) => {
            const { token, type } = data;  // type: 'thinking', 'tool_result', 'response'
            
            // Play a note for this token
            const tokenNote = tokenToNote(token);
            
