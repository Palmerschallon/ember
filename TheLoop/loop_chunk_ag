                ])
                time.sleep(3)
                
                print("   ✅ Backend restart complete")
                self.last_deploy = now
                return True
            except Exception as e:
                print(f"   ❌ Deploy failed: {e}")
                return False
        
        print(f"   ⚠️  Unknown solution type: {solution['solution']}")
        return False

