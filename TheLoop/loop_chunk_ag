                'html': [0, 4, 6],
                'css': [2, 4, 6],
                'json': [1, 3, 6],
                'md': [0, 2, 5]
            };
            
            const chord = chordMap[ext] || [0, 2, 4];
            chord.forEach((bowlIndex, i) => {
                setTimeout(() => {
                    playCrystalBowl(bowlIndex, 0.8, 3.0);
                }, i * 150);
            });
            
            addNoteToHistory(`${filename} chord`, 'file');
        }
        
