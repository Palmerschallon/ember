        let noteHistory = [];
        
        function playCrystalBowl(bowlIndex, intensity = 1.0, duration = 3.0) {
            if (!audioCtx) {
                console.warn('⚠️ AudioContext not ready');
                return;
            }
            
            console.log(`🎵 Playing bowl ${bowlIndex} (${CRYSTAL_BOWLS[bowlIndex].note})`);
            
            const bowl = CRYSTAL_BOWLS[bowlIndex];
            const now = audioCtx.currentTime;
            
            const harmonics = [
                { mult: 1.0, gain: 1.0 },
                { mult: 2.0, gain: 0.6 },
                { mult: 3.0, gain: 0.4 },
                { mult: 4.0, gain: 0.25 },
                { mult: 5.0, gain: 0.15 }
