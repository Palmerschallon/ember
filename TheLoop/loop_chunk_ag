        full_path = THEPOD_PATH / file_path
        if not full_path.exists():
            return f"❌ File not found: {file_path}"
        
        with open(full_path, 'r') as f:
            content = f.read()
        
        return f"✅ Read {len(content)} chars from {file_path}\n\n{content}"
    except Exception as e:
