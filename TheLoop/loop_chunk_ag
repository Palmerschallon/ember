        // NEW: Code execution line-by-line
        socket.on('code_line', (data) => {
            const { line, number, total } = data;
            console.log(`⚡ Line ${number}/${total}: ${line.substring(0, 40)}...`);
            
            // Analyze the code line for different types
            const lineType = analyzeCodeLine(line);
            
            // Trigger pulse in execution region with color based on type
            const colors = {
                'import': '#9C27B0',     // Purple for imports
                'function': '#2196F3',    // Blue for functions
                'loop': '#FF9800',        // Orange for loops
                'conditional': '#FFC107', // Yellow for if/else
