        # Regenerate if doesn't exist or is old
        if not gallery_file.exists() or (time.time() - gallery_file.stat().st_mtime) > 300:
            import subprocess
            subprocess.run(["python3", str(THEPOD_PATH / "gather_creations.py")], 
