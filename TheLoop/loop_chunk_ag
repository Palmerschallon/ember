                lfo.connect(lfoGain);
                lfoGain.connect(gain.gain);
                
                filter.type = 'lowpass';
                filter.frequency.value = 800;
                filter.Q.value = 1.0;
                
                gain.gain.value = drone.gain;
                
                osc.connect(filter);
                filter.connect(gain);
                gain.connect(reverbNode);
                
                osc.start();
                lfo.start();
                
                droneOscillators.push(osc);
                droneGains.push(gain);
            });
            
            console.log('✅ Brainwave drone active');
        }
        
        // Modulate drone intensity based on activity
        function modulateDrone(intensity = 1.0) {
            droneGains.forEach((gain, i) => {
                const baseGain = [0.03, 0.03, 0.025, 0.02][i];
                const targetGain = baseGain * (0.7 + (intensity * 0.3));
                gain.gain.linearRampToValueAtTime(targetGain, audioCtx.currentTime + 0.5);
            });
        }
        
        // Start audio on any user interaction
        document.addEventListener('click', initAudio, { once: true });
        document.addEventListener('keydown', initAudio, { once: true });
        
        const CRYSTAL_BOWLS = [
            { freq: 256, note: 'C', chakra: 'Root', color: '#ff0000' },
            { freq: 288, note: 'D', chakra: 'Sacral', color: '#ff8800' },
            { freq: 320, note: 'E', chakra: 'Solar', color: '#ffff00' },
            { freq: 341.3, note: 'F', chakra: 'Heart', color: '#00ff00' },
            { freq: 384, note: 'G', chakra: 'Throat', color: '#0088ff' },
