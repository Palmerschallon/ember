            harmonics.forEach((harmonic) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                const filter = audioCtx.createBiquadFilter();
                const lfo = audioCtx.createOscillator();
                const lfoGain = audioCtx.createGain();
                
                osc.type = 'sine';
                osc.frequency.value = bowl.freq * harmonic.mult;
                
                lfo.type = 'sine';
                lfo.frequency.value = 4 + Math.random() * 2;
                lfoGain.gain.value = 0.5;
                
                lfo.connect(lfoGain);
                lfoGain.connect(osc.frequency);
                
                filter.type = 'lowpass';
                filter.frequency.value = 2000;
                filter.Q.value = 0.7;
                
                const maxGain = (0.08 * intensity * harmonic.gain) / harmonics.length;
                gain.gain.value = 0;
                gain.gain.linearRampToValueAtTime(maxGain, now + 0.8);
                gain.gain.linearRampToValueAtTime(maxGain * 0.9, now + duration - 0.5);
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
                
                osc.connect(filter);
                filter.connect(gain);
                
                // Connect to destination - simple and direct
                if (reverbNode) {
                    gain.connect(reverbNode);
                } else {
                    gain.connect(audioCtx.destination);
                }
                
                osc.start(now);
                lfo.start(now);
                osc.stop(now + duration);
                lfo.stop(now + duration);
            });
            
            // Skip addNoteToHistory if it causes issues
            try {
                addNoteToHistory(bowl.note, bowl.chakra);
            } catch (e) {
                console.warn('Note history error:', e);
            }
        }
        
        function tokenToNote(token) {
            let hash = 0;
            for (let i = 0; i < token.length; i++) {
                hash = ((hash << 5) - hash) + token.charCodeAt(i);
                hash |= 0;
            }
            const bowlIndex = Math.abs(hash) % CRYSTAL_BOWLS.length;
            const intensity = Math.min(1.0, token.length / 20);
            const keywords = ['function', 'class', 'const', 'let', 'import', 'export', 'if', 'for', 'while'];
            const isKeyword = keywords.some(kw => token.toLowerCase().includes(kw));
            const duration = isKeyword ? 2.5 : 1.5;
            
            playCrystalBowl(bowlIndex, intensity, duration);
            return { bowl: CRYSTAL_BOWLS[bowlIndex].note, token };
        }
        
