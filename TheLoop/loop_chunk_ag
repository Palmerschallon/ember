        }
        
        // ═══════════════════════════════════════════════════════════════
        // CRYSTAL BOWL SOUND BATH (Starts after user interaction)
        // ═══════════════════════════════════════════════════════════════
        
        let audioCtx = null;
        let audioStarted = false;
