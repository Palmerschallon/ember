    # For now, just return all solutions (UI can display them)
    print(f"[SWARM] Complete in {elapsed:.1f}s", flush=True)
    
    return jsonify({
        "solutions": solutions,
        "swarm_size": swarm_size,
        "model": model,
        "elapsed": elapsed
    })

