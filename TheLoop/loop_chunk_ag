    <script>
        const API_URL = 'http://localhost:8080';
        let currentConversationId = null;
        let selectedImage = null;
        let socket = null;
        let estimatedTokens = 0;

        //  Auto-open Mind window on first message
        let mindWindowOpened = false;
        
        function openMindWindow() {
            if (!mindWindowOpened) {
                window.open('/cortex/ember_mind.html', 'ember_mind', 'width=1400,height=900');
                mindWindowOpened = true;
            }
        }

        // Connect WebSocket for real-time status
        function connectWebSocket() {
            socket = io(API_URL);
            
            socket.on('connect', () => {
                console.log('🔥 WebSocket connected');
            });
            
            socket.on('status_update', (data) => {
                updateStatus(data.phase, data.details);
            });
            
            socket.on('disconnect', () => {
                console.log('WebSocket disconnected');
            });
        }

        function updateStatus(phase, details) {
            const indicator = document.getElementById('status-indicator');
            const statusText = document.getElementById('status-text');
            
            indicator.className = '';
            indicator.classList.add(phase);
            
            const statusMap = {
                'thinking': '💭 Thinking...',
                'reading': '🔍 Reading...',
                'writing': '✍️ Writing...',
                'executing': '⚡ Executing...',
                'complete': '✅ Ready'
            };
            
            statusText.textContent = statusMap[phase] || 'Ready';
            
            if (details) {
                statusText.textContent += ` (${details})`;
            }
        }

        function estimateTokenCount(text) {
            // Rough estimate: ~4 chars per token
            return Math.ceil(text.length / 4);
        }

        function updateTokenCount() {
            const chatArea = document.getElementById('chat-area');
            const allText = chatArea.innerText;
            estimatedTokens = estimateTokenCount(allText);
            
            // Get model's max tokens
            const model = document.getElementById('model-select').value;
            const maxTokens = model.startsWith('gpt-4') ? 128000 : 200000;
            const remaining = maxTokens - estimatedTokens;
            
            // Show countdown with color coding
            const tokenDisplay = document.getElementById('token-count');
            const percentage = (estimatedTokens / maxTokens) * 100;
            
            if (percentage > 90) {
                tokenDisplay.style.color = '#F44336'; // Red - danger
            } else if (percentage > 70) {
                tokenDisplay.style.color = '#FF9800'; // Orange - warning
            } else {
                tokenDisplay.style.color = '#4CAF50'; // Green - safe
            }
            
            tokenDisplay.textContent = `${remaining.toLocaleString()} left (${estimatedTokens.toLocaleString()} used)`;
        }

        async function loadConversations() {
            try {
                console.log('Loading conversations...');
                const res = await fetch(`${API_URL}/conversations`);
                const data = await res.json();
                console.log('Received conversations:', data);
                const list = document.getElementById('conversations-list');
                list.innerHTML = '';
                
                // Extract conversations array from response
                const conversations = data.conversations || data;
                
                // Check if conversations exist
                if (!conversations || !Array.isArray(conversations) || conversations.length === 0) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.style.padding = '20px';
                    emptyMsg.style.color = '#666';
                    emptyMsg.style.textAlign = 'center';
                    emptyMsg.style.fontSize = '12px';
                    emptyMsg.textContent = 'No conversations yet.\nClick "New Chat" to start.';
                    list.appendChild(emptyMsg);
                    return;
                }
                
                conversations.forEach(conv => {
                    const div = document.createElement('div');
                    div.className = 'conversation-item';
                    if (conv.id === currentConversationId) {
                        div.classList.add('active');
                    }
                    
                    const title = document.createElement('span');
                    title.className = 'conversation-title';
                    title.textContent = conv.title;
                    
                    // Make the entire div clickable
                    div.onclick = (e) => {
                        // Don't trigger if clicking on action buttons
                        if (e.target.closest('.conversation-actions')) {
                            return;
                        }
                        console.log('Loading conversation:', conv.id, conv.title);
                        loadChat(conv.id);
                    };
                    
                    const actions = document.createElement('div');
                    actions.className = 'conversation-actions';
                    
                    const renameBtn = document.createElement('button');
                    renameBtn.className = 'rename-btn';
                    renameBtn.textContent = '✏️';
                    renameBtn.onclick = (e) => {
                        e.stopPropagation();
                        renameConversation(conv.id, conv.title);
                    };
                    
                    const deleteBtn = document.createElement('button');
                    deleteBtn.className = 'delete-btn';
                    deleteBtn.textContent = '🗑️';
                    deleteBtn.onclick = (e) => {
                        e.stopPropagation();
                        deleteConversation(conv.id, conv.title);
                    };
                    
                    actions.appendChild(renameBtn);
                    actions.appendChild(deleteBtn);
                    
                    div.appendChild(title);
                    div.appendChild(actions);
                    list.appendChild(div);
                });
            } catch (error) {
                console.error('Failed to load conversations:', error);
                const list = document.getElementById('conversations-list');
                list.innerHTML = '<div style="padding: 20px; color: #f44336; font-size: 12px;">Failed to load conversations</div>';
            }
        }

        async function renameConversation(id, currentTitle) {
            const newTitle = prompt('Rename conversation:', currentTitle);
            if (newTitle && newTitle !== currentTitle) {
                await fetch(`${API_URL}/conversations/${id}/rename`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: newTitle })
                });
                loadConversations();
            }
        }

        async function deleteConversation(id, title) {
            if (!confirm(`Delete "${title}"?\n\nThis cannot be undone.`)) {
                return;
            }
            
            try {
                await fetch(`${API_URL}/conversations/${id}`, {
                    method: 'DELETE'
                });
                
                // If we deleted the current conversation, clear the chat
                if (id === currentConversationId) {
                    currentConversationId = null;
                    document.getElementById('chat-area').innerHTML = '';
                    updateTokenCount();
                }
                
                loadConversations();
            } catch (error) {
                console.error('Failed to delete conversation:', error);
                alert('Failed to delete conversation');
            }
        }

        async function loadChat(conversationId) {
            currentConversationId = conversationId;
            const res = await fetch(`${API_URL}/conversations/${conversationId}`);
            const data = await res.json();
            
            const chatArea = document.getElementById('chat-area');
            chatArea.innerHTML = '';
            
            // Check if messages exist
            if (data.messages && data.messages.length > 0) {
                data.messages.forEach(msg => {
                    displayMessage(msg.role, msg.content);
                });
            }
            
            loadConversations();
            updateTokenCount();
        }

        async function newChat() {
            const res = await fetch(`${API_URL}/conversations`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            });
            const data = await res.json();
            currentConversationId = data.conversation_id;
            
            document.getElementById('chat-area').innerHTML = '';
            loadConversations();
            updateTokenCount();
        }

        function displayMessage(role, content) {
            const chatArea = document.getElementById('chat-area');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${role}`;
            
            // Check for file references
            const imageRegex = /\[([^\]]+\.(?:png|jpg|jpeg|gif|webp))\]/gi;
            const htmlRegex = /\[([^\]]+\.html)\]/gi;
            
            let processedContent = content;
            
            // Replace image references with actual images
            processedContent = processedContent.replace(imageRegex, (match, filename) => {
                return `<br><img src="${API_URL}/voice/${filename}" alt="${filename}">`;
            });
            
            // Replace HTML references with iframes
            processedContent = processedContent.replace(htmlRegex, (match, filename) => {
                return `<br><iframe src="${API_URL}/voice/${filename}"></iframe><br><a href="${API_URL}/voice/${filename}" target="_blank" style="color: #ff6b35;">Open ${filename} in new window →</a>`;
            });
            
            messageDiv.innerHTML = processedContent.replace(/\n/g, '<br>');
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
            
            updateTokenCount();
        }

        async function sendMessage() {
            const input = document.getElementById('input');
            const sendBtn = document.getElementById('send-btn');
            const message = input.value.trim();
            const model = document.getElementById('model-select').value;
            
            if (!message) return;
            
            // Create new conversation if needed
            if (!currentConversationId) {
                await newChat();
            }
            
            displayMessage('user', message);
            input.value = '';
            sendBtn.disabled = true;
            updateStatus('thinking', 'Processing request');
            
            // Auto-open mind window on first message
            openMindWindow();
            
            const requestBody = {
                message,
                model,
                conversation_id: currentConversationId
            };
            
            if (selectedImage) {
                requestBody.image = selectedImage;
            }
            
            const res = await fetch(`${API_URL}/agent`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestBody)
                });

            const data = await res.json();

                if (data.error) {
                displayMessage('assistant', `❌ Error: ${data.error}`);
                } else {
                displayMessage('assistant', data.response);
            }
            
            // Clear image if attached
            if (selectedImage) {
                selectedImage = null;
                document.getElementById('image-input').value = '';
                document.getElementById('image-preview').style.display = 'none';
            }
            
            sendBtn.disabled = false;
            updateStatus('complete', null);
            loadConversations(); // Refresh to show updated title if needed
        }

        // Event Listeners
        document.getElementById('new-chat-btn').addEventListener('click', newChat);
        document.getElementById('send-btn').addEventListener('click', sendMessage);
        document.getElementById('input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        const imageBtn = document.getElementById('image-btn');
        const imageInput = document.getElementById('image-input');
        const imageName = document.getElementById('image-name');
        const imagePreview = document.getElementById('image-preview');
        const removeImageBtn = document.getElementById('remove-image');

        imageBtn.addEventListener('click', () => imageInput.click());

        imageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const formData = new FormData();
                formData.append('image', file);
                
                fetch(`${API_URL}/upload_image`, {
                    method: 'POST',
                    body: formData
                }).then(res => res.json())
                  .then(data => {
                      if (data.path) {
                          selectedImage = data.path;
                          imageName.textContent = file.name;
                          imagePreview.style.display = 'block';
                      }
                  })
                  .catch(err => console.error('Upload failed:', err));
            }
        });

        removeImageBtn.addEventListener('click', () => {
            selectedImage = null;
            imageInput.value = '';
            imagePreview.style.display = 'none';
        });

        // NEW: File upload handler
        const fileBtn = document.getElementById('file-btn');
        const fileInput = document.getElementById('file-input');

        fileBtn.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file) {
                const formData = new FormData();
                formData.append('file', file);

                try {
                    const res = await fetch(`${API_URL}/upload`, {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    
                    if (data.status === 'uploaded') {
                        // Automatically tell Ember about the upload
                        const uploadMessage = `I've uploaded a file: ${file.name}\n\nPath: ${data.path}\n\nCan you read it and tell me what it contains?`;
                        document.getElementById('input').value = uploadMessage;
                        
                        // Show success message
                        displayMessage('system', `📎 File uploaded: ${data.filename}\n\nSaved to: ${data.path}\n\nEmber can now read it with read_file('${data.path}')`);
                        
                        // Clear the file input
                        fileInput.value = '';
                    }
                } catch (error) {
                    displayMessage('system', `❌ Upload failed: ${error.message}`);
                }
            }
        });

        // Synesthesia window
        document.getElementById('synesthesia-btn').addEventListener('click', () => {
            window.open('/cortex/synesthesia.html', 'synesthesia', 'width=1200,height=800');
        });

        // Brain Map window
        document.getElementById('brain-map-btn').addEventListener('click', () => {
            window.open('/cortex/brain_map.html', 'brainmap', 'width=1200,height=800');
        });

        // Initialize
        connectWebSocket();
        loadConversations();
    </script>
