    # Check for files created in last 10 seconds
    cutoff_time = time.time() - 10
    
    for pattern, category in [
        ("*.png", "images"), ("*.jpg", "images"), ("*.gif", "images"), 
        ("*.svg", "images"), ("*.jpeg", "images"),
        ("*.html", "html"), ("*.htm", "html"),
