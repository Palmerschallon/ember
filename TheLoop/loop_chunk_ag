                    setTimeout(() => playCrystalBowl(4, 0.8, 4.0), 800);  // G - Throat
                    setTimeout(() => playCrystalBowl(2, 0.8, 5.0), 1600);  // E - Solar
                }, 200);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CONTINUOUS BRAINWAVE DRONE (Always playing softly)
        // ═══════════════════════════════════════════════════════════════
        
