                { freq: 128, gain: 0.03, detune: 0 },      // Sub-bass foundation
                { freq: 128, gain: 0.03, detune: 2 },      // Slight detuning for richness
                { freq: 192, gain: 0.025, detune: -1 },    // Perfect fifth above
                { freq: 256, gain: 0.02, detune: 1 },      // Octave up
