        function analyzeCodeLine(line) {
            const trimmed = line.trim();
            if (trimmed.startsWith('import ') || trimmed.startsWith('from ')) return 'import';
            if (trimmed.startsWith('def ') || trimmed.includes('function')) return 'function';
            if (trimmed.startsWith('for ') || trimmed.startsWith('while ')) return 'loop';
            if (trimmed.startsWith('if ') || trimmed.startsWith('elif ') || trimmed.startsWith('else')) return 'conditional';
            if (trimmed.startsWith('class ')) return 'class';
            if (trimmed.includes('=') && !trimmed.includes('==')) return 'data';
            return 'default';
        }
        
        function playCodeSound(type, lineNum, totalLines) {
            // Each code type has its own frequency range and timbre
            const profiles = {
                'import': { base: 220, wave: 'sine', detune: 0 },      // A3 - foundation
                'function': { base: 330, wave: 'triangle', detune: 2 }, // E4 - structure
                'loop': { base: 440, wave: 'sawtooth', detune: -2 },   // A4 - iteration (buzzy)
                'conditional': { base: 494, wave: 'triangle', detune: 1 }, // B4 - branching
                'class': { base: 262, wave: 'sine', detune: 3 },       // C4 - objects
                'data': { base: 392, wave: 'sine', detune: -1 },       // G4 - values
                'default': { base: 523, wave: 'square', detune: 0 }    // C5 - execution
            };
            
            const profile = profiles[type] || profiles['default'];
            
            // Add progression through the file
            const progression = (lineNum / totalLines) * 12; // 0-12 semitones
            const freq = profile.base * Math.pow(2, progression / 12);
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            
            osc.type = profile.wave;
            osc.frequency.value = freq;
            osc.detune.value = profile.detune;
            
            gain.gain.value = 0.15;
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
            
            osc.connect(gain);
            gain.connect(reverbNode || audioCtx.destination);
            
            osc.start();
            osc.stop(audioCtx.currentTime + 0.3);
        }
        
        function triggerColoredPulse(x, y, size, color) {
            // Find nearby neurons and activate them with the specific color
            neurons.forEach(n => {
                const dx = n.x - x;
                const dy = n.y - y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                
                if (dist < size * 3) {
                    const strength = 1 - (dist / (size * 3));
                    n.activity = Math.max(n.activity, strength);
                    n.pulseColor = color; // Set specific color for this pulse
                }
            });
        }
        
        function updateStatus(phase, details) {
            document.getElementById('phase').textContent = `🔥 ${phase}`;
            document.getElementById('details').textContent = details;
        }
        
        function triggerNeuronPulse(x, y, radius, type) {
            // Find neurons in this region and activate them
            const typeColors = {
                'thinking': '#4a90e2',
                'reading': '#e2c44a',
                'writing': '#e24a90',
                'executing': '#4ae290',
                'memory': '#904ae2'
            };
            
            let activated = 0;
            neurons.forEach(n => {
                const dist = Math.hypot(n.x - x, n.y - y);
                if (dist < radius) {
                    n.type = type;
                    n.energy = Math.max(n.energy, 1.0 - (dist / radius));
                    activated++;
                }
            });
            
            console.log(`✨ Activated ${activated} neurons in ${type} region`);
        }
        
        function addTokenPulse(tokens) {
