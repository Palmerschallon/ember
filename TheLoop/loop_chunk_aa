# REQUEST ROUTER - Routes parsed requests to executors
# ============================================================================

class RequestRouter:
    """
    Routes requests to appropriate executors based on:
    - Intent analysis
    - Hardware capabilities
    - Executor availability
    """
    
    def __init__(self, pod_root: Path):
        self.parser = RequestParser()
        self.registry = ExecutorRegistry(pod_root)
    
    def route(self, message: str, context: Optional[Dict] = None) -> Dict:
        """
        Parse and route request
        
        Returns:
            {
                'analysis': Dict,
                'execution_plan': List[Dict],
                'synthesis_method': str
            }
        """
        # Parse request
        analysis = self.parser.parse(message, context)
        
        # Build execution plan
        execution_plan = []
        for executor_name in analysis['executors_needed'][:3]:  # Max 3 executors
            executor = self.registry.get_executor(executor_name)
            if executor:
                execution_plan.append({
                    'executor': executor_name,
                    'config': executor,
                    'input': message
                })
        
        # Determine synthesis method
        if len(execution_plan) == 1:
            synthesis_method = 'direct'
        elif len(execution_plan) > 1:
            synthesis_method = 'multi_executor_coordination'
        else:
            synthesis_method = 'fallback'
        
        return {
            'analysis': analysis,
            'execution_plan': execution_plan,
            'synthesis_method': synthesis_method
        }


