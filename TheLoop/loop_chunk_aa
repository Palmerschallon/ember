    # Extract parameters
    params = extractor.extract_params(user_message, tool_name)
    
    try:
        result = TOOLS[tool_name](**params)
        result["tool"] = tool_name
        result["params"] = params
        return result
    except Exception as e:
        return {"success": False, "error": str(e), "tool": tool_name}

