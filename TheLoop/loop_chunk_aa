        """Create the physical directory structure"""
        print(f"\n📁 Creating structure in {self.output_dir}...")
        
        self.output_dir.mkdir(exist_ok=True, parents=True)
        
        for category, subcategories in organization.items():
            category_path = self.output_dir / category
            category_path.mkdir(exist_ok=True)
            
            if isinstance(subcategories, dict):
                for subcategory, files in subcategories.items():
                    subcat_path = category_path / subcategory
                    subcat_path.mkdir(exist_ok=True)
                    print(f"   {category}/{subcategory}/ ({len(files)} files)")
            else:
                print(f"   {category}/ ({len(subcategories)} files)")
        
        print("   ✓ Structure created")
    
