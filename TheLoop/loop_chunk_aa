    Supports multiple formats for robustness.
    """
    calls = []
    
    # Format 1: <tool>name(args)</tool>
    pattern1 = r'<tool>(\w+)\((.*?)\)</tool>'
    matches = re.findall(pattern1, response, re.DOTALL)
    for tool_name, args_str in matches:
        kwargs = {}
        arg_pattern = r'(\w+)=["\']([^"\']*)["\']'
        for key, value in re.findall(arg_pattern, args_str):
            kwargs[key] = value
        calls.append((tool_name, kwargs))
    
    # Format 2: Natural language that clearly indicates tool use
    # "I'll read the file..." → auto-detect and offer
    if "i'll read" in response.lower() or "let me read" in response.lower():
        file_match = re.search(r'read\s+(\S+)', response, re.IGNORECASE)
        if file_match:
            calls.append(("read", {"path": file_match.group(1).strip('"`\'')}))
    
    if "i'll write" in response.lower() or "let me write" in response.lower():
        # Suggest write but don't auto-execute (needs content)
        pass
    
    return calls

