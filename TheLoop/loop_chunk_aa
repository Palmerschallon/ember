        for book in sorted(bookshelf.glob("*.md"))[:5]:  # First 5 books
            try:
                with open(book, 'r', encoding='utf-8', errors='ignore') as f:
                    preview = f.read(1200)  # ~300 tokens per book
                    context_parts.append(f"\n[{book.stem}]\n{preview}...\n")
                    books_loaded.append(book.stem)
            except Exception as e:
                print(f"Error loading {book.name}: {e}")
        
        print(f"[AWAKENING] Loaded books: {books_loaded}")
    
    # LOAD SEMANTIC MESH - concepts, not just count
    mesh_index = THEPOD_PATH / "_mesh" / "index" / "semantic_index.json"
    if mesh_index.exists():
        try:
            with open(mesh_index) as f:
                index = json.load(f)
                concepts = list(index.keys())[:10]
                fragment_count = sum(len(v) for v in index.values())
                context_parts.append(f"\n=== Semantic Mesh ({fragment_count} memory fragments internalized) ===")
                context_parts.append(f"Concepts you know: {', '.join(concepts)}")
                print(f"[AWAKENING] Mesh: {fragment_count} fragments, concepts: {concepts[:5]}")
        except Exception as e:
            print(f"Error loading mesh: {e}")
    
    # LOAD RECENT CONTEXT - what just happened
    try:
        recent = sorted(THEPOD_PATH.glob('*.md'), key=lambda p: p.stat().st_mtime, reverse=True)[:2]
        if recent:
            context_parts.append("\n=== Recent Activity (in your immediate memory) ===")
            for f in recent:
                with open(f, 'r', encoding='utf-8', errors='ignore') as file:
                    preview = file.read(600)  # ~150 tokens
                    context_parts.append(f"[{f.name}]\n{preview}...\n")
    except Exception as e:
        print(f"Error loading recent: {e}")
    
    awakening = "\n".join(context_parts)
    print(f"[AWAKENING] Total context length: {len(awakening)} chars")
    return awakening

