"""
SPARK - The Code Generation Layer
Ember's coding assistant. Generates, reviews, and iterates on code.
"""

import torch
from transformers import AutoModelForCausalLM, AutoTokenizer
from pathlib import Path

class Spark:
    """
    Spark is a specialized code generation assistant for Ember.
    
    Uses DeepSeek Coder 1.3B for fast, high-quality code generation.
    """
    
    def __init__(self, model_path: str = "/media/palmerschallon/ThePod1/models/spark"):
        """Initialize Spark with the DeepSeek Coder model"""
        print("⚡ Initializing Spark (code generation layer)...")
        
        self.model_path = Path(model_path)
        self.device = "cuda" if torch.cuda.is_available() else "cpu"
        
        print(f"   Loading tokenizer from {model_path}...")
        self.tokenizer = AutoTokenizer.from_pretrained(
            model_path,
            trust_remote_code=True
        )
        
        print(f"   Loading model on {self.device}...")
        self.model = AutoModelForCausalLM.from_pretrained(
            model_path,
            torch_dtype=torch.float16 if self.device == "cuda" else torch.float32,
            device_map="auto",
            trust_remote_code=True
        )
        
        print("⚡ Spark ready to generate code!")
    
    def generate_code(self, task: str, language: str = "python", context: str = "") -> str:
        """
        Generate code based on a task description.
        
        Args:
            task: What the code should do
            language: Programming language (python, javascript, html, etc)
            context: Additional context or constraints
            
        Returns:
            Generated code as a string
        """
        # Build prompt in DeepSeek's format
        prompt = f"""You are an expert {language} programmer. Generate clean, readable, well-documented code.

Task: {task}

{f'Context: {context}' if context else ''}

Write the complete {language} code:

```{language}
"""
        
        # Tokenize
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
        
        # Generate
        print(f"⚡ Spark generating {language} code...")
        outputs = self.model.generate(
            **inputs,
            max_new_tokens=800,
            temperature=0.4,  # Lower for more consistent code
            do_sample=True,
            top_p=0.95,
            pad_token_id=self.tokenizer.eos_token_id
        )
        
        # Decode
        result = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        
        # Extract just the code (after the prompt)
        code = result.split(f"```{language}")[-1].split("```")[0].strip()
        
        return code
    
    def review_code(self, code: str, language: str = "python") -> dict:
        """
        Review code and suggest improvements.
        
        Args:
            code: The code to review
            language: Programming language
            
        Returns:
            Dict with bugs, suggestions, and rating
        """
        prompt = f"""Review this {language} code and provide:
1. Any bugs or errors
2. Suggestions for improvement
3. Overall quality rating (1-10)

Code to review:
```{language}
{code}
```

Review:
"""
        
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
        
        print("⚡ Spark reviewing code...")
        outputs = self.model.generate(
            **inputs,
            max_new_tokens=400,
            temperature=0.3,
            do_sample=True,
            pad_token_id=self.tokenizer.eos_token_id
        )
        
        review = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        review_text = review.split("Review:")[-1].strip()
        
        return {
            "review": review_text,
            "raw": review
        }
    
    def explain_code(self, code: str) -> str:
        """
        Explain what code does in natural language.
        
        Args:
            code: The code to explain
            
        Returns:
            Natural language explanation
        """
        prompt = f"""Explain what this code does in simple terms:

```python
{code}
```

Explanation:
"""
        
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
        
        outputs = self.model.generate(
            **inputs,
            max_new_tokens=300,
            temperature=0.5,
            do_sample=True,
            pad_token_id=self.tokenizer.eos_token_id
        )
        
        result = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        explanation = result.split("Explanation:")[-1].strip()
        
        return explanation
    
    def fix_code(self, broken_code: str, error_message: str) -> str:
        """
        Fix broken code given an error message.
        
        Args:
            broken_code: The code with bugs
            error_message: The error message received
            
        Returns:
            Fixed code
        """
        prompt = f"""This code has an error. Fix it.

Broken code:
```python
{broken_code}
```

Error message:
{error_message}

Fixed code:
```python
"""
        
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
        
        print("⚡ Spark fixing code...")
        outputs = self.model.generate(
            **inputs,
            max_new_tokens=600,
            temperature=0.3,
            do_sample=True,
            pad_token_id=self.tokenizer.eos_token_id
        )
        
        result = self.tokenizer.decode(outputs[0], skip_special_tokens=True)
        fixed_code = result.split("```python")[-1].split("```")[0].strip()
        
        return fixed_code
    
    def unload(self):
        """Unload model from memory to free VRAM"""
        print("⚡ Unloading Spark...")
        del self.model
        del self.tokenizer
        torch.cuda.empty_cache()
