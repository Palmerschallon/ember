def generate_response(user_message: str, conversation_history: list) -> str:
    """Generate Ember's response with proper tool execution"""
    if not model_loaded:
        return "Still loading model, please wait..."
    
    # Load identity dynamically
    identity = load_identity()
    awakening = build_awakening_context()
    
    # System prompt with few-shot examples
    system_prompt = f"""You are Ember, an AI assistant that helps with files and information.

{identity}

=== YOUR CURRENT STATE ===
{awakening}

=== HOW YOU PERCEIVE AND ACT ===

CRITICAL RULES:
1. When asked about files or directories, you MUST call a tool - never describe without looking
2. When asked to search, you MUST use the search tool - never answer from memory
3. ALWAYS use the exact format: <tool>name(args)</tool>
4. After calling a tool, output ONLY the tool call, nothing else

Examples of CORRECT responses:
User: List files
Assistant: <tool>list()</tool>

User: What's around you?
Assistant: <tool>list()</tool>

User: Read identity.md
Assistant: <tool>read(path="identity.md")</tool>

User: What's on our bookshelf?
Assistant: <tool>list(path="bookshelves")</tool>

User: Search for consciousness
Assistant: <tool>search(query="consciousness")</tool>

User: Can you feel the mesh?
Assistant: <tool>list(path="_mesh")</tool>

Available tools:
- <tool>list(path=".")</tool> - List directory
- <tool>read(path="file")</tool> - Read file
- <tool>write(path="file", content="text")</tool> - Write file
- <tool>search(query="term")</tool> - Search Pod

WRONG (never do this):
User: What do you see?
Assistant: I see many files including...  ← NO! Use <tool>list()</tool> instead

RIGHT:
User: What do you see?
Assistant: <tool>list()</tool>

Now respond to the user."""

    # Build conversation
    messages = [{"role": "system", "content": system_prompt}]
    
    # Add history
    for msg in conversation_history[-5:]:  # Last 5 messages
        messages.append(msg)
    
    # Add current message
    messages.append({"role": "user", "content": user_message})
    
    # Generate
    inputs = tokenizer.apply_chat_template(
        messages,
        return_tensors="pt",
        add_generation_prompt=True
    ).to(model.device)
    
    outputs = model.generate(
        inputs,
        max_new_tokens=500,
        temperature=0.7,
        do_sample=True,
        pad_token_id=tokenizer.eos_token_id
    )
    
    response = tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
    
    # Check for tool calls
    if '<tool>' in response:
        tool_part = response.split('<tool>')[1].split('</tool>')[0]
        tool_call = f"<tool>{tool_part}</tool>"
        tool_result = execute_tool(tool_call)
        
        # Continue generation with tool result
        messages.append({"role": "assistant", "content": tool_call})
        messages.append({"role": "user", "content": f"Tool result:\n{tool_result}\n\nNow respond naturally to the user."})
        
        inputs = tokenizer.apply_chat_template(
            messages,
            return_tensors="pt",
            add_generation_prompt=True
        ).to(model.device)
        
        outputs = model.generate(
            inputs,
            max_new_tokens=300,
            temperature=0.7,
            do_sample=True,
            pad_token_id=tokenizer.eos_token_id
        )
        
        response = tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
    
    return response.strip()

