            content = f.read()
        return {"content": content, "path": path, "size": len(content)}
    except Exception as e:
        return {"error": str(e)}

def write_file(path: str, content: str) -> Dict:
    """Write a file"""
    try:
        filepath = DATA_PATH / path
        filepath.parent.mkdir(parents=True, exist_ok=True)
        with open(filepath, 'w', encoding='utf-8') as f:
            f.write(content)
        return {"status": "written", "path": path, "size": len(content)}
    except Exception as e:
        return {"error": str(e)}

def list_files(directory: str = ".") -> Dict:
    """List files"""
    try:
        target = DATA_PATH / directory if directory != "." else DATA_PATH
        if not target.exists():
            return {"error": f"Directory {directory} doesn't exist"}
        
        items = []
        for item in sorted(target.iterdir()):
            if item.name.startswith('.'):
                continue
            items.append({
                "name": item.name,
                "type": "dir" if item.is_dir() else "file"
            })
        
        return {"path": directory, "items": items, "total": len(items)}
    except Exception as e:
        return {"error": str(e)}

TOOLS = {
    "read": read_file,
    "write": write_file,
    "list": list_files
}

# ============================================================================
# TOOL EXTRACTION & EXECUTION
# ============================================================================

def extract_tools(text: str) -> list:
    """Extract tool calls"""
    calls = []
    pattern = r'<tool>(\w+)\((.*?)\)</tool>'
    matches = re.findall(pattern, text, re.DOTALL)
    
    for tool_name, args_str in matches:
        kwargs = {}
        
        # Parse keyword arguments
        arg_pattern = r'(\w+)=["\']([^"\']*)["\']'
        for key, value in re.findall(arg_pattern, args_str):
            kwargs[key] = value
        
        # Handle simple cases
        if not kwargs and args_str.strip():
            clean_arg = args_str.strip().strip('"\'')
            if tool_name == "read":
                kwargs = {"path": clean_arg}
            elif tool_name == "list":
                kwargs = {"directory": clean_arg if clean_arg else "."}
        
        calls.append((tool_name, kwargs))
    
    return calls

def execute_tools(tool_calls: list) -> str:
    """Execute tools and format results"""
    if not tool_calls:
        return None
    
    results = []
    for tool_name, kwargs in tool_calls:
        if tool_name not in TOOLS:
            results.append(f"[{tool_name}]: Unknown tool")
            continue
        
        try:
            result = TOOLS[tool_name](**kwargs)
            
            # Format nicely
            if isinstance(result, dict):
                if "error" in result:
                    formatted = f"Error: {result['error']}"
                elif "content" in result:
                    content = result['content']
                    if len(content) > 1000:
                        content = content[:1000] + f"\n... ({len(content) - 1000} more chars)"
                    formatted = content
                elif "items" in result:
                    items = result['items']
                    lines = [f"{item['name']}{'/' if item['type'] == 'dir' else ''}" for item in items]
                    formatted = "\n".join(lines) if lines else "(empty)"
                elif "status" in result:
                    formatted = f"✓ {result['status']}: {result.get('path', '')}"
                else:
                    formatted = str(result)
            else:
                formatted = str(result)
            
            results.append(f"[{tool_name}]:\n{formatted}")
        
        except Exception as e:
            results.append(f"[{tool_name}]: Error - {e}")
    
    return "\n\n".join(results)

