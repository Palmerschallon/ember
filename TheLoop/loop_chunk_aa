# RESPONSE SYNTHESIZER - Combines executor outputs
# ============================================================================

class ResponseSynthesizer:
    """
    Combines multiple executor responses into unified output
    """
    
    def synthesize(
        self,
        executor_responses: Dict[str, str],
        synthesis_method: str,
        analysis: Dict
    ) -> str:
        """
        Synthesize unified response from multiple executors
        """
        if not executor_responses:
            return "[No executor responses available]"
        
        # Single executor: return directly
        if len(executor_responses) == 1:
            return list(executor_responses.values())[0]
        
        # Multiple executors: intelligent combination
        parts = []
        
        # Priority order for coherent output
        priority = [
            'tool_executor',
            'reasoning_engine',
            'code_generator',
            'creative_synthesizer',
            'conversation_model'
        ]
        
        for executor in priority:
            if executor in executor_responses:
                response = executor_responses[executor].strip()
                if response:
                    parts.append(response)
        
        # Add any remaining executors
        for executor, response in executor_responses.items():
            if executor not in priority:
                response = response.strip()
                if response:
                    parts.append(response)
        
        # Combine intelligently
        if len(parts) == 2:
            unified = f"{parts[0]}\n\n{parts[1]}"
        elif len(parts) > 2:
            unified = parts[0]
            for part in parts[1:]:
                if len(part) < 200:
                    unified += f" {part}"
                else:
                    unified += f"\n\n{part}"
        else:
            unified = parts[0] if parts else "[Empty synthesis]"
        
        return unified


