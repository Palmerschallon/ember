from pathlib import Path
import re

MODEL_PATH = Path("models/llama-3.2-3b-instruct")
DATA_PATH = Path("ember_data")

# ============================================================================
# STOPPING CRITERIA - Stop generation at tool boundaries
# ============================================================================

class ToolDetectionStopper(StoppingCriteria):
    """
    Stop generation when we detect a complete tool call.
    This prevents hallucination of tool results.
    """
    
    def __init__(self, tokenizer, stop_patterns):
        self.tokenizer = tokenizer
        self.stop_patterns = stop_patterns
        self.generated_text = ""
    
    def __call__(self, input_ids, scores, **kwargs):
        # Decode only the newly generated tokens
        new_tokens = input_ids[0][-50:]  # Look at last 50 tokens
        text = self.tokenizer.decode(new_tokens, skip_special_tokens=True)
        
        # Check if we've completed a tool call
        if '</tool>' in text:
            # Found end of tool call - STOP
            return True
        
        # Check for natural language tool indicators
        # "I'll read the file" - stop before they make up content
        if re.search(r"I['']ll (read|check|look at)", text, re.IGNORECASE):
            # Give it a few more tokens to finish the thought
            if len(text) > 50:  # Reasonable length
                return True
        
        return False

# ============================================================================
# TOOLS
# ============================================================================

def read_file(path: str) -> str:
    try:
        with open(DATA_PATH / path, 'r') as f:
