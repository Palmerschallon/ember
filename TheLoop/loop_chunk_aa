    # Fallback to simple keyword detection
    if any(w in user_lower for w in ["list", "show", "what's"]):
        return ["list"]
    if any(w in user_lower for w in ["find", "search", "where"]):
        return ["search"]
    if any(w in user_lower for w in ["read", "display", "show me"]):
        return ["read"]
    if any(w in user_lower for w in ["write", "create", "save"]):
        return ["write"]
    
