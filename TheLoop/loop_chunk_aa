        if dry_run:
            print(f"\n   This is a DRY RUN. No files were actually moved.")
            print(f"   Run with --execute to actually move files.")
        else:
            print(f"\n   ✓ Moved {moved} files")
    
    def _find_file(self, filename: str) -> Path:
