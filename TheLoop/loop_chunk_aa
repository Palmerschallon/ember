def build_awakening_context() -> str:
    """Build rich startup context - ACTUAL CONTENTS, not just metadata"""
    context_parts = []
    
    # LOAD THE BOOKSHELF - don't just say it exists, read it
    bookshelf = THEPOD_PATH / "essential" / "bookshelves"
    if bookshelf.exists():
        books_loaded = []
