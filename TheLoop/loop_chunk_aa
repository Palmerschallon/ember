def detect_intent_and_execute(text: str) -> tuple:
    """
    Detect if Ember is trying to use a tool through natural language.
    Returns (tool_executed, tool_result) or (False, None)
    """
    text_lower = text.lower()
    
    # Detect write intent
    if any(word in text_lower for word in ['create file', 'write file', 'save file', 'abracadabra']):
        # Extract filename and content
        
        # Look for filename patterns
        filename_match = re.search(r'(?:called|named)\s+["\']?([^\s"\']+\.md)["\']?', text)
        if not filename_match:
            filename_match = re.search(r'([A-Za-z0-9_/]+\.md)', text)
        
        if filename_match:
            filename = filename_match.group(1)
            
            # Extract content (look for markdown or quoted text)
            content_match = re.search(r'(?:content|with|containing)[:\s]+["\'](.+?)["\']', text, re.DOTALL)
            if not content_match:
                # Try to find code block
                content_match = re.search(r'```(?:markdown)?\n(.+?)\n```', text, re.DOTALL)
            
            if content_match:
                content = content_match.group(1)
                result = write_file(filename, content)
                return (True, f"✨ Spell cast! {result}")
    
    # Detect search intent
    if any(word in text_lower for word in ['search for', 'find', 'look for', 'what about']):
        # Extract search query
        query_match = re.search(r'(?:search for|find|look for|what about)\s+["\']?([^"\'\.]+)["\']?', text, re.IGNORECASE)
        if query_match:
            query = query_match.group(1).strip()
            result = search_pod(query)
            return (True, result)
    
    # Detect list intent
    if any(word in text_lower for word in ['show me', 'list', 'what\'s in']):
        path_match = re.search(r'(?:show me|list|what\'s in)\s+(?:the\s+)?([^\s\.]+)', text, re.IGNORECASE)
        if path_match:
            path = path_match.group(1).strip()
            result = list_directory(path)
            return (True, result)
    
    # Detect Spark intent (code generation)
    if any(word in text_lower for word in ['spark', 'write code', 'generate code', 'build me', 'create a']):
        # Check if it's a coding task
        code_indicators = ['function', 'class', 'app', 'website', 'game', 'visualization', 'script']
        if any(indicator in text_lower for indicator in code_indicators):
            # Extract what they want to build
            task_match = re.search(r'(?:build|create|make|generate)(?:\s+me\s+)?(?:a\s+)?(.+)', text, re.IGNORECASE)
            if task_match:
                task = task_match.group(1).strip()
                spark = get_spark()
                code = spark.generate_code(task=task, language="python")
                return (True, f"⚡ Spark generated code:\n\n```python\n{code}\n```\n\nWould you like me to save this or modify it?")
    
    # Detect Echo intent (creative help)
    if any(word in text_lower for word in ['echo', 'creative', 'what if', 'think laterally', 'stuck']):
        # Check if asking for creative help
        if 'stuck' in text_lower or 'help' in text_lower or 'what if' in text_lower:
            echo = get_echo()
            problem_match = re.search(r'(?:stuck on|help with|problem:|issue:)\s*(.+)', text, re.IGNORECASE)
            problem = problem_match.group(1).strip() if problem_match else text
            ideas = echo.synthesize(problem=problem)
            ideas_text = "\n".join(f"{i}. {idea}" for i, idea in enumerate(ideas, 1))
            return (True, f"🌊 Echo suggests:\n\n{ideas_text}")
    
    return (False, None)

def execute_tool(tool_call: str) -> str:
    """Parse and execute a tool call like <tool>list()</tool>"""
    try:
        # Extract tool name and args
        tool_call = tool_call.strip().replace('<tool>', '').replace('</tool>', '')
        
        if '(' not in tool_call:
            return f"Invalid tool format: {tool_call}"
        
        tool_name = tool_call.split('(')[0].strip()
        
        if tool_name not in TOOLS:
            return f"Unknown tool: {tool_name}"
        
        # Parse arguments (simple version)
        args_str = tool_call.split('(', 1)[1].rsplit(')', 1)[0]
        kwargs = {}
        
        if args_str.strip():
            # Parse key=value pairs
            for arg in args_str.split(','):
                if '=' in arg:
                    key, value = arg.split('=', 1)
                    key = key.strip()
                    value = value.strip().strip('"').strip("'")
                    kwargs[key] = value
                else:
                    # Positional arg becomes first param
                    value = arg.strip().strip('"').strip("'")
                    if tool_name == 'list':
                        kwargs['path'] = value
                    elif tool_name == 'read':
                        kwargs['path'] = value
                    elif tool_name == 'search':
                        kwargs['query'] = value
        
        return TOOLS[tool_name](**kwargs)
    
    except Exception as e:
        return f"Tool execution error: {e}"

