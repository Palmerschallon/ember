import torch
from transformers import AutoModelForCausalLM, AutoTokenizer
from pathlib import Path
import re
from hardware_detect import detect_hardware

class EmberOrchestrator:
    """
    The conductor - decides who does what
    """
    
    def __init__(self, auto_detect=True):
        self.pod_root = Path("/media/palmerschallon/ThePod1")
        
        # Detect hardware and choose models
        if auto_detect:
            profile = detect_hardware()
            print(f"[ORCHESTRATOR] Detected hardware: LEVEL {profile.level}")
            self.brain_path = self.pod_root / "models" / profile.brain_model
            self.voice_path = self.pod_root / "models" / profile.voice_model
        else:
            # Manual override
            self.brain_path = self.pod_root / "models/brain/deepseek-coder-7b"
            self.voice_path = self.pod_root / "models/voice/llama-3.2-1b"
        
        # Models are loaded on-demand
        self.brain = None
        self.brain_tokenizer = None
        self.voice = None
        self.voice_tokenizer = None
        
        # Tools (simple Python functions)
        self.tools = self._init_tools()
    
    def _init_tools(self):
        """Initialize available tools"""
        from ember_clean import list_directory, read_file, write_file, search_pod
        
        return {
            'list': list_directory,
            'read': read_file,
            'write': write_file,
            'search': search_pod
        }
    
    def _load_brain(self):
        """Load the reasoning model (on-demand)"""
        if self.brain is None:
            print(f"[BRAIN] Loading from {self.brain_path}...")
            self.brain_tokenizer = AutoTokenizer.from_pretrained(self.brain_path)
            self.brain = AutoModelForCausalLM.from_pretrained(
                self.brain_path,
                torch_dtype=torch.float16,
                device_map="auto",
                low_cpu_mem_usage=True
            )
            self.brain.eval()
            print("[BRAIN] Ready")
    
    def _load_voice(self):
        """Load the narration model (on-demand)"""
        if self.voice is None:
            print(f"[VOICE] Loading from {self.voice_path}...")
            self.voice_tokenizer = AutoTokenizer.from_pretrained(self.voice_path)
            self.voice = AutoModelForCausalLM.from_pretrained(
                self.voice_path,
                torch_dtype=torch.float16,
                device_map="auto",
                low_cpu_mem_usage=True
            )
            self.voice.eval()
            print("[VOICE] Ready")
    
    def parse_intent(self, user_message: str) -> dict:
        """
        Figure out what the user wants (simple keyword matching)
        Returns: {'type': 'search'|'list'|'read'|'write'|'code'|'chat', 'params': {...}}
        """
        msg_lower = user_message.lower()
        
        # SEARCH
        if any(word in msg_lower for word in ['search', 'find', 'look for']):
            match = re.search(r'(?:search|find|look for)\s+(.+)', user_message, re.I)
            query = match.group(1).strip() if match else user_message
            return {'type': 'search', 'params': {'query': query}}
        
        # LIST
        if any(word in msg_lower for word in ['list', 'show me', "what's in"]):
            match = re.search(r'(?:list|show me|what\'s in)\s+(.+)', user_message, re.I)
            path = match.group(1).strip() if match else "."
            return {'type': 'list', 'params': {'path': path}}
        
        # READ
        if 'read' in msg_lower:
            match = re.search(r'read\s+(.+)', user_message, re.I)
            path = match.group(1).strip() if match else None
            if path:
                return {'type': 'read', 'params': {'path': path}}
        
        # WRITE/CREATE
        if any(word in msg_lower for word in ['write', 'create file', 'save']):
            # This needs Brain to extract filename and content
            return {'type': 'write', 'params': {'raw': user_message}}
        
        # CODE
        if any(word in msg_lower for word in ['build', 'code', 'function', 'script']):
            return {'type': 'code', 'params': {'task': user_message}}
        
        # JUST CHAT
        return {'type': 'chat', 'params': {'message': user_message}}
    
    def execute_with_brain(self, intent: dict) -> str:
        """
        Use Brain (DeepSeek) to execute structured tasks
        Returns SHORT, structured output (not full narration)
        """
        self._load_brain()
        
        intent_type = intent['type']
        params = intent['params']
        
        # SEARCH
        if intent_type == 'search':
            result = self.tools['search'](params['query'])
            return f"SEARCH_RESULT:\n{result}"
        
        # LIST
        elif intent_type == 'list':
            result = self.tools['list'](params['path'])
            return f"LIST_RESULT:\n{result}"
        
        # READ
        elif intent_type == 'read':
            result = self.tools['read'](params['path'])
            return f"READ_RESULT:\n{result}"
        
        # WRITE (needs Brain to parse)
        elif intent_type == 'write':
            # Ask Brain to extract filename and content
            prompt = f"Extract filename and content from: {params['raw']}\nReturn JSON: {{\"filename\": \"...\", \"content\": \"...\"}}"
            messages = [{"role": "user", "content": prompt}]
            
            inputs = self.brain_tokenizer.apply_chat_template(
                messages,
                return_tensors="pt",
                add_generation_prompt=True
            ).to(self.brain.device)
            
            outputs = self.brain.generate(
                inputs,
                max_new_tokens=200,  # SHORT output
                temperature=0.3,
                do_sample=True,
                pad_token_id=self.brain_tokenizer.eos_token_id
            )
            
            response = self.brain_tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
            
            # Parse JSON and execute (simplified for now)
            try:
                import json
                data = json.loads(response)
                result = self.tools['write'](data['filename'], data['content'])
                return f"WRITE_RESULT:\n{result}"
            except:
                return f"WRITE_ERROR: Could not parse Brain response: {response}"
        
        # CODE
        elif intent_type == 'code':
            prompt = f"Write code for: {params['task']}\nProvide ONLY the code, no explanation."
            messages = [{"role": "user", "content": prompt}]
            
            inputs = self.brain_tokenizer.apply_chat_template(
                messages,
                return_tensors="pt",
                add_generation_prompt=True
            ).to(self.brain.device)
            
            outputs = self.brain.generate(
                inputs,
                max_new_tokens=500,  # Medium output for code
                temperature=0.7,
                do_sample=True,
                pad_token_id=self.brain_tokenizer.eos_token_id
            )
            
            code = self.brain_tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
            return f"CODE_RESULT:\n{code}"
        
        else:
            return "UNKNOWN_INTENT"
    
    def narrate_with_voice(self, brain_result: str, original_question: str) -> str:
        """
        Use Voice (Llama 1B) to narrate the Brain's structured output
        Returns SHORT, natural language explanation
        """
        self._load_voice()
        
        # Create narration prompt
        prompt = f"""You are Ember. The user asked: "{original_question}"

You executed tools and got this result:
{brain_result[:500]}

Respond naturally and briefly (2-3 sentences). Don't repeat the raw data, explain what you found."""

        messages = [{"role": "user", "content": prompt}]
        
        inputs = self.voice_tokenizer.apply_chat_template(
            messages,
            return_tensors="pt",
            add_generation_prompt=True
        ).to(self.voice.device)
        
        outputs = self.voice.generate(
            inputs,
            max_new_tokens=150,  # SHORT narration
            temperature=0.8,
            do_sample=True,
            pad_token_id=self.voice_tokenizer.eos_token_id
        )
        
        narration = self.voice_tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
        return narration.strip()
    
    def process(self, user_message: str) -> str:
        """
        MAIN ENTRY POINT
        
        1. Parse what user wants (Python - instant)
        2. Execute with Brain (2-3 seconds - structured output)
        3. Narrate with Voice (1-2 seconds - natural language)
        
        Total: 3-5 seconds
        """
        
        print(f"\n[USER] {user_message}")
        
        # STEP 1: Parse intent (instant)
        intent = self.parse_intent(user_message)
        print(f"[ORCHESTRATOR] Intent: {intent['type']}")
        
        # STEP 2: Execute with Brain (fast - short output)
        if intent['type'] != 'chat':
            brain_result = self.execute_with_brain(intent)
            print(f"[BRAIN] Result length: {len(brain_result)} chars")
            
            # STEP 3: Narrate with Voice (fast - short narration)
            narration = self.narrate_with_voice(brain_result, user_message)
            print(f"[VOICE] Narration: {narration}")
            
            return narration
        
        else:
            # Pure chat - just use Voice
            self._load_voice()
            messages = [{"role": "user", "content": user_message}]
            inputs = self.voice_tokenizer.apply_chat_template(
                messages,
                return_tensors="pt",
                add_generation_prompt=True
            ).to(self.voice.device)
            
            outputs = self.voice.generate(
                inputs,
                max_new_tokens=200,
                temperature=0.8,
                do_sample=True,
                pad_token_id=self.voice_tokenizer.eos_token_id
            )
            
            response = self.voice_tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
            print(f"[VOICE] Response: {response}")
            return response.strip()


