class MemoryManager:
    """
    Only ONE heavy model (7B) loaded at a time
    Conversationalist (1B) can stay loaded
    Creative (0.5B) runs on CPU
    """
    
    max_vram = 12GB
    current_usage = 0
    loaded_models = {}
    
    def load(self, model_name):
        if model_name in loaded_models:
            return loaded_models[model_name]
        
        # Check if we need to unload
        if current_usage + model_size > max_vram - 2GB:  # 2GB safety buffer
            self.unload_heavy_models()
        
        # Load model
        model = load_model(model_name)
        loaded_models[model_name] = model
        return model
```

**Why**: We can't keep two 7B models in 12GB VRAM. Smart swapping is key.

