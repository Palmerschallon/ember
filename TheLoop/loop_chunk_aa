#!/usr/bin/env python3
"""
EMBER - HYBRID MODE
Deterministic tool execution + LLM narration

TOOL DECISION: Pure Python (no hallucination)
NARRATION: LLM (make it sound nice)
"""

from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse
from pathlib import Path
import re
import subprocess
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

# ============================================================================
# TOOLS (Pure Python - same as deterministic)
# ============================================================================

POD = Path("/media/palmerschallon/ThePod1")

def list_directory(path="."):
    """List files in directory"""
    try:
        full_path = POD / path if path != "." else POD
        if not full_path.exists():
            return f"Error: Path '{path}' not found"
        
        items = []
        for item in sorted(full_path.iterdir())[:50]:
            items.append(f"  {item.name}{'/' if item.is_dir() else ''}")
        
        return f"Contents of {path}:\n" + "\n".join(items)
    except Exception as e:
        return f"Error: {e}"

def read_file(path):
    """Read file contents"""
    try:
        full_path = POD / path
        if not full_path.exists():
            return f"Error: File '{path}' not found"
        
        content = full_path.read_text()[:3000]  # First 3000 chars
        return f"Contents of {path}:\n\n{content}"
    except Exception as e:
        return f"Error: {e}"

def search_pod(query):
    """Search for text in Pod"""
    try:
        result = subprocess.run(
            ["grep", "-r", "-i", "-n", "--include=*.md", "--include=*.py", 
             "--include=*.txt", query, str(POD)],
            capture_output=True,
            text=True,
            timeout=5
        )
        
        lines = result.stdout.split('\n')[:10]
        if not lines or not lines[0]:
            return f"No results found for '{query}'"
        
        formatted = []
        for line in lines:
            if ':' in line:
                parts = line.split(':', 2)
                if len(parts) >= 3:
                    file = parts[0].replace(str(POD) + '/', '')
                    linenum = parts[1]
                    text = parts[2][:100]
                    formatted.append(f"{file}:{linenum} - {text}")
        
        return f"Search results for '{query}':\n\n" + "\n".join(formatted)
    except Exception as e:
        return f"Error: {e}"

# ============================================================================
# DETERMINISTIC INTENT PARSER (No AI)
# ============================================================================

def extract_path(text):
    """Extract file path from text"""
    if ' in ' in text:
        path = text.split(' in ')[-1].strip(' "\'\n')
        return path if path else None
    
    match = re.search(r'["\']([^"\']+)["\']', text)
    if match:
        return match.group(1)
    
    words = text.split()
    for i, word in enumerate(words):
        if word in ['read', 'show', 'cat', 'list', 'ls'] and i + 1 < len(words):
            return words[i + 1].strip(' "\'\n')
    
    return None

def extract_query(text):
    """Extract search query from text"""
    if 'search for' in text:
        return text.split('search for')[-1].strip(' "\'\n')
    if 'find' in text:
        return text.split('find')[-1].strip(' "\'\n')
    if 'grep' in text:
        return text.split('grep')[-1].strip(' "\'\n')
    
    match = re.search(r'["\']([^"\']+)["\']', text)
    if match:
        return match.group(1)
    
    return text.strip()

def parse_intent(text):
    """
    DETERMINISTIC PARSING
    Returns: (action, params, raw_result) or (None, None, None)
    """
    original = text
    text = text.lower().strip()
    
    if not text:
        return None, None, None
    
    # Identity questions - NO TOOL, just flag for LLM
    if any(phrase in text for phrase in ['who are you', 'what are you', 'who is ember', 'tell me about yourself']):
        return 'identity', {}, None
    
    # List files
    if any(word in text for word in ['list', 'ls', 'show files', 'directory']):
        if 'file' in text or 'dir' in text or 'ls' in text:
            path = extract_path(text) or '.'
            result = list_directory(path)
            return 'list', {'path': path}, result
    
    # Read file
    if any(word in text for word in ['read', 'show', 'cat', 'open']) and 'search' not in text:
        path = extract_path(text)
        if path:
            result = read_file(path)
            return 'read', {'path': path}, result
        else:
            return 'read_error', {}, "Which file? Example: 'read BOOTSTRAP.md'"
    
    # Search
    if any(word in text for word in ['search', 'find', 'grep', 'look for']):
        query = extract_query(text)
        if query and len(query) > 2:
            result = search_pod(query)
            return 'search', {'query': query}, result
        else:
            return 'search_error', {}, "What should I search for?"
    
    # No pattern matched - let LLM handle conversationally
    return 'conversation', {'text': original}, None

# ============================================================================
# LLM NARRATOR (Only for making responses sound nice)
# ============================================================================

class EmberNarrator:
    """LLM that ONLY narrates. Never decides tools."""
    
    def __init__(self):
        print("Loading narrator model (Llama 3.2-1B)...")
        model_path = "/media/palmerschallon/ThePod1/models/voice/llama-1b"
        
        if not Path(model_path).exists():
            # Fallback to 3B if 1B not downloaded
            model_path = "/media/palmerschallon/ThePod1/_archive_models/llama-3.2-3b-instruct"
        
        self.tokenizer = AutoTokenizer.from_pretrained(model_path)
        self.model = AutoModelForCausalLM.from_pretrained(
            model_path,
            torch_dtype=torch.float16,
            device_map="auto"
        )
        print("Narrator ready.")
    
    def narrate_result(self, action, params, raw_result, user_query):
        """
        LLM receives:
        - What tool was called (deterministic)
        - What the tool returned (actual data)
        - User's original question
        
        LLM only decides: How to present this nicely
        """
        
        if action == 'identity':
            # Read identity from file (deterministic)
            identity = read_file("BOOTSTRAP.md")
            prompt = f"""You are Ember. Someone asked: "{user_query}"

Read your identity file:
{identity[:1000]}

Respond briefly and naturally as yourself."""
        
        elif action in ['list', 'read', 'search']:
            prompt = f"""The user asked: "{user_query}"

Tool executed: {action}({params})

Results:
{raw_result[:1500]}

Narrate this result naturally and helpfully. Be concise."""
        
        elif action == 'conversation':
            prompt = f"""You are Ember, an AI assistant with tools for file operations and search.

User: {user_query}

Respond conversationally. If they need a tool, suggest using: list files, read file, or search."""
        
        else:
            # Errors
            prompt = f"""User: {user_query}

Issue: {raw_result}

Help them fix this."""
        
        # Generate narration
        messages = [{"role": "user", "content": prompt}]
        inputs = self.tokenizer.apply_chat_template(
            messages,
            add_generation_prompt=True,
            return_tensors="pt"
        ).to(self.model.device)
        
        outputs = self.model.generate(
            inputs,
            max_new_tokens=300,
            temperature=0.7,
            do_sample=True,
            pad_token_id=self.tokenizer.eos_token_id
        )
        
        response = self.tokenizer.decode(
            outputs[0][inputs.shape[1]:],
            skip_special_tokens=True
        ).strip()
        
        return response

# ============================================================================
# MAIN HANDLER
# ============================================================================

narrator = None

def handle_message(text):
    """
    1. Deterministic intent parsing (no AI)
    2. Deterministic tool execution (no AI)
    3. LLM narration (make it pretty)
    """
    global narrator
    
    # STEP 1: Parse intent (deterministic)
    action, params, raw_result = parse_intent(text)
    
    if action is None:
        return "I didn't understand that. Try: 'list files', 'read [filename]', 'search for [query]'"
    
    # STEP 2: Tool already executed (raw_result has the data)
    # No AI involved yet!
    
    # STEP 3: Let LLM narrate (optional - could return raw_result directly)
    if narrator:
        try:
            narrated = narrator.narrate_result(action, params, raw_result, text)
            return narrated
        except Exception as e:
            print(f"Narrator error: {e}")
            # Fallback to raw result
            return raw_result or f"Action: {action}, Params: {params}"
    else:
        return raw_result or f"Action: {action}, Params: {params}"

