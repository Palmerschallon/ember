class EmberOrchestrator:
    """
    Complete orchestration system
    
    Flow:
        1. Parse request (classify intent)
        2. Route to executors (based on hardware/availability)
        3. Execute (parallel where possible)
        4. Synthesize response (unified output)
    """
    
    def __init__(self, pod_root: Path = Path("/media/palmerschallon/ThePod1")):
        self.router = RequestRouter(pod_root)
        self.synthesizer = ResponseSynthesizer()
        self.executor_factory = ExecutorFactory(pod_root)
        print(f"[ORCHESTRATOR] Initialized with hardware level {self.router.registry.hardware.level}")
    
    def process(self, message: str, context: Optional[Dict] = None) -> Dict:
        """
        Full orchestration cycle
        
        Returns:
            {
                'response': str,
                'analysis': Dict,
                'execution_plan': List,
                'executor_responses': Dict
            }
        """
        # Route
        routing = self.router.route(message, context)
        
        print(f"[ORCHESTRATOR] Routed to: {[e['executor'] for e in routing['execution_plan']]}")
        
        # Execute (ACTUAL EXECUTION NOW!)
        executor_responses = {}
        for step in routing['execution_plan']:
            executor_name = step['executor']
            executor_config = step['config']
            executor_config['executor_name'] = executor_name  # Add name for factory
            
            # Get or create executor
            executor = self.executor_factory.get_executor(executor_config)
            
            if executor:
                try:
                    # Execute based on type
                    if hasattr(executor, 'execute'):
                        # Parse intent from message for tool executor
                        if executor_name == 'tool_executor':
                            result = executor.execute(message.lower(), {'message': message})
                        else:
                            result = executor.execute(message)
                        executor_responses[executor_name] = result
                    else:
                        executor_responses[executor_name] = f"[{executor_name} not implemented yet]"
                except Exception as e:
                    executor_responses[executor_name] = f"[{executor_name} error: {e}]"
            else:
                executor_responses[executor_name] = f"[{executor_name} unavailable]"
        
        # Synthesize
        response = self.synthesizer.synthesize(
            executor_responses,
            routing['synthesis_method'],
            routing['analysis']
        )
        
        return {
            'response': response,
            'analysis': routing['analysis'],
            'execution_plan': routing['execution_plan'],
            'executor_responses': executor_responses
        }


