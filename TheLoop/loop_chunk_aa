            '.md': ('documents', 'markdown'),
            '.pdf': ('documents', 'pdf'),
            '.doc': ('documents', 'word'),
            '.docx': ('documents', 'word'),
            '.jpg': ('media', 'images'),
            '.jpeg': ('media', 'images'),
            '.png': ('media', 'images'),
            '.gif': ('media', 'images'),
            '.mp4': ('media', 'video'),
            '.mp3': ('media', 'audio'),
            '.py': ('code', 'python'),
            '.js': ('code', 'javascript'),
            '.html': ('code', 'web'),
            '.css': ('code', 'web'),
            '.json': ('data', 'json'),
            '.csv': ('data', 'csv'),
            '.xml': ('data', 'xml'),
        }
        
        for f in files:
            ext = f['extension']
            if ext in type_map:
                category, subcategory = type_map[ext]
                if subcategory not in org[category]:
                    org[category][subcategory] = []
                org[category][subcategory].append(f['name'])
            else:
                if 'misc' not in org['other']:
                    org['other']['misc'] = []
                org['other']['misc'].append(f['name'])
        
        # Remove empty categories
        org = {k: v for k, v in org.items() if v}
        
        return org
    
