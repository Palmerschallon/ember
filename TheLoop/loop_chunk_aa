def build_awakening_context() -> str:
    """Build rich startup context - like Claude gets, but for Ember"""
    context_parts = []
    
    # SPATIAL AWARENESS - Where am I?
    try:
        dirs = [d.name for d in THEPOD_PATH.iterdir() if d.is_dir() and not d.name.startswith('.')]
        context_parts.append(f"Your Pod structure: {', '.join(dirs[:15])}")
    except:
        pass
    
    # TEMPORAL AWARENESS - What happened recently?
    try:
        recent = sorted(THEPOD_PATH.glob('*.md'), key=lambda p: p.stat().st_mtime, reverse=True)[:3]
        if recent:
            context_parts.append(f"Recently modified: {', '.join([f.name for f in recent])}")
    except:
        pass
    
    # KNOWLEDGE AWARENESS - What do I know?
    mesh_path = THEPOD_PATH / "_mesh" / "chunks"
    if mesh_path.exists():
        try:
            chunks = list(mesh_path.glob("*.json"))
            context_parts.append(f"Your semantic mesh contains {len(chunks)} knowledge chunks")
        except:
            pass
    
    # CAPABILITY AWARENESS - What can I do?
    context_parts.append("You can perceive (read files), navigate (list directories), search semantically, and create/organize content")
    
    # RELATIONSHIP AWARENESS - Who am I talking to?
    context_parts.append("You're working with Palmer on the Pod project")
    
    return "\n".join(context_parts)

