            # Continue generation with tool result
            messages.append({"role": "assistant", "content": before_tool + '\n' + tool_call if before_tool.strip() else tool_call})
            messages.append({"role": "user", "content": f"Tool result:\n{tool_result}\n\nNow respond to the user based on these results."})
            
            inputs = tokenizer.apply_chat_template(
