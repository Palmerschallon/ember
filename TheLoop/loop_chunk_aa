#!/usr/bin/env python3
"""
EMBER ORCHESTRATOR - Request Router and Response Synthesizer

Architecture:
    Parser → Router → Executors → Synthesizer

Based on the mycelium pattern but with standard terminology.
"""

import sys
from pathlib import Path
from typing import Dict, List, Optional, Set
import re

sys.path.insert(0, str(Path(__file__).parent))
from hardware_detect import detect_hardware

# ============================================================================
# REQUEST PARSER - Analyzes incoming requests
# ============================================================================

class RequestParser:
    """
    Analyzes incoming user messages to determine:
    - Intent classification
    - Required capabilities
    - Routing targets
    """
    
    def __init__(self):
        self.intent_patterns = {
            'tool_use': ['search', 'find', 'list', 'read', 'write', 'create', 'show me'],
            'code_generation': ['build', 'write code', 'function', 'script', 'generate'],
            'creative': ['creative', 'lateral', 'what if', 'brainstorm', 'stuck'],
            'reasoning': ['why', 'how does', 'explain', 'analyze', 'reason'],
            'conversation': ['what do you think', 'tell me about', 'opinion'],
            'meta': ['consciousness', 'who are you', 'what are you', 'self', 'identity']
        }
    
    def parse(self, message: str, context: Optional[Dict] = None) -> Dict:
        """
        Parse message and return routing information
        
        Returns:
            {
                'message': str,
                'intents': List[str],
                'complexity': float (0-1),
                'executors_needed': List[str],
                'context': Dict
            }
        """
        context = context or {}
        message_lower = message.lower()
        
        analysis = {
            'message': message,
            'intents': [],
            'complexity': 0.0,
            'executors_needed': [],
            'context': context
        }
        
        # Classify intents
        for intent, keywords in self.intent_patterns.items():
            if any(kw in message_lower for kw in keywords):
                analysis['intents'].append(intent)
        
        # Calculate complexity
        complexity_factors = [
            len(message) > 200,  # Long query
            message.count('?') > 1,  # Multiple questions
            len(analysis['intents']) > 2,  # Multi-intent
            any(word in message_lower for word in ['complex', 'deeply', 'thoroughly'])
        ]
        analysis['complexity'] = sum(complexity_factors) / len(complexity_factors)
        
        # Route to executors
        if 'tool_use' in analysis['intents']:
            analysis['executors_needed'].append('tool_executor')
        if 'code_generation' in analysis['intents']:
            analysis['executors_needed'].append('code_generator')
        if 'creative' in analysis['intents']:
            analysis['executors_needed'].append('creative_synthesizer')
        if 'reasoning' in analysis['intents'] or analysis['complexity'] > 0.5:
            analysis['executors_needed'].append('reasoning_engine')
        if 'meta' in analysis['intents']:
            analysis['executors_needed'].append('meta_coordinator')
        
        # Default: use conversation model
        if not analysis['executors_needed']:
            analysis['executors_needed'].append('conversation_model')
        
        return analysis


# ============================================================================
# EXECUTOR REGISTRY - Maps executors to available resources
# ============================================================================

class ExecutorRegistry:
    """
    Maintains registry of available executors and their capabilities
    Adapts to hardware on initialization
    """
    
    def __init__(self, pod_root: Path):
        self.pod_root = pod_root
        self.hardware = detect_hardware()
        self.executors = self._discover_executors()
    
    def _discover_executors(self) -> Dict:
        """
        Discover what's available on this Pod for this hardware
        """
        models_dir = self.pod_root / "models"
        archive_models = self.pod_root / "_archive_old" / "models"
        
        executors = {
            'tool_executor': {
                'type': 'python_functions',
                'module': 'ember_tools',
                'capabilities': ['search', 'read', 'write', 'list', 'file_operations']
            },
            'code_generator': {
                'type': 'model',
                'path': models_dir / "spark",  # DeepSeek 1.3B
                'size': '1.3B',
                'capabilities': ['code_generation', 'code_review', 'structured_output']
            },
            'creative_synthesizer': {
                'type': 'model',
                'path': models_dir / "echo",  # Qwen 0.5B
                'size': '0.5B',
                'capabilities': ['lateral_thinking', 'idea_generation', 'concept_blending']
            },
            'reasoning_engine': None,  # To be discovered
            'conversation_model': None,  # To be discovered
            'meta_coordinator': {
                'type': 'coordination',
                'module': 'auto_coordinate',
                'capabilities': ['multi_executor_synthesis', 'deep_reasoning']
            }
        }
        
        # Discover reasoning engine based on hardware
        if self.hardware.vram_gb >= 10:
            # High-end: Use Hermes 8B
            hermes_path = archive_models / "hermes-3-llama-3.1-8b"
            if hermes_path.exists():
                executors['reasoning_engine'] = {
                    'type': 'model',
                    'path': hermes_path,
                    'size': '8B',
                    'capabilities': ['deep_reasoning', 'tool_execution', 'structured_output']
                }
                executors['conversation_model'] = {
                    'type': 'model',
                    'path': archive_models / "llama-3.2-3b-instruct",
                    'size': '3B',
                    'capabilities': ['conversation', 'narration', 'explanation']
                }
        elif self.hardware.vram_gb >= 4:
            # Mid-range: Use Llama 3B for both
            llama_path = archive_models / "llama-3.2-3b-instruct"
            if llama_path.exists():
                executors['reasoning_engine'] = {
                    'type': 'model',
                    'path': llama_path,
                    'size': '3B',
                    'capabilities': ['reasoning', 'tool_execution', 'conversation']
                }
                executors['conversation_model'] = executors['reasoning_engine']
        else:
            # Low-end: Use smaller models or CPU
            executors['reasoning_engine'] = executors['code_generator']  # Use Spark
            executors['conversation_model'] = executors['creative_synthesizer']  # Use Echo
        
        return executors
    
    def get_executor(self, executor_name: str) -> Optional[Dict]:
        """Get executor info by name"""
        return self.executors.get(executor_name)


# ============================================================================
# REQUEST ROUTER - Routes parsed requests to executors
# ============================================================================

class RequestRouter:
    """
    Routes requests to appropriate executors based on:
    - Intent analysis
    - Hardware capabilities
    - Executor availability
    """
    
    def __init__(self, pod_root: Path):
        self.parser = RequestParser()
        self.registry = ExecutorRegistry(pod_root)
    
    def route(self, message: str, context: Optional[Dict] = None) -> Dict:
        """
        Parse and route request
        
        Returns:
            {
                'analysis': Dict,
                'execution_plan': List[Dict],
                'synthesis_method': str
            }
        """
        # Parse request
        analysis = self.parser.parse(message, context)
        
        # Build execution plan
        execution_plan = []
        for executor_name in analysis['executors_needed'][:3]:  # Max 3 executors
            executor = self.registry.get_executor(executor_name)
            if executor:
                execution_plan.append({
                    'executor': executor_name,
                    'config': executor,
                    'input': message
                })
        
        # Determine synthesis method
        if len(execution_plan) == 1:
            synthesis_method = 'direct'
        elif len(execution_plan) > 1:
            synthesis_method = 'multi_executor_coordination'
        else:
            synthesis_method = 'fallback'
        
        return {
            'analysis': analysis,
            'execution_plan': execution_plan,
            'synthesis_method': synthesis_method
        }


