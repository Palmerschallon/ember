        match = re.search(pattern, user_message, re.IGNORECASE)
        if match:
            path = match.group(1).strip('"`\'')
            intents.append(("read", {"path": path}))
            break
    
    # List intent
    if any(word in message_lower for word in ['list', 'show files', 'what files', 'ls', 'dir']):
        # Extract directory if specified
        dir_match = re.search(r'(?:in|from)\s+(\S+)', user_message)
        directory = dir_match.group(1) if dir_match else "."
        intents.append(("list", {"directory": directory}))
    
    # Write intent - only if explicitly requested
    write_match = re.search(r'write\s+(?:to\s+)?([^\s]+)\s+(.+)', user_message, re.IGNORECASE)
    if write_match:
        path = write_match.group(1).strip('"`\'')
        content = write_match.group(2)
        intents.append(("write", {"path": path, "content": content}))
    
    return intents

