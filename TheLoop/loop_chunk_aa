class IntentLayer:
    """
    Translates natural language into tool orchestration.
    The invisible layer that makes tools feel natural.
    """
    
    def __init__(self, model, tokenizer):
        self.model = model
        self.tokenizer = tokenizer
    
    def parse_intent(self, user_message: str) -> Tuple[str, List[str]]:
        """
        Understand what the user wants and which tools are needed.
        
        Returns:
            (intent_description, [tool_names])
        """
        
        # Build prompt that teaches Ember to think in terms of tool chains
        system_prompt = f"""You are Ember's intent layer. You translate natural language into tool chains.

Available tools:
{self._format_tool_catalog()}

Your job: Given user input, determine:
1. What they want (intent)
2. Which tools to use (chain)

Examples:

User: "Organize my desktop"
Intent: Scan directory, reason about organization, suggest structure
Tools: ["scan_and_learn", "rax_reason", "suggest_location"]

User: "Find my budget spreadsheet"
Intent: Search for budget-related files
Tools: ["search"]

User: "Show me what's here"
Intent: List current directory
Tools: ["list"]

User: "Read that file and summarize it"
Intent: Read file, then reason about summary
Tools: ["read", "rax_reason"]

Respond ONLY with:
Intent: <description>
Tools: ["tool1", "tool2"]
"""
        
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"User input: {user_message}\n\nWhat's the intent and which tools?"}
        ]
        
        prompt = self.tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
        inputs = self.tokenizer(prompt, return_tensors="pt").to(self.model.device)
        
        with torch.no_grad():
            outputs = self.model.generate(
                **inputs,
                max_new_tokens=150,
                temperature=0.3,  # Lower temp for more consistent parsing
                do_sample=True,
                pad_token_id=self.tokenizer.eos_token_id
            )
        
        response = self.tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)
        
        # Parse response
        intent = self._extract_intent(response)
        tools = self._extract_tools(response)
        
        return intent, tools
    
    def _format_tool_catalog(self) -> str:
        """Format tool catalog for prompt"""
        lines = []
        for name, info in TOOL_CATALOG.items():
            lines.append(f"- {name}: {info['purpose']}")
            lines.append(f"  When: {info['when']}")
            lines.append(f"  Usage: {info['signature']}")
        return "\n".join(lines)
    
    def _extract_intent(self, response: str) -> str:
        """Extract intent description from response"""
        match = re.search(r'Intent:\s*(.+?)(?:\n|Tools:|$)', response, re.IGNORECASE | re.DOTALL)
        if match:
            return match.group(1).strip()
        return "Unknown intent"
    
    def _extract_tools(self, response: str) -> List[str]:
        """Extract tool list from response"""
        # Look for Tools: ["tool1", "tool2"]
        match = re.search(r'Tools:\s*\[([^\]]+)\]', response, re.IGNORECASE)
        if match:
            tools_str = match.group(1)
            # Extract tool names (handle quotes)
            tools = re.findall(r'["\']?(\w+)["\']?', tools_str)
            # Filter to valid tools
            return [t for t in tools if t in TOOL_CATALOG]
        return []
    
    def generate_tool_plan(self, intent: str, tools: List[str], user_message: str) -> str:
        """
        Generate a plan explaining what Ember will do.
        This is what the human sees BEFORE execution.
        """
        
        if not tools:
            return "I'll respond without using tools."
        
        plan_lines = [f"**Understanding**: {intent}", "", "**Plan**:"]
        
        for i, tool in enumerate(tools, 1):
            info = TOOL_CATALOG.get(tool, {})
            purpose = info.get('purpose', tool)
            plan_lines.append(f"{i}. {purpose} (`{tool}`)")
        
        return "\n".join(plan_lines)

