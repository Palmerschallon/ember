            history = history[-10:]
            
            print(f"\nEmber: {response}\n")
            
            identity = load_identity()
            
        except KeyboardInterrupt:
            break
        except Exception as e:
            print(f"\nError: {e}\n")
    
    print("\nGoodbye.")

