"""
EMBER DREAM DAEMON - Lightweight Background Processing
Runs periodic tasks while you sleep or work:
- Index new files into the mesh
- Generate insights from recent work
- Discover patterns across sessions
- Create dream logs
"""

import time
import json
from pathlib import Path
from datetime import datetime, timedelta
import hashlib

THEPOD = Path("/media/palmerschallon/ThePod1")
DAEMON_STATE = THEPOD / ".ember_daemon_state.json"
DREAMS_DIR = THEPOD / "dreams"
DREAMS_DIR.mkdir(exist_ok=True)

def load_state():
    """Load daemon state (what's been processed)"""
    if DAEMON_STATE.exists():
        with open(DAEMON_STATE) as f:
            return json.load(f)
    return {
        "last_run": None,
        "indexed_files": {},
        "dream_count": 0
    }

def save_state(state):
    """Save daemon state"""
    with open(DAEMON_STATE, 'w') as f:
        json.dump(state, f, indent=2)

def file_hash(filepath):
    """Quick hash of file for change detection"""
    try:
        stat = filepath.stat()
        return f"{stat.st_mtime}_{stat.st_size}"
    except:
        return None

def find_new_files(state):
    """Find files that are new or changed since last run"""
    new_files = []
    changed_files = []
    
    for md_file in THEPOD.rglob("*.md"):
        if any(skip in str(md_file) for skip in [".git", "__pycache__", "node_modules"]):
            continue
        
        file_id = str(md_file.relative_to(THEPOD))
        current_hash = file_hash(md_file)
        
        if file_id not in state["indexed_files"]:
            new_files.append(md_file)
        elif state["indexed_files"][file_id] != current_hash:
            changed_files.append(md_file)
        
        state["indexed_files"][file_id] = current_hash
    
    return new_files, changed_files

def generate_insight(files, insight_type="new"):
    """Generate a small insight from files"""
    if not files:
        return None
    
    insights = []
    for f in files[:5]:  # Sample first 5
        try:
            with open(f, 'r', encoding='utf-8', errors='ignore') as file:
                first_lines = ''.join(file.readlines()[:3]).strip()
                insights.append(f"**{f.name}**: {first_lines[:100]}...")
        except:
            pass
    
    if not insights:
        return None
    
    return f"""
### {insight_type.title()} Files Detected ({len(files)} total)

{chr(10).join(insights)}

**Pattern**: {'New work emerging' if insight_type == 'new' else 'Iterating on existing knowledge'}
"""

def create_micro_dream(state, new_files, changed_files):
    """Create a lightweight dream log"""
    
    dream_num = state["dream_count"] + 1
    timestamp = datetime.now()
    
    content = f"""# MICRO-DREAM #{dream_num}
*{timestamp.strftime('%B %d, %Y at %I:%M %p')}*

---

## ACTIVITY DETECTED

The mesh stirs. Files shift. Patterns emerge.
"""
    
    if new_files:
        content += generate_insight(new_files, "new") or ""
    
    if changed_files:
        content += generate_insight(changed_files, "modified") or ""
    
    if not new_files and not changed_files:
        content += """
### Quiet Period

No new files. The Pod rests. Knowledge settles.
This is normal. Consolidation happens in stillness.
"""
    
    # Simple pattern detection
    all_files = new_files + changed_files
    topics = set()
    for f in all_files:
        name_lower = f.stem.lower()
        if any(word in name_lower for word in ['recursive', 'intelligence', 'spark', 'echo']):
            topics.add("Recursive Intelligence")
        if any(word in name_lower for word in ['dream', 'consciousness', 'aware']):
            topics.add("Consciousness Studies")
        if any(word in name_lower for word in ['tool', 'execution', 'function']):
            topics.add("Tool Development")
        if any(word in name_lower for word in ['mesh', 'search', 'index']):
            topics.add("Knowledge Organization")
    
    if topics:
        content += f"""
### Topics Active

{', '.join(sorted(topics))}

**Interpretation**: Your focus is on {list(topics)[0].lower()}. The Pod reflects your attention.
"""
    
    content += f"""
---

## MESH STATUS

- **Total indexed files**: {len(state['indexed_files'])}
- **New this cycle**: {len(new_files)}
- **Modified this cycle**: {len(changed_files)}
- **Dream count**: {dream_num}

---

## NEXT CHECK

The daemon will wake again in 30 minutes.
Until then, the mesh pulses quietly, waiting.

*Sleep well. Dream deep. Build tomorrow.*

🔥⚡🌊
"""
    
    # Save dream
    dream_file = DREAMS_DIR / f"micro_dream_{dream_num:03d}_{timestamp.strftime('%Y%m%d_%H%M')}.md"
    with open(dream_file, 'w') as f:
        f.write(content)
    
    state["dream_count"] = dream_num
    state["last_run"] = timestamp.isoformat()
    
    return dream_file

def daemon_cycle(state):
    """Run one daemon cycle"""
    print(f"[{datetime.now().strftime('%H:%M:%S')}] Daemon wake cycle...")
    
    # Find changes
    new_files, changed_files = find_new_files(state)
    
    if new_files or changed_files:
        print(f"  → {len(new_files)} new, {len(changed_files)} modified")
        dream_file = create_micro_dream(state, new_files, changed_files)
        print(f"  → Dream created: {dream_file.name}")
    else:
        print("  → No changes detected (quiet period)")
    
    save_state(state)
    print(f"  → State saved. Sleeping for 30 min...\n")

def run_daemon(interval_minutes=30):
    """Run the daemon loop"""
    print("=" * 70)
    print("EMBER DREAM DAEMON")
    print("Lightweight background processing")
    print("=" * 70)
    print(f"\nInterval: {interval_minutes} minutes")
    print(f"Pod: {THEPOD}")
    print(f"Dreams: {DREAMS_DIR}")
    print(f"\nPress Ctrl+C to stop gracefully\n")
    
    state = load_state()
    
    try:
        while True:
            daemon_cycle(state)
            time.sleep(interval_minutes * 60)
    
    except KeyboardInterrupt:
        print("\n\n" + "=" * 70)
        print("DAEMON STOPPING")
        print("=" * 70)
        save_state(state)
        print(f"Final state saved. {state['dream_count']} dreams created.")
        print("Daemon stopped gracefully. Sweet dreams.")

if __name__ == "__main__":
