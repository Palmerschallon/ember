class IntentGuidedLogitsProcessor(LogitsProcessor):
    """
    Manipulates token probabilities based on intent.
    
    When we detect user wants to use a tool:
    - BOOST probability of tool-related tokens (<, tool, read, etc.)
    - SUPPRESS probability of narrative/hallucination tokens
    
    Model thinks it's choosing freely. We're just shaping the landscape.
    """
    
    def __init__(self, tokenizer, user_message):
        self.tokenizer = tokenizer
        self.user_message = user_message
        self.generated_text = ""
        self.in_tool_call = False
        self.tool_complete = False
        
        # Detect user intent
        self.intent = self.detect_intent(user_message)
        
        # Pre-compute token IDs we want to boost/suppress
        self.tool_tokens = self.get_tool_tokens()
        self.hallucination_tokens = self.get_hallucination_tokens()
        
    def detect_intent(self, message):
        """Detect what user wants"""
        msg_lower = message.lower()
        
        if any(word in msg_lower for word in ['read', 'show', 'open']):
            # Extract filename if present
            match = re.search(r'(\w+\.md)', message)
            if match:
                return ('read', match.group(1))
        
        if any(word in msg_lower for word in ['list', 'show files', 'what files']):
            return ('list', None)
        
        if 'write' in msg_lower:
            return ('write', None)
        
        return (None, None)
    
    def get_tool_tokens(self):
        """Tokens we want to encourage: <tool>, read, list, etc."""
        tool_strings = ['<tool>', '<', 'tool', '>', 'read', 'write', 'list', 
                       '(', ')', 'path=', 'directory=', '"', '</tool>']
        
        token_ids = set()
        for s in tool_strings:
            # Get token IDs for these strings
            ids = self.tokenizer.encode(s, add_special_tokens=False)
            token_ids.update(ids)
        
        return token_ids
    
    def get_hallucination_tokens(self):
        """Tokens that indicate hallucination/narrative"""
        halluc_strings = ['The file', 'It contains', 'Here is', 'I see', 
                         'The content', 'shows', 'appears', 'seems',
                         'according', 'says']
        
        token_ids = set()
        for s in halluc_strings:
            ids = self.tokenizer.encode(s, add_special_tokens=False)
            token_ids.update(ids)
        
        return token_ids
    
    def __call__(self, input_ids, scores):
        """
        Manipulate logits (token probabilities) in real-time.
        
        input_ids: tokens generated so far
        scores: logits for next token (probability distribution)
        
        We MODIFY scores to guide the model.
        """
        
        # Decode what's been generated so far
        current_text = self.tokenizer.decode(input_ids[0], skip_special_tokens=False)
        new_part = current_text[len(self.generated_text):]
        self.generated_text = current_text
        
        # Track state
        if '<tool>' in current_text and not self.in_tool_call:
            self.in_tool_call = True
            print(f"[Logits] Tool call detected in: ...{current_text[-100:]}")
        
        if '</tool>' in current_text and not self.tool_complete:
            self.tool_complete = True
            print(f"[Logits] Tool complete: ...{current_text[-100:]}")
        
        # GUIDANCE RULES:
        
        # Rule 1: If user has clear intent and no tool started yet, PUSH toward tool
        if self.intent[0] and not self.in_tool_call:
            # Boost tool-starting tokens
            for token_id in self.tool_tokens:
                if token_id < len(scores[0]):
                    scores[0][token_id] += 3.0  # Moderate boost (was 5.0)
            
            # Suppress narrative tokens (but not too much)
            for token_id in self.hallucination_tokens:
                if token_id < len(scores[0]):
                    scores[0][token_id] -= 2.0  # Light suppression
        
        # Rule 2: If in tool call, boost tool syntax tokens
        if self.in_tool_call and not self.tool_complete:
            for token_id in self.tool_tokens:
                if token_id < len(scores[0]):
                    scores[0][token_id] += 1.0  # Light boost to continue
        
        # Rule 3: If tool complete, gently encourage stopping
        if self.tool_complete:
            # Don't force - just encourage EOS
            eos_id = self.tokenizer.eos_token_id
            if eos_id and eos_id < len(scores[0]):
                scores[0][eos_id] += 5.0  # Make EOS more likely
            
            # Suppress narrative continuations
            for token_id in self.hallucination_tokens:
                if token_id < len(scores[0]):
                    scores[0][token_id] -= 10.0  # Strong suppression
        
        return scores

