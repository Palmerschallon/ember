        """Move files to their new locations"""
        action = "Would move" if dry_run else "Moving"
        print(f"\n📦 {action} files...")
        
        moved = 0
        for category, subcategories in organization.items():
            if isinstance(subcategories, dict):
                for subcategory, filenames in subcategories.items():
                    target_dir = self.output_dir / category / subcategory
                    
                    for filename in filenames:
                        # Find original file
                        original = self._find_file(filename)
                        if original:
                            target = target_dir / filename
                            print(f"   {filename} → {category}/{subcategory}/")
                            
                            if not dry_run:
                                try:
                                    shutil.copy2(original, target)  # copy preserves metadata
                                    moved += 1
                                except Exception as e:
