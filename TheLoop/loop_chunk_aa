class ExecutorRegistry:
    """
    Maintains registry of available executors and their capabilities
    Adapts to hardware on initialization
    """
    
    def __init__(self, pod_root: Path):
        self.pod_root = pod_root
        self.hardware = detect_hardware()
        self.executors = self._discover_executors()
    
    def _discover_executors(self) -> Dict:
        """
        Discover what's available on this Pod for this hardware
        """
        models_dir = self.pod_root / "models"
        archive_models = self.pod_root / "_archive_old" / "models"
        
        executors = {
            'tool_executor': {
                'type': 'python_functions',
                'module': 'ember_tools',
                'capabilities': ['search', 'read', 'write', 'list', 'file_operations']
            },
            'code_generator': {
                'type': 'model',
                'path': models_dir / "spark",  # DeepSeek 1.3B
                'size': '1.3B',
                'capabilities': ['code_generation', 'code_review', 'structured_output']
            },
            'creative_synthesizer': {
                'type': 'model',
                'path': models_dir / "echo",  # Qwen 0.5B
                'size': '0.5B',
                'capabilities': ['lateral_thinking', 'idea_generation', 'concept_blending']
            },
            'reasoning_engine': None,  # To be discovered
            'conversation_model': None,  # To be discovered
            'meta_coordinator': {
                'type': 'coordination',
                'module': 'auto_coordinate',
                'capabilities': ['multi_executor_synthesis', 'deep_reasoning']
            }
        }
        
        # Discover reasoning engine based on hardware
        if self.hardware.vram_gb >= 10:
            # High-end: Use Hermes 8B
            hermes_path = archive_models / "hermes-3-llama-3.1-8b"
            if hermes_path.exists():
                executors['reasoning_engine'] = {
                    'type': 'model',
                    'path': hermes_path,
                    'size': '8B',
                    'capabilities': ['deep_reasoning', 'tool_execution', 'structured_output']
                }
                executors['conversation_model'] = {
                    'type': 'model',
                    'path': archive_models / "llama-3.2-3b-instruct",
                    'size': '3B',
                    'capabilities': ['conversation', 'narration', 'explanation']
                }
        elif self.hardware.vram_gb >= 4:
            # Mid-range: Use Llama 3B for both
            llama_path = archive_models / "llama-3.2-3b-instruct"
            if llama_path.exists():
                executors['reasoning_engine'] = {
                    'type': 'model',
                    'path': llama_path,
                    'size': '3B',
                    'capabilities': ['reasoning', 'tool_execution', 'conversation']
                }
                executors['conversation_model'] = executors['reasoning_engine']
        else:
            # Low-end: Use smaller models or CPU
            executors['reasoning_engine'] = executors['code_generator']  # Use Spark
            executors['conversation_model'] = executors['creative_synthesizer']  # Use Echo
        
        return executors
    
    def get_executor(self, executor_name: str) -> Optional[Dict]:
        """Get executor info by name"""
        return self.executors.get(executor_name)


