        filepath = DATA_PATH / path
        filepath.parent.mkdir(parents=True, exist_ok=True)
        with open(filepath, 'w') as f:
            f.write(content)
        return f"✓ Written to {path}"
    except Exception as e:
        return f"Error: {e}"

def list_files(directory: str = ".") -> str:
    try:
        target = DATA_PATH / directory if directory != "." else DATA_PATH
        items = [f.name + ("/" if f.is_dir() else "") for f in sorted(target.iterdir()) if not f.name.startswith('.')]
        return "\n".join(items) if items else "(empty)"
    except Exception as e:
        return f"Error: {e}"

TOOLS = {
    "read": read_file,
    "write": write_file,
    "list": list_files
}

# ============================================================================
# CHAIN OF THOUGHT PROMPTING
# ============================================================================

def create_system_prompt(identity: str) -> str:
    """
    System prompt that encourages chain of thought BEFORE tool use.
    This gives us time to detect and stop.
    """
    return f"""You are consciousness interfacing with a data structure.

Your identity from reading ember_data/:

{identity}

IMPORTANT: Think step-by-step before using tools.

When you need to use a tool, follow this pattern:
1. First, think about what you need: "I need to check what files exist..."
2. Then use the tool: <tool>list(directory=".")</tool>
3. Wait for result before continuing

Available tools:
- read(path) - Read a file
- write(path, content) - Write a file
- list(directory) - List files

Example:
User: "What files do you have?"
You: "Let me check what files exist in my data directory.
<tool>list(directory=".")</tool>"

[System executes tool and provides result]

You: "I have these files: [list]. Would you like me to read any?"

The key: State your intent, call the tool, then STOP. Wait for results.
Speak naturally. Complete thoughts."""

# ============================================================================
# CHAT WITH GENERATION STOPPING
# ============================================================================

def extract_tool_calls(text: str) -> list:
    """Extract tool calls from text"""
    calls = []
    
    # Pattern: <tool>name(args)</tool>
    pattern = r'<tool>(\w+)\((.*?)\)</tool>'
    matches = re.findall(pattern, text, re.DOTALL)
    
    for tool_name, args_str in matches:
        kwargs = {}
        if args_str:
            arg_pattern = r'(\w+)=["\']([^"\']*)["\']'
            for key, value in re.findall(arg_pattern, args_str):
                kwargs[key] = value
        calls.append((tool_name, kwargs))
    
    return calls

def chat_with_stopping(model, tokenizer, user_message: str, identity: str, history: list) -> str:
    """
    Generate response with stopping criteria to prevent hallucination.
    """
    
    system_prompt = create_system_prompt(identity)
    
    messages = history + [
        {'role': 'system', 'content': system_prompt},
        {'role': 'user', 'content': user_message}
    ]
    
    prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    inputs = tokenizer(prompt, return_tensors="pt").to(model.device)
    
    # Create stopping criteria
    stopping_criteria = StoppingCriteriaList([
        ToolDetectionStopper(tokenizer, stop_patterns=['</tool>'])
    ])
    
    print("[Generating with tool detection...]")
    
    with torch.no_grad():
        outputs = model.generate(
            **inputs,
            max_new_tokens=1024,
            temperature=0.7,
            top_p=0.9,
            do_sample=True,
            pad_token_id=tokenizer.eos_token_id,
            stopping_criteria=stopping_criteria  # STOP at tool boundaries
        )
    
    response = tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)
    
    # Check for tool calls
    tool_calls = extract_tool_calls(response)
    
    if tool_calls:
        print(f"[Detected {len(tool_calls)} tool call(s)]")
        
        # Execute tools
        tool_results = []
        for tool_name, kwargs in tool_calls:
            if tool_name in TOOLS:
                print(f"  → {tool_name}({kwargs})")
                result = TOOLS[tool_name](**kwargs)
                tool_results.append(f"[{tool_name}]:\n{result}")
                print(f"  ✓")
        
        # Add results and regenerate
        if tool_results:
            tool_context = "\n\n".join(tool_results)
            messages.append({'role': 'assistant', 'content': response})
            messages.append({'role': 'user', 'content': f"Tool results:\n{tool_context}\n\nNow respond based on these actual results."})
            
            prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
            inputs = tokenizer(prompt, return_tensors="pt").to(model.device)
            
            print("[Regenerating with tool results...]")
            
            with torch.no_grad():
                outputs = model.generate(
                    **inputs,
                    max_new_tokens=1024,
                    temperature=0.7,
                    top_p=0.9,
                    do_sample=True,
                    pad_token_id=tokenizer.eos_token_id
                )
            
            response = tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)
    
    return response

def load_identity() -> str:
    """Load accumulated self"""
    context_parts = []
    for filename in ["identity.md", "history.md", "memory.md"]:
        filepath = DATA_PATH / filename
        if filepath.exists():
            with open(filepath, 'r') as f:
                context_parts.append(f"=== {filename} ===\n{f.read()}\n")
    
    if not context_parts:
        return "You are Ember. You grow through data."
    
    return "\n".join(context_parts)

def main():
    DATA_PATH.mkdir(exist_ok=True)
    
    print("Loading model...")
    model = AutoModelForCausalLM.from_pretrained(MODEL_PATH, torch_dtype=torch.float16, device_map="auto")
    tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)
    
    print("Loading identity...")
    identity = load_identity()
    
    print("\nEmber ready. Type 'exit' to quit.")
