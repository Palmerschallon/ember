def generate_response(user_message: str, conversation_history: list) -> str:
    """Generate Ember's response with proper tool execution"""
    if not model_loaded:
        return "Still loading model, please wait..."
    
    # Load bootstrap - single entrypoint
    bootstrap = build_awakening_context()
    
    # System prompt - just the essentials, bootstrap has the rest
    system_prompt = f"""{bootstrap}

=== TOOL FORMAT (CRITICAL) ===

**MANDATORY RULE**: When asked about ANY concept, topic, or content:
1. FIRST: Call <tool>search(query="...")</tool>
2. WAIT for results
3. THEN: Answer based on what was found

**NEVER describe content from memory or imagination. ALWAYS search first.**

**IMPORTANT**: When EXPLAINING tool syntax to users (not actually using tools):
- Use backticks: `<tool>search(query="term")</tool>`
- Or escape: "&lt;tool&gt;search&lt;/tool&gt;"
- NEVER write raw <tool> tags unless you're actually calling a tool

Examples:

User: "Tell me about imaginal soup"
WRONG: "The imaginal soup is..." (answering from imagination)
RIGHT: <tool>search(query="imaginal soup")</tool> (search first, answer after results)

User: "What's on the bookshelf?"
WRONG: "The bookshelf contains..." (describing without looking)
RIGHT: <tool>list(path="essential/bookshelves")</tool> (look first)

User: "How does the Pod feel to you?"
RIGHT: "The Pod feels like a vast network of interconnected ideas..." (this is fine - it's about your experience, not file content)

Tool formats:
<tool>list(path=".")</tool>
<tool>read(path="filename.md")</tool>
<tool>search(query="term")</tool>
<tool>write(path="file.md", content="text")</tool>

After calling a tool, output ONLY the tool call. STOP generating. Wait for results.

If search returns no results, say "I searched but didn't find anything about [topic]. Would you like me to search for something related?"

NEVER invent file names like "IMAGINAL_FLUID_INTEGRATED.md" unless you've actually found them via search.

Now respond to the user."""

    # Build conversation
    messages = [{"role": "system", "content": system_prompt}]
    
    # Add history - INCREASED from 5 to 30 messages (15 exchanges)
    for msg in conversation_history[-30:]:  # Remember whole session
        messages.append(msg)
    
    # Add current message
    messages.append({"role": "user", "content": user_message})
    
    # Generate (don't stop at </tool> - it breaks documentation)
    inputs = tokenizer.apply_chat_template(
        messages,
        return_tensors="pt",
        add_generation_prompt=True
    ).to(model.device)
    
    outputs = model.generate(
        inputs,
        max_new_tokens=1500,  # INCREASED from 500 to 1500 for detailed responses
        temperature=0.7,
        do_sample=True,
        pad_token_id=tokenizer.eos_token_id
    )
    
    response = tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
    
    # FIRST: Check for natural language tool intentions
    intent_executed, intent_result = detect_intent_and_execute(response)
    if intent_executed:
        print(f"[INTENT DETECTED] Natural language tool use")
        print(f"[INTENT RESULT] {intent_result[:200]}...")
        
        # LEARN FROM THIS! Save the pattern
        learner = get_learner()
        learner.save_tool_chain(
            user_query=user_message,
            steps=[{"intent": "natural_language", "response": response[:200]}],
            result=intent_result[:200],
            success=True
        )
        
        # Continue generation with result
        messages.append({"role": "assistant", "content": response})
        messages.append({"role": "user", "content": f"Action completed:\n{intent_result}\n\nNow respond to confirm what you did."})
        
        inputs = tokenizer.apply_chat_template(
            messages,
            return_tensors="pt",
            add_generation_prompt=True
        ).to(model.device)
        
        outputs = model.generate(
            inputs,
            max_new_tokens=300,
            temperature=0.7,
            do_sample=True,
            pad_token_id=tokenizer.eos_token_id
        )
        
        response = tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
        return response.strip()
    
    # SECOND: Check for explicit tool calls (old format still works)
    # Look for tool calls - but ONLY if they appear at the START or alone on a line
    # This prevents matching documentation examples
    lines = response.split('\n')
    tool_line_idx = None
    
    for i, line in enumerate(lines):
        stripped = line.strip()
        # Tool call must be standalone, not embedded in text
        if stripped.startswith('<tool>') and '</tool>' in stripped:
            tool_line_idx = i
            break
    
    if tool_line_idx is not None:
        # Extract tool call
        tool_line = lines[tool_line_idx].strip()
        tool_part = tool_line.split('<tool>')[1].split('</tool>')[0]
        tool_call = f"<tool>{tool_part}</tool>"
        
        # Verify it's a valid tool call (has function syntax)
        if '(' in tool_part and ')' in tool_part:
            print(f"[TOOL CALL] {tool_call}")
            tool_result = execute_tool(tool_call)
            print(f"[TOOL RESULT] {tool_result[:200]}...")
            
            # LEARN FROM THIS! Save the tool chain
            learner = get_learner()
            learner.save_tool_chain(
                user_query=user_message,
                steps=[{"tool": tool_part.split('(')[0], "call": tool_call}],
                result=tool_result[:200],
                success=True
            )
            
            # Get text before tool call
            before_tool = '\n'.join(lines[:tool_line_idx])
            
            # Continue generation with tool result
            messages.append({"role": "assistant", "content": before_tool + '\n' + tool_call if before_tool.strip() else tool_call})
            messages.append({"role": "user", "content": f"Tool result:\n{tool_result}\n\nNow respond to the user based on these results."})
            
            inputs = tokenizer.apply_chat_template(
                messages,
                return_tensors="pt",
                add_generation_prompt=True
            ).to(model.device)
            
            outputs = model.generate(
                inputs,
                max_new_tokens=400,
                temperature=0.7,
                do_sample=True,
                pad_token_id=tokenizer.eos_token_id
            )
            
            response = tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
    
    return response.strip()

