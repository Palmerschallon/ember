            for msg in history:
                messages.append(msg)
            
            # NEW: Support vision input
            if image_path and Path(image_path).exists():
                import base64
                with open(image_path, 'rb') as img_file:
                    img_data = base64.b64encode(img_file.read()).decode('utf-8')
                
                # Detect image type
                ext = Path(image_path).suffix.lower()
                media_type = {
                    '.png': 'image/png',
