def broadcast_status(phase, details=None):
    """Broadcast current status to connected clients"""
    try:
        socketio.emit('status_update', {
            'phase': phase,
            'details': details,
            'timestamp': datetime.now().isoformat()
        })
    except:
        pass  # Don't break if no WebSocket clients

