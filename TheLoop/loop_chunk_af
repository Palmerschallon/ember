            codeLines.forEach((line, index) => {
                setTimeout(() => {
                    // Find matching pattern
                    for (const [keyword, config] of Object.entries(codeToSynesthesia)) {
                        if (line.includes(keyword)) {
                            // Play sound
                            playNote(config.frequency, 0.3, config.wave);
                            
                            // Generate particles
                            for (let i = 0; i < config.particleCount; i++) {
                                const angle = (Math.random() * Math.PI * 2);
                                const distance = Math.random() * 100;
                                const x = canvas.width / 2 + Math.cos(angle) * distance;
                                const y = canvas.height / 2 + Math.sin(angle) * distance;
                                particles.push(new Particle(x, y, config.color, config.pattern));
                            }
                            
                            updateUI(action, config.pattern);
                            break;
                        }
                    }
                }, delay);
                
                delay += 200; // 200ms between lines
            });

