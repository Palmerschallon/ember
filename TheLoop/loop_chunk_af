        result = subprocess.run(
            ['python3', str(temp_file)],
            cwd=str(VOICE_PATH),
            capture_output=True,
            text=True,
            timeout=30
        )
        
        output = result.stdout + result.stderr
        return output if output else "Code executed successfully (no output)"
    except Exception as e:
        return f"Error executing code: {str(e)}"

