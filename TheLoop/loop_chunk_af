    from collections import Counter
    gpt_best = Counter(gpt_solutions).most_common(1)[0][0]
    results.append({"phase": "gpt_generate", "solutions": gpt_solutions, "best": gpt_best})
    
    # Phase 2: Claude swarm critiques
