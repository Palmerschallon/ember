        should_search = True
        print(f"[MESH] Contextual search triggered: {user_msg[:80]}", flush=True)
    
    # DEBUG: Always search for now
    if not should_search:
        should_search = True
        print(f"[MESH] DEBUG: Forcing search for all messages", flush=True)
    
