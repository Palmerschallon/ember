    """Execute Python code in the body"""
    broadcast_status('executing', 'Running Python code')
    try:
        # Write code to temp file
        temp_file = VOICE_PATH / 'temp_code.py'
        with open(temp_file, 'w') as f:
            f.write(code)
        
        # Execute
