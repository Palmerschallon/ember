        function startGenerativeArt(ctx, canvas) {
            const w = canvas.width;
            const h = canvas.height;
            let time = 0;
            let particles = [];
            
            // Create flowing particles
            for (let i = 0; i < 50; i++) {
                particles.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    size: Math.random() * 3 + 1,
                    hue: Math.random() * 60 + 10 // Orange/yellow range
                });
            }
            
            function draw() {
                // Fade previous frame
                ctx.fillStyle = 'rgba(10, 10, 10, 0.1)';
                ctx.fillRect(0, 0, w, h);
                
                time += 0.01;
                
                // Update and draw particles
                particles.forEach((p, i) => {
                    // Flow field motion
                    const angle = Math.sin(p.x * 0.01 + time) * Math.cos(p.y * 0.01 + time) * Math.PI * 2;
                    p.vx += Math.cos(angle) * 0.1;
                    p.vy += Math.sin(angle) * 0.1;
                    
                    // Damping
                    p.vx *= 0.95;
                    p.vy *= 0.95;
                    
                    // Move
                    p.x += p.vx;
                    p.y += p.vy;
                    
                    // Wrap around
                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;
                    if (p.y < 0) p.y = h;
                    if (p.y > h) p.y = 0;
                    
                    // Draw with glow
                    ctx.shadowBlur = 15;
                    ctx.shadowColor = `hsl(${p.hue}, 100%, 60%)`;
                    ctx.fillStyle = `hsl(${p.hue}, 100%, 60%)`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Connect nearby particles
                    for (let j = i + 1; j < particles.length; j++) {
                        const p2 = particles[j];
                        const dx = p.x - p2.x;
                        const dy = p.y - p2.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        
                        if (dist < 80) {
                            ctx.strokeStyle = `hsla(${(p.hue + p2.hue) / 2}, 100%, 60%, ${1 - dist / 80})`;
                            ctx.lineWidth = 0.5;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                });
                
                // Draw text overlay
                ctx.shadowBlur = 0;
                ctx.font = 'bold 16px Courier New';
                ctx.fillStyle = 'rgba(255, 107, 53, 0.8)';
                ctx.textAlign = 'center';
                ctx.fillText('◇ Ember is creating ◇', w / 2, h / 2);
                
                thinkingAnimation = requestAnimationFrame(draw);
            }
            
            draw();
        }

