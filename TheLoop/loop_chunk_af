    results.append({"phase": "claude_critique", "critiques": claude_critiques, "summary": critique_summary})
    
    print(f"[DUAL_SWARM] Complete!", flush=True)
    
    return jsonify({
        "results": results,
        "gpt_size": gpt_size,
        "claude_size": claude_size,
