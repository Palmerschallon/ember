        let isProcessing = false;
        let currentModel = 'openai';
        let conversationHistory = [];  // Track conversation for Claude/GPT memory
        let currentConversationId = null;  // Track current conversation
        let allConversations = [];  // Store all conversations
        let thinkingWindow = null;  // Separate window for thinking visualization
        
        // Open thinking window
        function openThinkingWindow() {
            if (!thinkingWindow || thinkingWindow.closed) {
                thinkingWindow = window.open(
                    'ember_thinking_window.html',
                    'EmberThinking',
                    'width=800,height=600,left=100,top=100'
                );
            }
        }
        
        // Send activity to thinking window
        function logActivity(type, message, tokens = 0) {
            const data = {
                type,
                message,
                tokens,
                timestamp: Date.now()
            };
            
            // Store in localStorage for thinking window to read
            localStorage.setItem('ember_activity', JSON.stringify(data));
            
            // Also try direct postMessage if window is open
            if (thinkingWindow && !thinkingWindow.closed) {
                try {
                    thinkingWindow.postMessage(data, '*');
                } catch (e) {}
            }
        }
        
        // 💬 SIDEBAR EVENT LISTENERS - Attach immediately
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const newChatBtn = document.getElementById('new-chat-btn');
        
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', toggleSidebar);
            console.log('[SIDEBAR] Toggle button listener attached');
        } else {
            console.error('[SIDEBAR] Toggle button not found!');
        }
        
        if (newChatBtn) {
            newChatBtn.addEventListener('click', startNewChat);
            console.log('[SIDEBAR] New chat button listener attached');
