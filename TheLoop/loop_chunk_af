            print(f"  {model:40s} {rate:5.1f}% ({len(model_success)}/{len(model_results)}) @ {avg_time_model:.1f}s avg")
    
    print(f"\n✅ Results saved to: {output_file}")
    print(f"Completed: {datetime.now()}")
    
    return results

if __name__ == "__main__":
