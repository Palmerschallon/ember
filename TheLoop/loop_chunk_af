            height = canvas.height = window.innerHeight;
        });

        // Audio context for real sounds
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        // Particle system - each particle represents a REAL operation
        class Particle {
            constructor(phase, details) {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.phase = phase;
                this.details = details;
                this.life = 1.0;
                this.vx = (Math.random() - 0.5) * 2;
                this.vy = (Math.random() - 0.5) * 2;
                
                // Color based on operation type (REAL mapping)
                this.color = {
                    'thinking': '#2196F3',   // Blue for thinking
                    'reading': '#FFC107',    // Yellow for reading
                    'writing': '#FF9800',    // Orange for writing
                    'executing': '#F44336',  // Red for executing
                    'complete': '#4CAF50'    // Green for complete
                }[phase] || '#666';
                
                // Size based on operation complexity
                this.size = phase === 'executing' ? 8 : 5;
                
                // Play sound for this operation
                this.playSound();
            }

            playSound() {
                try {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    // Frequency maps to operation type (REAL mapping)
                    const freqMap = {
                        'thinking': 220,    // A3 - contemplative
                        'reading': 330,     // E4 - scanning
                        'writing': 440,     // A4 - creative
                        'executing': 550,   // C#5 - active
                        'complete': 660     // E5 - resolution
                    };
                    
                    osc.frequency.value = freqMap[this.phase] || 220;
                    osc.type = this.phase === 'executing' ? 'sawtooth' : 'sine';
                    
                    gain.gain.value = 0.1;
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.2);
                } catch (e) {
                    // Audio might fail on some browsers
                }
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= 0.005;
                
                // Wrap around edges
                if (this.x < 0) this.x = width;
                if (this.x > width) this.x = 0;
                if (this.y < 0) this.y = height;
                if (this.y > height) this.y = 0;
            }

            draw() {
                ctx.save();
                ctx.globalAlpha = this.life;
                
                // Draw particle
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                
                // Draw glow trail
                const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size * 3);
                gradient.addColorStop(0, this.color);
                gradient.addColorStop(1, 'transparent');
                ctx.fillStyle = gradient;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size * 3, 0, Math.PI * 2);
                ctx.fill();
                
                ctx.restore();
            }
        }

