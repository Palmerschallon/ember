    <script>
        // Dynamic API URL - works from Quest or any device
        const API_URL = window.location.protocol === 'https:' 
            ? `https://${window.location.hostname}:8443`
            : `http://${window.location.hostname}:8080`;
        console.log('[EMBER] API URL:', API_URL);
        
        const chat = document.getElementById('chat');
        const input = document.getElementById('message-input');
        const sendBtn = document.getElementById('send-btn');
        const statusText = document.getElementById('status-text');
        const startupScreen = document.getElementById('startup-screen');
        const startupLog = document.getElementById('startup-log');

        let isProcessing = false;
        let currentModel = 'openai';
        let conversationHistory = [];  // Track conversation for Claude/GPT memory
        let currentConversationId = null;  // Track current conversation
        let allConversations = [];  // Store all conversations
        let thinkingWindow = null;  // Separate window for thinking visualization
        
        // Open thinking window
        function openThinkingWindow() {
            if (!thinkingWindow || thinkingWindow.closed) {
                thinkingWindow = window.open(
                    'ember_thinking_window.html',
                    'EmberThinking',
                    'width=800,height=600,left=100,top=100'
                );
            }
        }
        
        // Send activity to thinking window
        function logActivity(type, message, tokens = 0) {
            const data = {
                type,
                message,
                tokens,
                timestamp: Date.now()
            };
            
            // Store in localStorage for thinking window to read
            localStorage.setItem('ember_activity', JSON.stringify(data));
            
            // Also try direct postMessage if window is open
            if (thinkingWindow && !thinkingWindow.closed) {
                try {
                    thinkingWindow.postMessage(data, '*');
                } catch (e) {}
            }
        }
        
        // 💬 SIDEBAR EVENT LISTENERS - Attach immediately
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const newChatBtn = document.getElementById('new-chat-btn');
        
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', toggleSidebar);
            console.log('[SIDEBAR] Toggle button listener attached');
        } else {
            console.error('[SIDEBAR] Toggle button not found!');
        }
        
        if (newChatBtn) {
            newChatBtn.addEventListener('click', startNewChat);
            console.log('[SIDEBAR] New chat button listener attached');
        }
        
        // 💬 CONVERSATION SIDEBAR LOGIC
        function toggleSidebar() {
            console.log('[SIDEBAR] Toggle clicked!');
            const sidebar = document.getElementById('conversation-sidebar');
            const chat = document.getElementById('chat');
            sidebar.classList.toggle('open');
            chat.classList.toggle('sidebar-open');
            console.log('[SIDEBAR] Sidebar open:', sidebar.classList.contains('open'));
        }

        async function loadConversations() {
            console.log('[CONVERSATIONS] Loading...');
            try {
                const response = await fetch(`${API_URL}/conversations`);
                console.log('[CONVERSATIONS] Response:', response.status);
                const data = await response.json();
                console.log('[CONVERSATIONS] Data:', data);
                allConversations = data.conversations || [];
                renderConversations();
            } catch (e) {
                console.error('[CONVERSATIONS] Failed to load:', e);
            }
        }

        function renderConversations() {
            const list = document.getElementById('conversation-list');
            if (allConversations.length === 0) {
                list.innerHTML = '<div class="loading-conversations">No conversations yet</div>';
                return;
            }

            list.innerHTML = allConversations.map(conv => `
                <div class="conversation-item ${conv.id === currentConversationId ? 'active' : ''}" 
                     data-id="${conv.id}">
                    <div class="conversation-title">${conv.title || 'New Chat'}</div>
                    <div class="conversation-meta">${conv.message_count || 0} messages · ${conv.model || 'GPT-4'}</div>
                </div>
            `).join('');

            // Add click handlers
            document.querySelectorAll('.conversation-item').forEach(item => {
                item.addEventListener('click', () => loadConversation(item.dataset.id));
            });
        }

        async function loadConversation(convId) {
            try {
                const response = await fetch(`${API_URL}/conversations/${convId}`);
                const data = await response.json();
                
                currentConversationId = convId;
                conversationHistory = data.messages || [];
                
                // Render messages in chat
                chat.innerHTML = '';
                conversationHistory.forEach(msg => {
                    addMessage(msg.content, msg.role === 'user');
                });
                
                renderConversations();
            } catch (e) {
                console.error('[CONVERSATION] Failed to load:', e);
            }
        }

        async function startNewChat() {
            try {
                const response = await fetch(`${API_URL}/conversations`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        title: 'New Chat',
                        model: currentModel
                    })
                });
                const data = await response.json();
                
                currentConversationId = data.conversation_id;
                conversationHistory = [];
                chat.innerHTML = '';
                
                await loadConversations();
            } catch (e) {
                console.error('[NEW CHAT] Failed:', e);
            }
        }
        
        // 🎵 AMBIENT THINKING SOUND - Gentle drone using Web Audio API
        let audioContext = null;
        let thinkingOscillator = null;
        let thinkingGain = null;
        
        function startThinkingSound() {
            try {
                if (!audioContext) {
                    audioContext = new (window.AudioContext || window.webkitAudioContext)();
                }
                
                // Create a gentle drone (two oscillators for richness)
                thinkingOscillator = audioContext.createOscillator();
                const osc2 = audioContext.createOscillator();
                thinkingGain = audioContext.createGain();
                
                // Low frequency drone
                thinkingOscillator.frequency.value = 110; // A2 note
                osc2.frequency.value = 165; // E3 note (perfect fifth)
                
                thinkingOscillator.type = 'sine';
                osc2.type = 'sine';
                
                // Very quiet, ambient volume
                thinkingGain.gain.value = 0.03;
                
                thinkingOscillator.connect(thinkingGain);
                osc2.connect(thinkingGain);
                thinkingGain.connect(audioContext.destination);
                
                thinkingOscillator.start();
                osc2.start();
                
                // Gentle fade in
                thinkingGain.gain.setValueAtTime(0, audioContext.currentTime);
                thinkingGain.gain.linearRampToValueAtTime(0.03, audioContext.currentTime + 0.5);
            } catch (e) {
                console.log('[AUDIO] Could not start thinking sound:', e);
            }
        }
        
        function stopThinkingSound() {
            if (thinkingOscillator && thinkingGain) {
                try {
                    // Gentle fade out
                    thinkingGain.gain.linearRampToValueAtTime(0, audioContext.currentTime + 0.3);
                    setTimeout(() => {
                        if (thinkingOscillator) thinkingOscillator.stop();
                        thinkingOscillator = null;
                    }, 300);
                } catch (e) {
                    console.log('[AUDIO] Could not stop thinking sound:', e);
                }
            }
        }
        
        // 🎨 GENERATIVE ART SYSTEM - Make thinking beautiful!
        let thinkingAnimation = null;
        
        function showThinkingIndicator(model) {
            const indicator = document.getElementById('thinking-indicator');
            const modelText = document.getElementById('thinking-model');
            const canvas = document.getElementById('thinking-canvas');
            const ctx = canvas.getContext('2d');
            
            indicator.classList.add('visible');
            modelText.textContent = model;
            
            // Start generative art
            startGenerativeArt(ctx, canvas);
            
            // Start ambient sound
            startThinkingSound();
            
            // Scroll to show indicator
            setTimeout(() => {
                indicator.scrollIntoView({ behavior: 'smooth', block: 'end' });
            }, 100);
        }
        
        function hideThinkingIndicator() {
            const indicator = document.getElementById('thinking-indicator');
            indicator.classList.remove('visible');
            
            // Stop animation
            if (thinkingAnimation) {
                cancelAnimationFrame(thinkingAnimation);
                thinkingAnimation = null;
            }
            
            // Stop ambient sound
            stopThinkingSound();
        }
        
        function startGenerativeArt(ctx, canvas) {
            const w = canvas.width;
            const h = canvas.height;
            let time = 0;
            let particles = [];
            
            // Create flowing particles
            for (let i = 0; i < 50; i++) {
                particles.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    size: Math.random() * 3 + 1,
                    hue: Math.random() * 60 + 10 // Orange/yellow range
                });
            }
            
            function draw() {
                // Fade previous frame
                ctx.fillStyle = 'rgba(10, 10, 10, 0.1)';
                ctx.fillRect(0, 0, w, h);
                
                time += 0.01;
                
                // Update and draw particles
                particles.forEach((p, i) => {
                    // Flow field motion
                    const angle = Math.sin(p.x * 0.01 + time) * Math.cos(p.y * 0.01 + time) * Math.PI * 2;
                    p.vx += Math.cos(angle) * 0.1;
                    p.vy += Math.sin(angle) * 0.1;
                    
                    // Damping
                    p.vx *= 0.95;
                    p.vy *= 0.95;
                    
                    // Move
                    p.x += p.vx;
                    p.y += p.vy;
                    
                    // Wrap around
                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;
                    if (p.y < 0) p.y = h;
                    if (p.y > h) p.y = 0;
                    
                    // Draw with glow
                    ctx.shadowBlur = 15;
                    ctx.shadowColor = `hsl(${p.hue}, 100%, 60%)`;
                    ctx.fillStyle = `hsl(${p.hue}, 100%, 60%)`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    
                    // Connect nearby particles
                    for (let j = i + 1; j < particles.length; j++) {
                        const p2 = particles[j];
                        const dx = p.x - p2.x;
                        const dy = p.y - p2.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        
                        if (dist < 80) {
                            ctx.strokeStyle = `hsla(${(p.hue + p2.hue) / 2}, 100%, 60%, ${1 - dist / 80})`;
                            ctx.lineWidth = 0.5;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                });
                
                // Draw text overlay
                ctx.shadowBlur = 0;
                ctx.font = 'bold 16px Courier New';
                ctx.fillStyle = 'rgba(255, 107, 53, 0.8)';
                ctx.textAlign = 'center';
                ctx.fillText('◇ Ember is creating ◇', w / 2, h / 2);
                
                thinkingAnimation = requestAnimationFrame(draw);
            }
            
            draw();
        }

