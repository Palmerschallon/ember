        // Brain Map window
        document.getElementById('brain-map-btn').addEventListener('click', () => {
            window.open('brain_map.html', 'brainmap', 'width=1200,height=800');
        });

        // Initialize
        connectWebSocket();
        loadConversations();
    </script>
