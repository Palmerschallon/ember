    <script>
        const API_URL = 'http://localhost:8080';
        const chat = document.getElementById('chat');
        const input = document.getElementById('input');
        const sendBtn = document.getElementById('send-btn');
        const statusDiv = document.getElementById('status');

        let isProcessing = false;

        function addMessage(text, isUser = false) {
            const div = document.createElement('div');
            div.className = `message ${isUser ? 'user' : 'assistant'}`;
            const content = document.createElement('div');
            content.className = 'message-content';
            content.textContent = text;
            div.appendChild(content);
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
            return content;
        }

        function showThinking() {
            const div = document.createElement('div');
            div.className = 'thinking';
            div.id = 'thinking-indicator';
            div.textContent = '🔥 Ember is creating...';
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
        }

        function hideThinking() {
            const thinking = document.getElementById('thinking-indicator');
            if (thinking) thinking.remove();
        }

        function displayFiles(files, messageDiv) {
            const parent = messageDiv.parentElement;
            
            // Images
            if (files.images && files.images.length > 0) {
                files.images.forEach(img => {
                    const container = document.createElement('div');
                    container.className = 'image-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🖼️ ${img}</span>
                        </div>
                        <img src="${API_URL}/voice/${img}" alt="${img}" />
                    `;
                    parent.appendChild(container);
                });
            }

            // HTML
            if (files.html && files.html.length > 0) {
                files.html.forEach(html => {
                    const container = document.createElement('div');
                    container.className = 'html-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🌐 ${html}</span>
                            <a href="${API_URL}/voice/${html}" target="_blank">Open ↗</a>
                        </div>
                        <iframe src="${API_URL}/voice/${html}"></iframe>
                    `;
                    parent.appendChild(container);
                });
            }

            // Videos
            if (files.videos && files.videos.length > 0) {
                files.videos.forEach(video => {
                    const container = document.createElement('div');
                    container.className = 'video-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🎬 ${video}</span>
                        </div>
                        <video controls autoplay loop>
                            <source src="${API_URL}/voice/${video}">
                        </video>
                    `;
                    parent.appendChild(container);
                });
            }

            // Audio
            if (files.audio && files.audio.length > 0) {
                files.audio.forEach(audio => {
                    const container = document.createElement('div');
                    container.className = 'audio-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🎵 ${audio}</span>
                        </div>
                        <audio controls autoplay>
                            <source src="${API_URL}/voice/${audio}">
                        </audio>
                    `;
                    parent.appendChild(container);
                });
            }

            // 3D Models
            if (files.models && files.models.length > 0) {
                files.models.forEach(model => {
                    const container = document.createElement('div');
                    container.className = 'model-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🎨 ${model}</span>
                            <a href="${API_URL}/voice/${model}" download>Download ↓</a>
                        </div>
                        <div style="padding: 20px;">
                            <p>3D Model Created</p>
                            <p style="font-size: 0.9em; margin-top: 10px;">Download to view in a 3D viewer</p>
                        </div>
                    `;
                    parent.appendChild(container);
                });
            }

            chat.scrollTop = chat.scrollHeight;
        }

        async function sendMessage() {
            if (isProcessing || !input.value.trim()) return;

            const message = input.value.trim();
            input.value = '';
            isProcessing = true;
            sendBtn.disabled = true;
            statusDiv.textContent = 'The heart is beating...';

            addMessage(message, true);
            showThinking();

            try {
                const response = await fetch(`${API_URL}/agent`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        message,
                        model: 'claude-3-5-sonnet-20241022'
                    })
                });

                const data = await response.json();
                hideThinking();

                if (data.error) {
                    addMessage(`❌ Error: ${data.error}`);
                } else {
                    const msgDiv = addMessage(data.response);
                    
                    // Display created files
                    if (data.files_created) {
                        displayFiles(data.files_created, msgDiv);
                    }
                }

            } catch (error) {
                hideThinking();
                addMessage(`❌ Connection error: ${error.message}`);
            }

            isProcessing = false;
            sendBtn.disabled = false;
            statusDiv.textContent = 'Ready';
            input.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // Initial status
        statusDiv.textContent = 'Ready - The organism is alive 🔥';
        input.focus();
    </script>
