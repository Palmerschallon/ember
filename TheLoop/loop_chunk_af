            if (files.models && files.models.length > 0) {
                files.models.forEach(model => {
                    const container = document.createElement('div');
                    container.className = 'model-display';
                    container.innerHTML = `
                        <div class="file-header">
                            <span>🎨 ${model}</span>
                            <a href="${API_URL}/voice/${model}" download>Download ↓</a>
                        </div>
                        <div style="padding: 20px;">
                            <p>3D Model Created</p>
                            <p style="font-size: 0.9em; margin-top: 10px;">Download to view</p>
                        </div>
                    `;
                    parent.appendChild(container);
                });
            }

            chat.scrollTop = chat.scrollHeight;
        }

        async function sendMessage() {
            if (isProcessing || !input.value.trim()) return;

            // Create new conversation if needed
            if (!currentConversationId) {
                await createNewConversation();
            }

            const message = input.value.trim();
            const model = modelSelect.value;
            const imagePath = selectedImage;
            input.value = '';
            selectedImage = null;
            imagePreview.style.display = 'none';
            isProcessing = true;
            sendBtn.disabled = true;

            addMessage(message + (imagePath ? ' 📷' : ''), true);
            showThinking();

            try {
                const requestBody = { 
                    message,
                    model,
                    conversation_id: currentConversationId
                };
                
                // Add image if attached
                if (imagePath) {
                    requestBody.image = imagePath;
                }
                
                const response = await fetch(`${API_URL}/agent`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestBody)
                });

                const data = await response.json();
                hideThinking();

                if (data.error) {
                    addMessage(`❌ Error: ${data.error}`);
                } else {
                    const msgDiv = addMessage(data.response);
                    if (data.files_created) {
                        displayFiles(data.files_created, msgDiv);
                    }
                }

                loadConversations(); // Refresh sidebar
            } catch (error) {
                hideThinking();
                addMessage(`❌ Connection error: ${error.message}`);
            }

            isProcessing = false;
            sendBtn.disabled = false;
            input.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });
        newChatBtn.addEventListener('click', createNewConversation);

        // Synesthesia mode
        document.getElementById('synesthesia-btn').addEventListener('click', () => {
            window.open('synesthesia.html', 'synesthesia', 'width=1200,height=800');
        });

        // Initialize
        loadConversations();
        input.focus();
    </script>
</body>
</html>

