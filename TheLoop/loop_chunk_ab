            padding: 12px;
        }

        .video-output video {
            width: 100%;
            max-width: 600px;
            height: auto;
            display: block;
            border-radius: 6px;
        }

        .video-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            font-size: 13px;
            color: #888;
        }

        .tool-execution {
            background: #0a1a0a;
            border: 1px solid #1a3a1a;
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
            font-size: 13px;
        }

        .tool-execution.success {
            border-color: #2a5a2a;
        }

        .tool-execution.error {
            background: #1a0a0a;
            border-color: #5a2a2a;
        }

        .tool-label {
            color: #4ade80;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .tool-execution.error .tool-label {
            color: #ef4444;
        }

        .output {
            font-family: 'SF Mono', Consolas, monospace;
            font-size: 12px;
            color: #aaa;
        }

        .input-area {
            padding: 20px;
            background: #111;
            border-top: 1px solid #222;
        }

        .input-container {
            display: flex;
            gap: 12px;
            max-width: 1200px;
            margin: 0 auto;
        }

        #message-input {
            flex: 1;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            padding: 14px 18px;
            color: #e0e0e0;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s;
        }

        #message-input:focus {
            border-color: #ff6b35;
        }

        #send-btn {
            background: #ff6b35;
            border: none;
            border-radius: 12px;
            padding: 14px 24px;
            color: white;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        #send-btn:hover {
            background: #ff5520;
        }

        #send-btn:disabled {
            background: #333;
            cursor: not-allowed;
        }

        /* Gallery Button */
        .gallery-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 107, 53, 0.1);
            border: 1px solid rgba(255, 107, 53, 0.3);
            border-radius: 8px;
            color: #ff6b35;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            margin-left: auto;
            margin-right: 20px;
        }

        .gallery-btn:hover {
            background: rgba(255, 107, 53, 0.2);
            border-color: #ff6b35;
        }

        /* Gallery Modal */
        .gallery-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(10px);
        }

        .gallery-header {
            padding: 30px;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .gallery-header h2 {
            margin: 0;
            font-size: 24px;
            color: #ff6b35;
        }

        .gallery-filters {
            display: flex;
            gap: 10px;
        }

        .filter-btn {
            padding: 8px 16px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 6px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .filter-btn.active {
            background: rgba(255, 107, 53, 0.1);
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .gallery-close {
            margin-left: auto;
            background: none;
            border: none;
            font-size: 32px;
            color: #888;
            cursor: pointer;
            transition: color 0.2s;
        }

        .gallery-close:hover {
            color: #ff6b35;
        }

        .gallery-grid {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            align-content: start;
        }

        .gallery-item {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .gallery-item.broken {
            border-color: #ef4444;
            opacity: 0.6;
        }

        .gallery-item.broken::after {
            content: '⚠️ BROKEN';
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }

        .gallery-item:hover {
            border-color: #ff6b35;
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(255, 107, 53, 0.3);
        }

        .repair-btn {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
            z-index: 10;
        }

        .repair-btn:hover {
            background: #dc2626;
        }

        .social-actions {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(10px);
