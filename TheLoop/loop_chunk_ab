        }

        .provider-desc {
            font-size: 11px;
            color: #888;
        }

        .provider-status {
            margin-top: 8px;
            font-size: 10px;
            color: #4ade80;
        }

        .provider-status.offline {
            color: #ef4444;
        }

        .startup-continue {
            margin-top: 25px;
            padding: 14px 40px;
            background: #ff6b35;
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            opacity: 0;
        }

        .startup-continue.visible {
            opacity: 1;
        }

        .startup-continue:hover {
            background: #ff8555;
            transform: scale(1.05);
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .message {
            display: flex;
            gap: 12px;
            max-width: 90%;
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message.user {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .message.ember {
            align-self: flex-start;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .message.user .avatar {
            background: #1e40af;
        }

        .message.ember .avatar {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
        }

        .message-content {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 20px 24px;
            border: 1px solid #2a2a2a;
            line-height: 1.8;
            font-size: 15px;
            letter-spacing: 0.01em;
        }
        
        .message-content p {
            margin: 1em 0;
        }
        
        .message-content ul, .message-content ol {
            margin: 1em 0;
            padding-left: 2em;
        }
        
        .message-content li {
            margin: 0.5em 0;
        }
        
        .message-content strong {
            color: #ff6b35;
            font-weight: 600;
        }
        
        .message-content code {
            background: #0a0a0a;
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'SF Mono', Consolas, monospace;
            font-size: 0.9em;
        }

        .message.user .message-content {
            background: #1e40af;
            border-color: #1e40af;
        }

        .code-block, .html-preview, .image-output {
            background: #0d0d0d;
            border: 1px solid #333;
            border-radius: 8px;
            margin-top: 12px;
            overflow: hidden;
        }

        .code-header, .preview-header {
            padding: 8px 12px;
            background: #1a1a1a;
            border-bottom: 1px solid #333;
            font-size: 12px;
            color: #888;
            display: flex;
            align-items: center;
            gap: 8px;
