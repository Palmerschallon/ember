        .gallery-header h2 {
            margin: 0;
            font-size: 24px;
            color: #ff6b35;
        }

        .gallery-filters {
            display: flex;
            gap: 10px;
        }

        .filter-btn {
            padding: 8px 16px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 6px;
            color: #888;
