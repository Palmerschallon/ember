                if (data.content) {
                    // Show file in a modal or new window
                    alert(`File: ${filename}\n\n${data.content}`);
                } else if (data.error) {
                    alert(`Error: ${data.error}`);
                }
            } catch (error) {
                alert(`Failed to view file: ${error.message}`);
            }
        }

