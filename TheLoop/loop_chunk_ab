        /* Gallery Button */
        .gallery-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 107, 53, 0.1);
            border: 1px solid rgba(255, 107, 53, 0.3);
            border-radius: 8px;
            color: #ff6b35;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            margin-left: auto;
            margin-right: 20px;
        }

        .gallery-btn:hover {
            background: rgba(255, 107, 53, 0.2);
            border-color: #ff6b35;
        }

        /* Gallery Modal */
        .gallery-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(10px);
        }

        .gallery-header {
            padding: 30px;
            border-bottom: 1px solid #333;
