        #send-btn {
            background: #ff6b35;
            border: none;
            border-radius: 12px;
            padding: 14px 24px;
            color: white;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        #send-btn:hover {
            background: #ff5520;
        }

        #send-btn:disabled {
            background: #333;
            cursor: not-allowed;
