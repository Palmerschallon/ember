        .social-btn.liked {
            border-color: #ef4444;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }

        .social-count {
            font-weight: 600;
        }

        .gallery-item-preview {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: #0a0a0a;
        }

        .gallery-item-info {
