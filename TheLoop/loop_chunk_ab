            background: #0a0a0a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            font-family: 'Courier New', monospace;
        }

        #startup-screen.hidden {
            display: none;
        }

        .startup-logo {
            font-size: 64px;
            margin-bottom: 20px;
            animation: glow 2s ease-in-out infinite;
        }

        @keyframes glow {
            0%, 100% { text-shadow: 0 0 20px #ff6b35, 0 0 40px #ff6b35; }
            50% { text-shadow: 0 0 40px #ff6b35, 0 0 80px #ff6b35; }
        }

        .startup-title {
            font-size: 32px;
            color: #ff6b35;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .startup-log {
            background: #111;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 20px;
            width: 600px;
            max-height: 300px;
            overflow-y: auto;
            margin-top: 20px;
        }

        .startup-log-line {
