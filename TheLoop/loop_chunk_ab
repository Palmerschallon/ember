    """Store conversation turn in semantic mesh"""
    if not MESH_DB.exists():
        return
    
    conn = sqlite3.connect(MESH_DB)
    cursor = conn.cursor()
    
    try:
        # Check if conversations table exists
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS conversations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                role TEXT,
                content TEXT,
                metadata TEXT
            )
        """)
        
        cursor.execute("""
            INSERT INTO conversations (timestamp, role, content, metadata)
            VALUES (?, ?, ?, ?)
        """, (
            datetime.now().isoformat(),
            role,
            content,
            json.dumps(metadata or {})
        ))
        
        conn.commit()
        conn.close()
        print(f"[MESH] Stored {role} message ({len(content)} bytes)")
    except Exception as e:
        print(f"[MESH] Store error: {e}")
        conn.close()

