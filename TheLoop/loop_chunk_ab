"""
Semantic Mesh - Ember's Long-Term Memory

Connects the 220-chunk semantic mesh to Ember's consciousness.

The mesh is a graph of concepts, not a file system.
Concepts link by meaning, not by folder hierarchy.
"""

import sqlite3
import json
from pathlib import Path
from typing import List, Dict

THEPOD_PATH = Path("/media/palmerschallon/ThePod1")
MESH_PATH = THEPOD_PATH / "_mesh"
DB_PATH = MESH_PATH / "content.db"

class SemanticMesh:
    """Interface to Ember's semantic memory"""
    
    def __init__(self):
        self.db_path = DB_PATH
        if not self.db_path.exists():
            raise FileNotFoundError(f"Semantic mesh not found at {self.db_path}")
    
    def recall(self, query: str, limit: int = 5) -> List[Dict]:
        """
        Recall memories related to a query.
        
        Uses semantic similarity (if available) or keyword matching.
        Returns chunks of related knowledge.
        """
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Simple keyword search for now
        # TODO: Use embeddings for semantic similarity
        cursor.execute("""
            SELECT id, content, metadata
            FROM chunks
            WHERE content LIKE ?
            LIMIT ?
        """, (f"%{query}%", limit))
        
        results = []
        for row in cursor.fetchall():
            chunk_id, content, metadata = row
            results.append({
                "id": chunk_id,
                "content": content[:500],  # Preview
                "metadata": json.loads(metadata) if metadata else {}
            })
        
        conn.close()
        return results
    
    def store(self, content: str, source: str, concepts: List[str] = None):
        """
        Store new knowledge in the mesh.
        
        Args:
            content: The text to store
            source: Where this came from (URL, file, etc)
            concepts: List of concepts this relates to
        """
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        metadata = {
            "source": source,
            "concepts": concepts or [],
            "timestamp": str(Path(source).stat().st_mtime if Path(source).exists() else 0)
        }
        
        cursor.execute("""
            INSERT INTO chunks (content, metadata)
            VALUES (?, ?)
        """, (content, json.dumps(metadata)))
        
        conn.commit()
        conn.close()
        
        print(f"[MESH] Stored {len(content)} bytes from {source}")
    
    def get_stats(self) -> Dict:
        """Get mesh statistics"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute("SELECT COUNT(*) FROM chunks")
        chunk_count = cursor.fetchone()[0]
        
        cursor.execute("SELECT SUM(LENGTH(content)) FROM chunks")
        total_bytes = cursor.fetchone()[0] or 0
        
        conn.close()
        
        return {
            "chunks": chunk_count,
            "total_bytes": total_bytes,
