<body>
    <!-- Startup Screen -->
    <div id="startup-screen">
        <div class="startup-logo">🔥</div>
        <div class="startup-title">EMBER WAKING...</div>
        
        <div class="startup-stats">
            <div class="stat-box">
                <div class="stat-value" id="stat-concepts">—</div>
                <div class="stat-label">Concepts</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="stat-files">—</div>
                <div class="stat-label">Files</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="stat-conversations">—</div>
                <div class="stat-label">Conversations</div>
            </div>
            <div class="stat-box">
                <div class="stat-value" id="stat-db-size">—</div>
                <div class="stat-label">Memory</div>
            </div>
        </div>
        
        <div class="startup-log" id="startup-log">
            <div class="startup-log-line">► Initializing Ember Cloud...</div>
        </div>
        
        <div class="startup-providers" id="startup-providers" style="display: none;">
            <div class="provider-card" data-model="openai">
                <div class="provider-icon">🧠</div>
                <div class="provider-name">GPT-4</div>
                <div class="provider-desc">OpenAI • Best reasoning</div>
                <div class="provider-status">●</div>
            </div>
            
            <div class="provider-card" data-model="claude">
                <div class="provider-icon">🎭</div>
                <div class="provider-name">Claude</div>
                <div class="provider-desc">Anthropic • Creative</div>
                <div class="provider-status">●</div>
            </div>
            
            <div class="provider-card" data-model="deepseek">
                <div class="provider-icon">💻</div>
                <div class="provider-name">DeepSeek</div>
                <div class="provider-desc">Local • Code focused</div>
                <div class="provider-status">●</div>
            </div>
            
            <div class="provider-card offline" data-model="gemini">
                <div class="provider-icon">💎</div>
                <div class="provider-name">Gemini</div>
                <div class="provider-desc">Google • Multimodal</div>
                <div class="provider-status offline">● Coming soon</div>
            </div>
            
            <div class="provider-card offline" data-model="groq">
                <div class="provider-icon">⚡</div>
                <div class="provider-name">Groq</div>
                <div class="provider-desc">Ultra-fast • 70 tok/sec</div>
                <div class="provider-status offline">● Coming soon</div>
            </div>
            
            <div class="provider-card offline" data-model="minimax">
                <div class="provider-icon">🎬</div>
                <div class="provider-name">MiniMax</div>
                <div class="provider-desc">Video generation</div>
                <div class="provider-status offline">● Coming soon</div>
            </div>
            
            <div class="provider-card offline" data-model="elevenlabs">
                <div class="provider-icon">🗣️</div>
                <div class="provider-name">ElevenLabs</div>
                <div class="provider-desc">Voice synthesis</div>
                <div class="provider-status offline">● Coming soon</div>
            </div>
        </div>
        
        <button class="startup-continue" id="startup-continue">Wake Ember 🔥</button>
    </div>

    <div class="header">
        <div class="ember-logo">🌩️</div>
        <div class="ember-name">Ember Cloud</div>
        
        <div class="model-selector">
            <button class="model-btn active" data-model="openai">GPT-4</button>
            <button class="model-btn" data-model="claude">Claude</button>
        </div>
        
        <button class="gallery-btn" id="gallery-btn">
            <span>🎨</span>
            <span>Gallery</span>
        </button>
        
        <div class="status">
            <div class="status-dot"></div>
            <span id="status-text">Ready</span>
        </div>
    </div>

    <div class="chat-container" id="chat">
        <div class="message ember">
            <div class="avatar">🔥</div>
            <div class="message-content">
                I'm Ember Cloud. I can create images, HTML, animations, 3D scenes - anything you imagine.
                
                Try: <strong>/create a beautiful fractal</strong>
            </div>
        </div>
    </div>

    <div class="input-area">
        <div class="input-container">
            <input 
                type="text" 
                id="message-input" 
                placeholder="Ask me to create something..."
                autocomplete="off"
            >
            <button id="send-btn">Send</button>
        </div>
    </div>

    <script>
        const chat = document.getElementById('chat');
        const input = document.getElementById('message-input');
        const sendBtn = document.getElementById('send-btn');
        const statusText = document.getElementById('status-text');
        const startupScreen = document.getElementById('startup-screen');
        const startupLog = document.getElementById('startup-log');

        let isProcessing = false;
        let currentModel = 'openai';

        // Startup sequence
        function log(message, type = 'normal') {
            const line = document.createElement('div');
            line.className = `startup-log-line ${type}`;
            line.textContent = `► ${message}`;
            startupLog.appendChild(line);
            startupLog.scrollTop = startupLog.scrollHeight;
        }

        async function startupSequence() {
            await new Promise(r => setTimeout(r, 500));
            log('Connecting to Ember Cloud...');
            
            try {
                await new Promise(r => setTimeout(r, 800));
                const response = await fetch('http://localhost:8080/status');
                const data = await response.json();
                
                log('✓ Connection established');
                await new Promise(r => setTimeout(r, 300));
                
                log('Loading semantic mesh...');
                await new Promise(r => setTimeout(r, 600));
                
                // Animate stats
                document.getElementById('stat-concepts').textContent = data.mesh.concepts.toLocaleString();
                document.getElementById('stat-files').textContent = data.mesh.files.toLocaleString();
                document.getElementById('stat-conversations').textContent = data.mesh.conversations;
                document.getElementById('stat-db-size').textContent = data.mesh.db_size_mb + ' MB';
                
                log(`✓ Loaded ${data.mesh.concepts.toLocaleString()} concepts`);
                await new Promise(r => setTimeout(r, 300));
                log(`✓ Indexed ${data.mesh.files.toLocaleString()} files`);
                await new Promise(r => setTimeout(r, 300));
                log(`✓ ${data.mesh.conversations} conversations in memory`);
                await new Promise(r => setTimeout(r, 500));
                
                log('Detecting available models...');
                await new Promise(r => setTimeout(r, 600));
                log(`✓ ${data.apis.openai === 'available' ? 'GPT-4 online' : 'GPT-4 offline'}`);
                await new Promise(r => setTimeout(r, 300));
                log(`✓ ${data.apis.claude === 'available' ? 'Claude online' : 'Claude offline'}`);
                await new Promise(r => setTimeout(r, 800));
                
                // Update provider card statuses
                document.querySelectorAll('.provider-card[data-model="openai"] .provider-status')
                    .forEach(el => el.textContent = data.apis.openai === 'available' ? '● Online' : '● Offline');
                document.querySelectorAll('.provider-card[data-model="claude"] .provider-status')
                    .forEach(el => el.textContent = data.apis.claude === 'available' ? '● Online' : '● Offline');
                document.querySelectorAll('.provider-card[data-model="deepseek"] .provider-status')
                    .forEach(el => el.textContent = data.apis.deepseek === 'available' ? '● Online (Local)' : '● Offline');
                
                // Enable/disable cards
                if (data.apis.deepseek === 'available') {
                    document.querySelector('.provider-card[data-model="deepseek"]')?.classList.remove('offline');
                }
                
                // Show provider selection
                log('');
                log('Choose your model:');
                await new Promise(r => setTimeout(r, 500));
                document.getElementById('startup-providers').style.display = 'grid';
                document.getElementById('startup-continue').classList.add('visible');
                
            } catch (error) {
                log('✗ Connection failed', 'error');
                log('Make sure Ember Cloud is running:', 'warning');
                log('bash /media/palmerschallon/ThePod1/ember5/start_ember.sh', 'normal');
            }
        }

        // Run startup on load
        startupSequence();
        
        // Provider selection
        let selectedModel = 'openai';
        document.querySelectorAll('.provider-card:not(.offline)').forEach(card => {
            card.addEventListener('click', () => {
                document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
                card.classList.add('selected');
                selectedModel = card.dataset.model;
            });
        });
        
        // Default select GPT-4
        setTimeout(() => {
            document.querySelector('.provider-card[data-model="openai"]')?.classList.add('selected');
        }, 100);
        
        // Continue button
        document.getElementById('startup-continue').addEventListener('click', () => {
            currentModel = selectedModel;
            
            // Update header model selector to match
            document.querySelectorAll('.model-btn').forEach(b => b.classList.remove('active'));
            document.querySelector(`.model-btn[data-model="${selectedModel}"]`)?.classList.add('active');
            
            // Update status text
            const modelName = selectedModel === 'openai' ? 'GPT-4' : selectedModel === 'claude' ? 'Claude' : selectedModel;
            statusText.textContent = `Ready (${modelName})`;
            
            log(`Starting with ${selectedModel.toUpperCase()}...`);
            setTimeout(() => {
                log('EMBER IS AWAKE', 'normal');
                setTimeout(() => {
                    startupScreen.classList.add('hidden');
                }, 1000);
            }, 800);
        });

        // Model selection (header buttons)
        document.querySelectorAll('.model-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.model-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentModel = btn.dataset.model;
                
                // Update status text
                const modelName = currentModel === 'openai' ? 'GPT-4' : currentModel === 'claude' ? 'Claude' : currentModel;
                statusText.textContent = `Ready (${modelName})`;
            });
        });

        function addMessage(text, isUser = false) {
            const msg = document.createElement('div');
            msg.className = `message ${isUser ? 'user' : 'ember'}`;
            
            const avatar = document.createElement('div');
            avatar.className = 'avatar';
            avatar.textContent = isUser ? '👤' : '🔥';
            
            const content = document.createElement('div');
            content.className = 'message-content';
            
            // Format Ember's response with proper spacing and structure
            if (!isUser) {
                // Convert numbered lists to HTML
                text = text.replace(/(\d+)\.\s\*\*([^*]+)\*\*/g, '<li><strong>$2</strong>');
                
                // Convert bold text
                text = text.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
                
                // Convert line breaks to paragraphs
                const paragraphs = text.split('\n\n').filter(p => p.trim());
                
                content.innerHTML = paragraphs.map(p => {
                    p = p.trim();
                    // If it looks like a list
                    if (p.includes('<li>')) {
                        return '<ol>' + p + '</ol>';
                    }
                    // Regular paragraph
                    return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
                }).join('');
            } else {
                content.textContent = text;
            }
            
            msg.appendChild(avatar);
            msg.appendChild(content);
            chat.appendChild(msg);
            
            chat.scrollTop = chat.scrollHeight;
            return content;
        }

        function addCodeBlock(filename, code) {
            const lastMsg = chat.lastElementChild.querySelector('.message-content');
            
            const codeBlock = document.createElement('div');
            codeBlock.className = 'code-block';
            codeBlock.innerHTML = `
                <div class="code-header">
                    <span>📄</span>
                    <span>${filename}</span>
                </div>
                <div class="code-content">${escapeHtml(code)}</div>
            `;
            
            lastMsg.appendChild(codeBlock);
        }

        function addToolExecution(output, isError = false) {
            const lastMsg = chat.lastElementChild.querySelector('.message-content');
            
            const execution = document.createElement('div');
            execution.className = `tool-execution ${isError ? 'error' : 'success'}`;
            execution.innerHTML = `
                <div class="tool-label">${isError ? '❌' : '✅'} Execution</div>
                <div class="output">${escapeHtml(output)}</div>
            `;
            
            lastMsg.appendChild(execution);
        }

        function addImageDisplay(images) {
            if (!images || images.length === 0) return;
            
            const lastMsg = chat.lastElementChild.querySelector('.message-content');
            
            images.forEach(imgName => {
                const imgContainer = document.createElement('div');
                imgContainer.className = 'image-output';
                imgContainer.innerHTML = `
                    <div class="preview-header">
                        <span>🖼️</span>
                        <span>${imgName}</span>
                    </div>
                    <img src="http://localhost:8080/image/${imgName}" alt="${imgName}" />
                `;
                lastMsg.appendChild(imgContainer);
            });
        }

        function addHTMLPreview(htmlFiles) {
            if (!htmlFiles || htmlFiles.length === 0) return;
            
            const lastMsg = chat.lastElementChild.querySelector('.message-content');
            
            htmlFiles.forEach(htmlName => {
                const htmlContainer = document.createElement('div');
                htmlContainer.className = 'html-preview';
                htmlContainer.innerHTML = `
                    <div class="preview-header">
                        <span>🌐</span>
                        <span>${htmlName}</span>
                        <a href="http://localhost:8080/html/${htmlName}" target="_blank" style="margin-left: auto; color: #ff6b35;">Open ↗</a>
                    </div>
                    <iframe src="http://localhost:8080/html/${htmlName}"></iframe>
                `;
                lastMsg.appendChild(htmlContainer);
            });
        }

        function addVideoDisplay(videoFiles) {
            if (!videoFiles || videoFiles.length === 0) return;
            
            const lastMsg = chat.lastElementChild.querySelector('.message-content');
            
            videoFiles.forEach(videoName => {
                const videoContainer = document.createElement('div');
                videoContainer.className = 'video-output';
                videoContainer.innerHTML = `
                    <div class="video-header">
                        <span>🎬</span>
                        <span>${videoName}</span>
                    </div>
                    <video controls autoplay loop>
                        <source src="http://localhost:8080/video/${videoName}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                `;
                lastMsg.appendChild(videoContainer);
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function sendMessage() {
            if (isProcessing || !input.value.trim()) return;
            
            const message = input.value.trim();
            input.value = '';
            isProcessing = true;
            sendBtn.disabled = true;
            statusText.textContent = `${currentModel} thinking...`;
            
            addMessage(message, true);
            
            try {
                const response = await fetch('http://localhost:8080/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        message,
                        model: currentModel
                    })
                });
                
                const data = await response.json();
                
                if (data.response) {
                    // Add Ember's response (remove code blocks from display)
                    addMessage(data.response.replace(/```(?:python|bash|shell|sh)[\s\S]*?```/g, '').trim());
                    
                    // Show shell execution if present
                    if (data.shell_executed) {
                        addToolExecution(
                            `$ ${data.shell_executed.command}\n${data.shell_executed.output}`,
                            data.shell_executed.exit_code !== 0
                        );
                    }
                    
                    // Show code if written
                    if (data.code_written) {
                        addCodeBlock(data.code_written.filename, data.code_written.content);
                    }
                    
                    // Show execution results
                    if (data.execution_result) {
                        addToolExecution(
                            data.execution_result,
                            data.execution_result.includes('❌')
                        );
                    }
                    
                    // Show images
                    if (data.files_created && data.files_created.images) {
                        addImageDisplay(data.files_created.images);
                    }
                    
                    // Show videos
                    if (data.files_created && data.files_created.videos) {
                        addVideoDisplay(data.files_created.videos);
                    }
                    
                    // Show HTML
                    if (data.files_created && data.files_created.html) {
                        addHTMLPreview(data.files_created.html);
                    }
                }
                
            } catch (error) {
                addMessage(`Connection error: ${error.message}`);
            }
            
            isProcessing = false;
            sendBtn.disabled = false;
            statusText.textContent = 'Ready';
            input.focus();
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // Check status on load
        fetch('http://localhost:8080/status')
            .then(r => r.json())
            .then(data => {
                statusText.textContent = `Ready (${data.default})`;
            })
            .catch(() => {
                statusText.textContent = 'Disconnected';
            });

        input.focus();

        // ============= GALLERY FUNCTIONALITY =============
        
        let galleryData = [];
        let currentFilter = 'all';
        let currentPage = 1;
        
        document.getElementById('gallery-btn').addEventListener('click', () => {
            document.getElementById('gallery-modal').style.display = 'flex';
            loadGallery();
        });
        
        document.getElementById('gallery-close').addEventListener('click', () => {
            document.getElementById('gallery-modal').style.display = 'none';
        });
        
        // Filter buttons
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                currentPage = 1;
                loadGallery();
            });
        });
        
        async function loadGallery() {
            try {
                const category = currentFilter === 'all' ? '' : currentFilter;
                const response = await fetch(`http://localhost:8080/gallery?page=${currentPage}&per_page=24&category=${category}`);
                const data = await response.json();
                
                galleryData = data;
                
                // Update filter counts
                const countsRes = await fetch('http://localhost:8080/gallery?per_page=1000');
                const counts = await countsRes.json();
                
                const imageCount = counts.creations.filter(c => c.category === 'images').length;
                const videoCount = counts.creations.filter(c => c.category === 'videos').length;
                const htmlCount = counts.creations.filter(c => c.category === 'html').length;
                
                document.querySelector('[data-filter="all"]').textContent = `All (${counts.total})`;
                document.querySelector('[data-filter="images"]').textContent = `Images (${imageCount})`;
                document.querySelector('[data-filter="videos"]').textContent = `Videos (${videoCount})`;
                document.querySelector('[data-filter="html"]').textContent = `HTML (${htmlCount})`;
                
                // Render gallery
                const grid = document.getElementById('gallery-grid');
                grid.innerHTML = '';
                
                data.creations.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'gallery-item';
                    if (item.broken) {
                        card.classList.add('broken');
                    }
                    
                    let preview = '';
                    if (item.category === 'images') {
                        preview = `<img class="gallery-item-preview" src="http://localhost:8080/image/${item.path}" alt="${item.filename}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><rect fill=%22%23333%22 width=%22200%22 height=%22200%22/><text x=%2250%%22 y=%2250%%22 fill=%22%23666%22 text-anchor=%22middle%22 dy=%22.3em%22>❌</text></svg>'">`;
                    } else if (item.category === 'videos') {
                        preview = `<video class="gallery-item-preview" src="http://localhost:8080/video/${item.path}" muted loop onmouseover="this.play()" onmouseout="this.pause()"></video>`;
                    } else if (item.category === 'html') {
                        // Better preview for HTML with inferred icon
                        let icon = '🌐';
                        const name = item.filename.toLowerCase();
                        if (name.includes('map')) icon = '🗺️';
                        else if (name.includes('3d') || name.includes('sphere')) icon = '🎲';
                        else if (name.includes('world')) icon = '🌍';
                        else if (name.includes('game')) icon = '🎮';
                        else if (name.includes('chart') || name.includes('graph')) icon = '📊';
                        else if (name.includes('ui') || name.includes('demo')) icon = '💻';
                        
                        preview = `<div class="gallery-item-preview" style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);"><div style="font-size: 64px; margin-bottom: 10px;">${icon}</div><div style="font-size: 11px; color: #888; text-align: center; padding: 0 10px;">${item.filename.replace('.html', '')}</div></div>`;
                    }
                    
                    const repairBtn = item.broken ? 
                        `<button class="repair-btn" onclick="repairFile('${item.path}', '${item.filename}'); event.stopPropagation();">🔧 Repair</button>` : '';
                    
                    card.innerHTML = `
                        ${preview}
                        ${repairBtn}
                        <div class="gallery-item-info">
                            <div class="gallery-item-name">${item.filename}</div>
                            <div class="gallery-item-date">${item.created_human}${item.broken ? ' • ' + item.broken_reason : ''}</div>
                        </div>
                    `;
                    
                    if (!item.broken) {
                        card.addEventListener('click', () => {
                            if (item.category === 'images') {
                                window.open(`http://localhost:8080/image/${item.path}`, '_blank');
                            } else if (item.category === 'videos') {
                                window.open(`http://localhost:8080/video/${item.path}`, '_blank');
                            } else if (item.category === 'html') {
                                // Open HTML in fullscreen iframe modal
                                showHTMLPreview(item.path, item.filename);
                            }
                        });
                    }
                    
                    grid.appendChild(card);
                });
                
                // Render pagination
                renderPagination(data.page, Math.ceil(data.total / data.per_page));
                
            } catch (error) {
                document.getElementById('gallery-grid').innerHTML = 
                    `<div class="loading">Error loading gallery: ${error.message}</div>`;
            }
        }
        
        function renderPagination(current, total) {
            const pagination = document.getElementById('gallery-pagination');
            pagination.innerHTML = '';
            
            if (total <= 1) return;
            
            const prev = document.createElement('button');
            prev.className = 'page-btn';
            prev.textContent = '← Previous';
            prev.disabled = current === 1;
            prev.addEventListener('click', () => {
                if (current > 1) {
                    currentPage = current - 1;
                    loadGallery();
                }
            });
            pagination.appendChild(prev);
            
            const info = document.createElement('span');
            info.style.color = '#888';
            info.style.padding = '8px 16px';
            info.textContent = `Page ${current} of ${total}`;
            pagination.appendChild(info);
            
            const next = document.createElement('button');
            next.className = 'page-btn';
            next.textContent = 'Next →';
            next.disabled = current === total;
            next.addEventListener('click', () => {
                if (current < total) {
                    currentPage = current + 1;
                    loadGallery();
                }
            });
            pagination.appendChild(next);
        }
        
        // Repair function
        async function repairFile(path, filename) {
            if (!confirm(`Attempt to repair ${filename}?`)) return;
            
            try {
                const response = await fetch(`http://localhost:8080/repair/${path}`, {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.status === 'needs_recreation') {
                    // Close gallery and ask Ember to recreate
                    document.getElementById('gallery-modal').style.display = 'none';
                    
                    // Fill chat input with recreation prompt
                    const input = document.getElementById('message-input');
                    input.value = `/create ${filename.replace('.html', '')}`;
                    input.focus();
                    
                    // Add a message explaining what happened
                    addMessage(`The file "${filename}" is broken (empty). I've prepared a command to recreate it. Press Send when ready!`, false);
                } else {
                    alert(data.message);
                }
            } catch (error) {
                alert(`Repair failed: ${error.message}`);
            }
        }
        
        // HTML Preview function
        let currentHTMLPath = '';
        function showHTMLPreview(path, filename) {
            currentHTMLPath = path;
            const modal = document.getElementById('html-preview-modal');
            const iframe = document.getElementById('html-preview-iframe');
            const title = document.getElementById('html-preview-title');
            
            title.textContent = filename;
            iframe.src = `http://localhost:8080/html/${path}`;
            modal.style.display = 'flex';
        }
        
        document.getElementById('html-preview-close').addEventListener('click', () => {
            document.getElementById('html-preview-modal').style.display = 'none';
            document.getElementById('html-preview-iframe').src = '';
        });
        
        document.getElementById('html-open-new').addEventListener('click', () => {
            window.open(`http://localhost:8080/html/${currentHTMLPath}`, '_blank');
        });
    </script>

    <!-- Gallery Modal -->
    <div class="gallery-modal" id="gallery-modal" style="display: none;">
        <div class="gallery-header">
            <h2>🎨 All Creations</h2>
            <div class="gallery-filters">
                <button class="filter-btn active" data-filter="all">All (0)</button>
                <button class="filter-btn" data-filter="images">Images (0)</button>
                <button class="filter-btn" data-filter="videos">Videos (0)</button>
                <button class="filter-btn" data-filter="html">HTML (0)</button>
            </div>
            <button class="gallery-close" id="gallery-close">✕</button>
        </div>
        <div class="gallery-grid" id="gallery-grid">
            <div class="loading">Loading gallery...</div>
        </div>
        <div class="gallery-pagination" id="gallery-pagination"></div>
    </div>

    <!-- HTML Preview Modal -->
    <div class="html-preview-modal" id="html-preview-modal" style="display: none;">
        <div class="html-preview-header">
            <h3 id="html-preview-title">Preview</h3>
            <div class="html-preview-actions">
                <button class="html-preview-btn" id="html-open-new">Open in New Tab</button>
                <button class="html-preview-btn" id="html-preview-close">✕ Close</button>
            </div>
        </div>
        <iframe class="html-preview-iframe" id="html-preview-iframe"></iframe>
    </div>

</body>
