    conn = sqlite3.connect(MESH_DB)
    cursor = conn.cursor()
    
    stats = {}
    
    try:
        cursor.execute("SELECT COUNT(*) FROM files")
        stats["files"] = cursor.fetchone()[0]
    except:
        stats["files"] = 0
    
    try:
        cursor.execute("SELECT COUNT(*) FROM concepts")
        stats["concepts"] = cursor.fetchone()[0]
    except:
        stats["concepts"] = 0
    
    try:
