            if result.stderr:
                output += f"STDERR:\n{result.stderr}\n"
            if result.returncode != 0:
                output += f"❌ Exit code: {result.returncode}"
            else:
                output += f"✅ Success (exit code 0)"
            
            return output
        except subprocess.TimeoutExpired:
            return "❌ Timeout (30s limit)"
