        .html-preview iframe {
            width: 100%;
            height: 500px;
            border: none;
            background: white;
        }

        .image-output img {
            width: 100%;
            max-width: 600px;
            height: auto;
            display: block;
        }

        .video-output {
            margin-top: 12px;
            background: #111;
            border-radius: 8px;
