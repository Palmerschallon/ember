                        <button class="code-btn" onclick="viewFile('${escapeHtml(filename)}')">View File</button>
                    </div>
                </div>
                <div class="code-content" id="${codeId}">${escapeHtml(code)}</div>
            `;
            
            lastMsg.appendChild(codeBlock);
        }
        
