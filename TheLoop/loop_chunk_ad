    for pattern, category in [
        ("*.png", "images"), ("*.jpg", "images"), ("*.gif", "images"), 
        ("*.svg", "images"), ("*.jpeg", "images"),
        ("*.html", "html"), ("*.htm", "html"),
        ("*.mp4", "videos"), ("*.webm", "videos"), ("*.mov", "videos")
    ]:
        for file_path in glob.glob(str(THEPOD_PATH / pattern)):
