    try:
        cursor.execute("SELECT COUNT(*) FROM conversations")
        stats["conversations"] = cursor.fetchone()[0]
    except:
        stats["conversations"] = 0
    
    stats["db_size_mb"] = MESH_DB.stat().st_size / (1024*1024)
    
    conn.close()
    return stats

