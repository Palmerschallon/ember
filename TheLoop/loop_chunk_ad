                    "name": item.name,
                    "is_dir": item.is_dir(),
                    "size": item.stat().st_size if item.is_file() else 0
                })
        
        return jsonify({"files": files[:100]})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

