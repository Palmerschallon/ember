        });
        const desk = new THREE.Mesh(new THREE.BoxGeometry(3, 0.1, 1.5), deskMaterial);
        desk.position.set(0, 0.9, -3);
        desk.castShadow = true;
        desk.receiveShadow = true;
        interiorGroup.add(desk);

        // 7 Floating screens
        for (let i = 0; i < 7; i++) {
            const screen = new THREE.Mesh(
                new THREE.BoxGeometry(0.8, 0.6, 0.05),
                new THREE.MeshStandardMaterial({
                    color: 0x0a0a0a,
                    emissive: 0x00ff00,
                    emissiveIntensity: 0.3
                })
            );
            const angle = (i / 7) * Math.PI - Math.PI / 2;
            const radius = 2;
            screen.position.set(
                Math.cos(angle) * radius,
                1.5 + Math.sin(i * 0.5) * 0.3,
                -3 + Math.sin(angle) * radius
            );
            screen.lookAt(0, 1.5, -3);
            screen.castShadow = true;
