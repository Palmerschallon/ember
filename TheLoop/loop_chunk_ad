        cursor.execute("""
            CREATE TABLE IF NOT EXISTS conversations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                role TEXT,
                content TEXT,
                metadata TEXT
            )
        """)
        
        cursor.execute("""
            INSERT INTO conversations (timestamp, role, content, metadata)
            VALUES (?, ?, ?, ?)
        """, (
            datetime.now().isoformat(),
            role,
            content,
            json.dumps(metadata or {})
        ))
        
        conn.commit()
