                    WHEN file_name LIKE '%.png' OR file_name LIKE '%.jpg' THEN 'image'
                    ELSE 'other'
                END as file_type,
                COUNT(*) as count
            FROM files
            GROUP BY file_type
            ORDER BY count DESC
        """)
        file_types = dict(cursor.fetchall())
        
        conn.close()
        
        return jsonify({
            "primary_mode": primary_mode,
            "categories": categories,
            "top_concepts": top_concepts,
            "file_types": file_types,
            "ui_suggestions": {
