                "data": ["dataframe_viewer", "chart_builder", "stats_panel", "query_builder"],
                "creative": ["inspiration_board", "palette", "music_player", "animation_timeline"]
            }[primary_mode]
        })
        
    except Exception as e:
        return jsonify({"error": str(e)}), 500

