        existing = cursor.fetchone()
        
        if existing:
            # Unlike
            cursor.execute("DELETE FROM likes WHERE creation_id = ?", (creation_id,))
            cursor.execute("UPDATE creations SET like_count = like_count - 1 WHERE id = ?", (creation_id,))
            liked = False
        else:
