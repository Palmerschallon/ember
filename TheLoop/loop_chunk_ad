        function updateHandVelocity(hand, handedness) {
            const wrist = hand.joints['wrist'];
            if (!wrist || !wrist.visible) {
                handPositionsSet[handedness] = false;
                return new THREE.Vector3();
            }

            const currentPos = wrist.getWorldPosition(new THREE.Vector3());
            
            if (!handPositionsSet[handedness]) {
                handPrevPositions[handedness].copy(currentPos);
                handPositionsSet[handedness] = true;
                return new THREE.Vector3();
            }

            const velocity = new THREE.Vector3().subVectors(
                handPrevPositions[handedness],
                currentPos
            );
            
            handPrevPositions[handedness].copy(currentPos);
            return velocity;
        }

        // Movement
        const keys = {};
