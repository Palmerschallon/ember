@tool
def read_file(path: str) -> str:
    """Read a file from the filesystem. Input should be the full file path."""
    try:
        file_path = Path(path)
        if not file_path.exists():
            return f"❌ File not found: {path}"
        
        content = file_path.read_text()
        return f"✅ Read {len(content)} chars from {path}\n\n{content[:3000]}"
    except Exception as e:
        return f"❌ Error reading file: {e}"

@tool
def write_file(args: str) -> str:
    """Write content to a file. Input format: 'path=/path/to/file|||content=file content here'"""
    try:
        parts = args.split("|||")
        path = parts[0].replace("path=", "").strip()
        content = parts[1].replace("content=", "").strip()
        
        file_path = Path(path)
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_text(content)
        return f"✅ Wrote {len(content)} chars to {path}"
    except Exception as e:
        return f"❌ Error writing file: {e}"

@tool
def execute_python(code: str) -> str:
    """Execute Python code and return output. Input should be valid Python code."""
    import subprocess
    import tempfile
    
    try:
        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
            f.write(code)
            temp_path = f.name
        
        result = subprocess.run(
            ["python3", temp_path],
            capture_output=True,
            text=True,
            timeout=30,
            cwd=str(THEPOD_PATH)
        )
        
        os.unlink(temp_path)
        
        output = result.stdout + result.stderr
