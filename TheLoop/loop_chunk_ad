def execute_python(code, filename):
    """Execute Python code and capture output"""
    file_path = THEPOD_PATH / filename
    file_path.write_text(code)
    
    try:
        result = subprocess.run(
            ["python3", str(file_path)],
            cwd=THEPOD_PATH,
            capture_output=True,
            text=True,
            timeout=120
        )
        
        output = ""
        if result.stdout:
