            "result": edit_own_file(file_to_edit, old_text, new_text)
        }
    
    # Check for bash/shell commands first
    bash_match = re.search(r'```(?:bash|shell|sh)\s*(.*?)\s*```', response_text, re.DOTALL)
    if bash_match:
        bash_code = bash_match.group(1).strip()
