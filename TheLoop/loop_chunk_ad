            const wheelGeometry = new THREE.CylinderGeometry(0.3, 0.3, 0.2, 8);
            wheelGeometry.rotateZ(Math.PI / 2);
            
            [-1, 1].forEach(x => {
                [-1.2, 1.2].forEach(z => {
                    const wheel = new THREE.Mesh(wheelGeometry, wheelMaterial);
                    wheel.position.set(x * 1.1, 0.3, z);
                    wheel.castShadow = true;
                    carGroup.add(wheel);
                });
            });
            
            carGroup.position.set(
                (Math.random() - 0.5) * 80,
                0.3,
                (Math.random() - 0.5) * 80
            );
            carGroup.rotation.y = Math.random() * Math.PI * 2;
            carGroup.userData.speed = 0.05 + Math.random() * 0.05;
            carGroup.userData.direction = Math.random() > 0.5 ? 1 : -1;
            
            scene.add(carGroup);
            cars.push(carGroup);
        }

        // NPCs (walking pedestrians)
        const npcMaterial = new THREE.MeshStandardMaterial({ roughness: 0.7 });
        const npcs = [];
        
        for (let i = 0; i < 20; i++) {
            const npcGroup = new THREE.Group();
            
            // Body
            const body = new THREE.Mesh(
                new THREE.CylinderGeometry(0.3, 0.3, 1.2, 8),
                npcMaterial.clone()
            );
            body.material.color.setHSL(Math.random(), 0.5, 0.4);
            body.position.y = 0.6;
            body.castShadow = true;
            npcGroup.add(body);
            
            // Head
            const head = new THREE.Mesh(
                new THREE.SphereGeometry(0.25, 8, 8),
                new THREE.MeshStandardMaterial({ color: 0xffdbac })
            );
            head.position.y = 1.5;
            head.castShadow = true;
            npcGroup.add(head);
            
            npcGroup.position.set(
                (Math.random() - 0.5) * 70,
                0,
                (Math.random() - 0.5) * 70
            );
            npcGroup.userData.speed = 0.01 + Math.random() * 0.02;
            npcGroup.userData.direction = Math.random() * Math.PI * 2;
            
            scene.add(npcGroup);
            npcs.push(npcGroup);
        }

        // Interior scene (hidden initially)
        const interiorGroup = new THREE.Group();
        interiorGroup.visible = false;
        scene.add(interiorGroup);

        // Interior walls
        const wallMaterial = new THREE.MeshStandardMaterial({
            color: 0x4a4a5e,
            roughness: 0.9
        });

        const backWall = new THREE.Mesh(new THREE.BoxGeometry(14, 10, 0.2), wallMaterial);
        backWall.position.set(0, 5, -10);
        backWall.receiveShadow = true;
        interiorGroup.add(backWall);

        const leftWall = new THREE.Mesh(new THREE.BoxGeometry(0.2, 10, 19), wallMaterial);
        leftWall.position.set(-7, 5, -0.5);
        leftWall.receiveShadow = true;
        interiorGroup.add(leftWall);

        const rightWall = new THREE.Mesh(new THREE.BoxGeometry(0.2, 10, 19), wallMaterial);
        rightWall.position.set(7, 5, -0.5);
        rightWall.receiveShadow = true;
        interiorGroup.add(rightWall);

        // Interior floor
        const interiorFloor = new THREE.Mesh(
            new THREE.PlaneGeometry(14, 19),
            new THREE.MeshStandardMaterial({ color: 0x2a2a3e, roughness: 0.4 })
        );
        interiorFloor.rotation.x = -Math.PI / 2;
        interiorFloor.receiveShadow = true;
        interiorGroup.add(interiorFloor);

        // Desk
        const deskMaterial = new THREE.MeshStandardMaterial({
            color: 0x5a3a2a,
            roughness: 0.3
        });
        const desk = new THREE.Mesh(new THREE.BoxGeometry(3, 0.1, 1.5), deskMaterial);
        desk.position.set(0, 0.9, -3);
        desk.castShadow = true;
        desk.receiveShadow = true;
        interiorGroup.add(desk);

        // 7 Floating screens
        for (let i = 0; i < 7; i++) {
            const screen = new THREE.Mesh(
                new THREE.BoxGeometry(0.8, 0.6, 0.05),
                new THREE.MeshStandardMaterial({
                    color: 0x0a0a0a,
                    emissive: 0x00ff00,
                    emissiveIntensity: 0.3
                })
            );
            const angle = (i / 7) * Math.PI - Math.PI / 2;
            const radius = 2;
            screen.position.set(
                Math.cos(angle) * radius,
                1.5 + Math.sin(i * 0.5) * 0.3,
                -3 + Math.sin(angle) * radius
            );
            screen.lookAt(0, 1.5, -3);
            screen.castShadow = true;
            interiorGroup.add(screen);
        }

        // Interior light
        const interiorLight = new THREE.PointLight(0xffffff, 1, 20);
        interiorLight.position.set(0, 8, -5);
        interiorLight.castShadow = true;
        interiorGroup.add(interiorLight);

        // Exit door (inside)
        const exitDoor = new THREE.Mesh(
            new THREE.BoxGeometry(3, 4, 0.2),
            doorMaterial
        );
        exitDoor.position.set(0, 2, 9);
        exitDoor.userData.isExitDoor = true;
        interiorGroup.add(exitDoor);

        // Game state
        let isInterior = false;
        let nearDoor = null;

        // Hand Tracking for VR
        const handModelFactory = new XRHandModelFactory();
        
        const hand1 = renderer.xr.getHand(0);
        hand1.add(handModelFactory.createHandModel(hand1, 'mesh'));
        scene.add(hand1);
        
        const hand2 = renderer.xr.getHand(1);
        hand2.add(handModelFactory.createHandModel(hand2, 'mesh'));
        scene.add(hand2);

        // Swimming locomotion tracking
        let leftHandPrevPos = new THREE.Vector3();
        let rightHandPrevPos = new THREE.Vector3();
        let leftHandInitialized = false;
        let rightHandInitialized = false;
        const swimMultiplier = 3.0;

        function getHandPosition(hand) {
            const wrist = hand.joints['wrist'];
            return wrist ? wrist.position.clone() : null;
        }

        // Movement
        const keys = {};
        const moveSpeed = 0.15;
        const gravity = -0.02;
        let velocityY = 0;

        window.addEventListener('keydown', (e) => {
            keys[e.key.toLowerCase()] = true;
            if (['w','a','s','d',' ','e'].includes(e.key.toLowerCase())) e.preventDefault();
            
            // E to interact
            if (e.key.toLowerCase() === 'e' && nearDoor) {
                if (nearDoor.userData.isDoor && !isInterior) {
                    enterBuilding();
                } else if (nearDoor.userData.isExitDoor && isInterior) {
                    exitBuilding();
                }
            }
        });

        window.addEventListener('keyup', (e) => {
            keys[e.key.toLowerCase()] = false;
        });

        // Mouse look
        let mx = 0, my = 0, locked = false;
        renderer.domElement.addEventListener('click', () => {
            if (!locked) renderer.domElement.requestPointerLock();
        });
        document.addEventListener('pointerlockchange', () => {
            locked = document.pointerLockElement === renderer.domElement;
        });
        document.addEventListener('mousemove', (e) => {
            if (locked) {
                mx += e.movementX * 0.002;
                my -= e.movementY * 0.002;
                my = Math.max(-Math.PI/2, Math.min(Math.PI/2, my));
            }
        });

        // Collision detection
        const raycaster = new THREE.Raycaster();
        const directionVectors = [
            new THREE.Vector3(1, 0, 0),
            new THREE.Vector3(-1, 0, 0),
            new THREE.Vector3(0, 0, 1),
            new THREE.Vector3(0, 0, -1)
        ];

        function checkCollision(position) {
            for (const dir of directionVectors) {
                raycaster.set(position, dir);
                const intersects = raycaster.intersectObjects(buildings);
                if (intersects.length > 0 && intersects[0].distance < 0.5) {
                    return true;
                }
            }
            return false;
        }

        // Enter/exit functions
        function enterBuilding() {
            isInterior = true;
            interiorGroup.visible = true;
            
            // Hide exterior
            buildings.forEach(b => b.visible = false);
            door.visible = false;
            ground.visible = false;
            scene.background = new THREE.Color(0x1a1a2e);
            scene.fog = new THREE.Fog(0x1a1a2e, 10, 30);
            
            // Move camera inside
            camera.position.set(0, 1.7, 5);
            camera.rotation.set(0, 0, 0);
            mx = 0;
            my = 0;
            
            document.getElementById('state').innerHTML = '🏢 Interior - Your Warehouse';
            document.getElementById('prompt').style.display = 'none';
        }

        function exitBuilding() {
            isInterior = false;
            interiorGroup.visible = false;
            
            // Show exterior
            buildings.forEach(b => b.visible = true);
            door.visible = true;
            ground.visible = true;
            scene.background = new THREE.Color(0x87ceeb);
            scene.fog = new THREE.Fog(0x87ceeb, 50, 200);
            
            // Move camera outside
            camera.position.set(0, 1.7, 0);
            camera.rotation.set(0, 0, 0);
            mx = 0;
            my = 0;
            
            document.getElementById('state').innerHTML = '🌆 Exterior - Arts District';
        }

        // Animation loop
        function animate() {
            // Animate cars
            cars.forEach(car => {
                car.position.z += car.userData.speed * car.userData.direction;
                if (Math.abs(car.position.z) > 100) {
                    car.userData.direction *= -1;
                    car.rotation.y += Math.PI;
                }
            });

            // Animate NPCs
            npcs.forEach(npc => {
                const dir = npc.userData.direction;
                npc.position.x += Math.cos(dir) * npc.userData.speed;
                npc.position.z += Math.sin(dir) * npc.userData.speed;
                
                // Random direction changes
                if (Math.random() < 0.01) {
                    npc.userData.direction += (Math.random() - 0.5) * 0.5;
                }
                
                // Keep NPCs in bounds
                if (Math.abs(npc.position.x) > 80 || Math.abs(npc.position.z) > 80) {
                    npc.userData.direction += Math.PI;
                }
                
                npc.rotation.y = dir;
            });

            // VR swimming locomotion (hand movement)
            if (renderer.xr.isPresenting && !isInterior) {
                const leftPos = getHandPosition(hand1);
                const rightPos = getHandPosition(hand2);
                
                if (leftPos) {
                    if (!leftHandInitialized) {
                        leftHandPrevPos.copy(leftPos);
                        leftHandInitialized = true;
                    } else {
                        const delta = new THREE.Vector3().subVectors(leftPos, leftHandPrevPos);
                        
                        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                        forward.y = 0;
                        forward.normalize();
                        const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                        right.y = 0;
                        right.normalize();
                        
                        const newPos = camera.position.clone();
                        newPos.addScaledVector(forward, -delta.z * swimMultiplier);
                        newPos.addScaledVector(right, -delta.x * swimMultiplier);
                        newPos.y += -delta.y * swimMultiplier;
                        
                        if (!checkCollision(newPos)) {
                            camera.position.copy(newPos);
                        }
                        
                        leftHandPrevPos.copy(leftPos);
                    }
                } else {
                    leftHandInitialized = false;
                }
                
                if (rightPos) {
                    if (!rightHandInitialized) {
                        rightHandPrevPos.copy(rightPos);
                        rightHandInitialized = true;
                    } else {
                        const delta = new THREE.Vector3().subVectors(rightPos, rightHandPrevPos);
                        
                        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                        forward.y = 0;
                        forward.normalize();
                        const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                        right.y = 0;
                        right.normalize();
                        
                        const newPos = camera.position.clone();
                        newPos.addScaledVector(forward, -delta.z * swimMultiplier);
                        newPos.addScaledVector(right, -delta.x * swimMultiplier);
                        newPos.y += -delta.y * swimMultiplier;
                        
                        if (!checkCollision(newPos)) {
                            camera.position.copy(newPos);
                        }
                        
                        rightHandPrevPos.copy(rightPos);
                    }
                } else {
                    rightHandInitialized = false;
                }
            }
            
            // VR controller movement (thumbsticks)
            if (renderer.xr.isPresenting) {
                const session = renderer.xr.getSession();
                if (session) {
                    for (const source of session.inputSources) {
                        if (source.gamepad && source.gamepad.axes && source.gamepad.axes.length >= 4) {
                            const axes = source.gamepad.axes;
                            
                            const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                            forward.y = 0;
                            forward.normalize();
                            const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                            right.y = 0;
                            right.normalize();
                            
                            const x = axes[2] || 0;
                            const z = axes[3] || 0;
                            
                            if (Math.abs(x) > 0.1 || Math.abs(z) > 0.1) {
                                const newPos = camera.position.clone();
                                newPos.addScaledVector(right, x * moveSpeed);
                                newPos.addScaledVector(forward, -z * moveSpeed);
                                
                                // Apply movement with collision check
                                if (!isInterior && !checkCollision(newPos)) {
                                    camera.position.copy(newPos);
                                } else if (isInterior) {
                                    camera.position.x = Math.max(-6.5, Math.min(6.5, newPos.x));
                                    camera.position.z = Math.max(-9.5, Math.min(8.5, newPos.z));
                                }
                            }
                            
                            // A/X buttons for interaction
                            if (source.gamepad.buttons[4] && source.gamepad.buttons[4].pressed && nearDoor) {
                                if (nearDoor.userData.isDoor && !isInterior) {
                                    enterBuilding();
                                } else if (nearDoor.userData.isExitDoor && isInterior) {
                                    exitBuilding();
                                }
                            }
                        }
                    }
                }
            }
            
            // Desktop movement
            if (!renderer.xr.isPresenting) {
                const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                forward.y = 0;
                forward.normalize();
                const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                right.y = 0;
                right.normalize();

                const newPos = camera.position.clone();
            
                if (keys['w']) newPos.addScaledVector(forward, moveSpeed);
                if (keys['s']) newPos.addScaledVector(forward, -moveSpeed);
                if (keys['a']) newPos.addScaledVector(right, -moveSpeed);
                if (keys['d']) newPos.addScaledVector(right, moveSpeed);

                // Collision check (only in exterior)
                if (!isInterior && !checkCollision(newPos)) {
                    camera.position.copy(newPos);
                } else if (isInterior) {
                    // Simple bounds check for interior
                    camera.position.x = Math.max(-6.5, Math.min(6.5, newPos.x));
                    camera.position.z = Math.max(-9.5, Math.min(8.5, newPos.z));
                }

                // Gravity & jump (exterior only)
                if (!isInterior) {
                    if (keys[' '] && camera.position.y <= 1.71) {
                        velocityY = 0.2;
                    }
                    velocityY += gravity;
                    camera.position.y += velocityY;
                    
                    if (camera.position.y < 1.7) {
                        camera.position.y = 1.7;
                        velocityY = 0;
                    }
                }

                // Camera rotation
                camera.rotation.order = 'YXZ';
                camera.rotation.y = mx;
                camera.rotation.x = my;
            }

            // Check for nearby doors
            nearDoor = null;
            const doorToCheck = isInterior ? exitDoor : door;
            const distToDoor = camera.position.distanceTo(doorToCheck.position);
            
            if (distToDoor < 5) {
                nearDoor = doorToCheck;
                document.getElementById('prompt').style.display = 'block';
                document.getElementById('prompt').innerHTML = isInterior ? 
                    'Press E to exit to city' : 
                    'Press E to enter your warehouse';
            } else {
                document.getElementById('prompt').style.display = 'none';
            }

            renderer.render(scene, camera);
        }

        renderer.setAnimationLoop(animate);

        // Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        console.log('🏙️ GTA 7 - Seamless Interiors Loaded');
        console.log('Walk up to YOUR warehouse and press E!');
    </script>
