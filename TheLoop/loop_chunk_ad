@app.route('/collaborate', methods=['POST'])
def collaborate():
    """Multi-agent collaboration endpoint"""
    user_msg = request.json['message']
    agents = request.json.get('agents', ['gpt4', 'claude'])
    max_rounds = request.json.get('max_rounds', 5)
    
    # Shared conversation history
    messages = [
        {"role": "system", "content": get_collaboration_prompt()},
        {"role": "user", "content": user_msg}
    ]
    
    conversation = []
    
    for round in range(max_rounds):
        for agent in agents:
            # Agent sees full conversation so far
            response = call_agent(agent, messages)
            
            # Add agent's response to shared history
            messages.append({
                "role": "assistant",
                "content": f"[{agent.upper()}]: {response}",
                "name": agent
            })
            
            conversation.append({
                "agent": agent,
                "round": round,
                "content": response
            })
            
            # Check if task is complete
            if is_task_complete(response):
                return jsonify({
                    "conversation": conversation,
                    "rounds": round + 1
                })
    
    return jsonify({"conversation": conversation, "rounds": max_rounds})
