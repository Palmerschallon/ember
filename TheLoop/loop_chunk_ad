                            forward.y = 0;
                            forward.normalize();
                            const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                            right.y = 0;
                            right.normalize();
                            
                            const x = axes[2] || 0;
                            const z = axes[3] || 0;
                            
                            if (Math.abs(x) > 0.1 || Math.abs(z) > 0.1) {
                                const newPos = camera.position.clone();
                                newPos.addScaledVector(right, x * moveSpeed);
                                newPos.addScaledVector(forward, -z * moveSpeed);
                                
                                // Apply movement with collision check
                                if (!isInterior && !checkCollision(newPos)) {
