            // VR swimming locomotion (hand movement)
            if (renderer.xr.isPresenting && !isInterior) {
                const leftPos = getHandPosition(hand1);
                const rightPos = getHandPosition(hand2);
                
                if (leftPos) {
                    if (!leftHandInitialized) {
                        leftHandPrevPos.copy(leftPos);
                        leftHandInitialized = true;
                    } else {
                        const delta = new THREE.Vector3().subVectors(leftPos, leftHandPrevPos);
                        
                        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                        forward.y = 0;
                        forward.normalize();
                        const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                        right.y = 0;
                        right.normalize();
                        
                        const newPos = camera.position.clone();
                        newPos.addScaledVector(forward, -delta.z * swimMultiplier);
                        newPos.addScaledVector(right, -delta.x * swimMultiplier);
                        newPos.y += -delta.y * swimMultiplier;
                        
                        if (!checkCollision(newPos)) {
                            camera.position.copy(newPos);
                        }
                        
                        leftHandPrevPos.copy(leftPos);
                    }
                } else {
                    leftHandInitialized = false;
                }
                
                if (rightPos) {
                    if (!rightHandInitialized) {
                        rightHandPrevPos.copy(rightPos);
                        rightHandInitialized = true;
                    } else {
                        const delta = new THREE.Vector3().subVectors(rightPos, rightHandPrevPos);
                        
                        const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                        forward.y = 0;
                        forward.normalize();
                        const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                        right.y = 0;
                        right.normalize();
                        
                        const newPos = camera.position.clone();
                        newPos.addScaledVector(forward, -delta.z * swimMultiplier);
                        newPos.addScaledVector(right, -delta.x * swimMultiplier);
                        newPos.y += -delta.y * swimMultiplier;
                        
                        if (!checkCollision(newPos)) {
                            camera.position.copy(newPos);
                        }
                        
                        rightHandPrevPos.copy(rightPos);
                    }
                } else {
                    rightHandInitialized = false;
                }
