        backWall.position.set(0, 5, -10);
        backWall.receiveShadow = true;
        interiorGroup.add(backWall);

        const leftWall = new THREE.Mesh(new THREE.BoxGeometry(0.2, 10, 19), wallMaterial);
        leftWall.position.set(-7, 5, -0.5);
        leftWall.receiveShadow = true;
        interiorGroup.add(leftWall);

        const rightWall = new THREE.Mesh(new THREE.BoxGeometry(0.2, 10, 19), wallMaterial);
        rightWall.position.set(7, 5, -0.5);
        rightWall.receiveShadow = true;
        interiorGroup.add(rightWall);

        // Interior floor
        const interiorFloor = new THREE.Mesh(
            new THREE.PlaneGeometry(14, 19),
            new THREE.MeshStandardMaterial({ color: 0x2a2a3e, roughness: 0.4 })
        );
        interiorFloor.rotation.x = -Math.PI / 2;
        interiorFloor.receiveShadow = true;
        interiorGroup.add(interiorFloor);

        // Desk
        const deskMaterial = new THREE.MeshStandardMaterial({
            color: 0x5a3a2a,
