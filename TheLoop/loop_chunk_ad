```python
def call_agent_with_variation(model, prompt, variation):
    # Add variation to prompt
    varied_prompt = f"{prompt}\n\n[Variation {variation}: Try a unique approach]"
    
    # Or vary temperature
    temperature = 0.7 + (variation * 0.05)  # 0.7 to 1.15
    
    return call_model(model, varied_prompt, temperature=temperature)
```

### **2. Voting**
```python
def vote_on_best(solutions):
    # Simple: most common
    return Counter(solutions).most_common(1)[0][0]
    
    # Advanced: use another LLM to judge
    judge_prompt = f"Which solution is best?\n\n" + "\n\n".join([
        f"Solution {i}: {s}" for i, s in enumerate(solutions)
    ])
    return judge_model(judge_prompt)
```

