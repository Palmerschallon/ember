                            // A/X buttons for interaction
                            if (source.gamepad.buttons[4] && source.gamepad.buttons[4].pressed && nearDoor) {
                                if (nearDoor.userData.isDoor && !isInterior) {
                                    enterBuilding();
                                } else if (nearDoor.userData.isExitDoor && isInterior) {
                                    exitBuilding();
                                }
                            }
                        }
                    }
                }
            }
            
            // Desktop movement
