                                    enterBuilding();
                                } else if (nearDoor.userData.isExitDoor && isInterior) {
                                    exitBuilding();
                                }
                            }
                        }
                    }
                }
            }
            
            // Desktop movement
            if (!renderer.xr.isPresenting) {
                const forward = new THREE.Vector3(0, 0, -1).applyQuaternion(camera.quaternion);
                forward.y = 0;
                forward.normalize();
                const right = new THREE.Vector3(1, 0, 0).applyQuaternion(camera.quaternion);
                right.y = 0;
                right.normalize();

                const newPos = camera.position.clone();
            
                if (keys['w']) newPos.addScaledVector(forward, moveSpeed);
                if (keys['s']) newPos.addScaledVector(forward, -moveSpeed);
                if (keys['a']) newPos.addScaledVector(right, -moveSpeed);
                if (keys['d']) newPos.addScaledVector(right, moveSpeed);

                // Collision check (only in exterior)
                if (!isInterior && !checkCollision(newPos)) {
                    camera.position.copy(newPos);
                } else if (isInterior) {
                    // Simple bounds check for interior
                    camera.position.x = Math.max(-6.5, Math.min(6.5, newPos.x));
                    camera.position.z = Math.max(-9.5, Math.min(8.5, newPos.z));
                }

                // Gravity & jump (exterior only)
                if (!isInterior) {
                    if (keys[' '] && camera.position.y <= 1.71) {
                        velocityY = 0.2;
                    }
                    velocityY += gravity;
                    camera.position.y += velocityY;
                    
                    if (camera.position.y < 1.7) {
                        camera.position.y = 1.7;
                        velocityY = 0;
                    }
                }

                // Camera rotation
                camera.rotation.order = 'YXZ';
                camera.rotation.y = mx;
                camera.rotation.x = my;
            }

            // Check for nearby doors
            nearDoor = null;
            const doorToCheck = isInterior ? exitDoor : door;
            const distToDoor = camera.position.distanceTo(doorToCheck.position);
            
            if (distToDoor < 5) {
                nearDoor = doorToCheck;
                document.getElementById('prompt').style.display = 'block';
                document.getElementById('prompt').innerHTML = isInterior ? 
                    'Press E to exit to city' : 
                    'Press E to enter your warehouse';
            } else {
                document.getElementById('prompt').style.display = 'none';
            }

            renderer.render(scene, camera);
        }

        renderer.setAnimationLoop(animate);

        // Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        console.log('🏙️ GTA 7 - Seamless Interiors Loaded');
        console.log('Walk up to YOUR warehouse and press E!');
    </script>
