                    car.userData.direction *= -1;
                    car.rotation.y += Math.PI;
                }
            });

            // Animate NPCs
            npcs.forEach(npc => {
                const dir = npc.userData.direction;
                npc.position.x += Math.cos(dir) * npc.userData.speed;
                npc.position.z += Math.sin(dir) * npc.userData.speed;
                
                // Random direction changes
                if (Math.random() < 0.01) {
                    npc.userData.direction += (Math.random() - 0.5) * 0.5;
                }
                
                // Keep NPCs in bounds
                if (Math.abs(npc.position.x) > 80 || Math.abs(npc.position.z) > 80) {
                    npc.userData.direction += Math.PI;
                }
                
                npc.rotation.y = dir;
