def generate_thumbnail_with_firefox(html_path, output_path, width=400, height=300):
    """Use Firefox headless to capture screenshot"""
    try:
        # Use firefox --screenshot command (requires Firefox 57+)
        url = f"file://{html_path.absolute()}"
        temp_screenshot = output_path.parent / f"temp_{output_path.name}"
        
        cmd = [
            "firefox",
            "--headless",
            "--screenshot", str(temp_screenshot),
            "--window-size", f"{width*2},{height*2}",
            url
        ]
        
        result = subprocess.run(cmd, capture_output=True, timeout=10)
        
        if temp_screenshot.exists():
            # Resize to thumbnail size
            img = Image.open(temp_screenshot)
            img.thumbnail((width, height), Image.Resampling.LANCZOS)
            img.save(output_path, "PNG", optimize=True)
            temp_screenshot.unlink()  # Clean up
            return True
        return False
        
    except Exception as e:
        print(f"  ❌ Failed: {e}")
        return False

def generate_placeholder_thumbnail(output_path, width=400, height=300):
