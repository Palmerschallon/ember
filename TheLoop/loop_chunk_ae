                            if file_read and file_read['result']:
                                response += f"\n\n📄 File Content:\n```\n{file_read['result'][:2000]}\n```"
                except Exception as e:
                    print(f"[TOOL] Failed to parse read() call: {e}")
        else:
            # Regular Python code - execute it
