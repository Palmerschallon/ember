            import hashlib
            filename = f"creation_{hashlib.md5(code.encode()).hexdigest()[:8]}.py"
            
            print(f"[CLOUD] Generated code for: {user_msg[:50]}")
            print(f"[LOCAL] Executing {filename}")
            
            code_written = {
