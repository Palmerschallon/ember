                        ctx.strokeStyle = `hsla(${(p.hue + p2.hue) / 2}, 100%, ${brightness}%, ${alpha})`;
                        ctx.lineWidth = 0.5 + p.activity;
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p2.x, p2.y);
                        ctx.stroke();
                    }
                }
            });
            
            requestAnimationFrame(animate);
        }
        
