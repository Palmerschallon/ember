            <div class="status-dot"></div>
            <span id="status-text">Ready</span>
        </div>
    </div>

    <!-- 💬 CONVERSATION SIDEBAR - ChatGPT Style -->
    <div class="conversation-sidebar" id="conversation-sidebar">
        <div class="sidebar-header">
            <button class="new-chat-btn" id="new-chat-btn">+ New Chat</button>
        </div>
        <div class="conversation-list" id="conversation-list">
            <div class="loading-conversations">Loading conversations...</div>
        </div>
    </div>

    <div class="chat-container" id="chat">
        <div class="message ember">
            <div class="avatar">🔥</div>
            <div class="message-content">
                I'm Ember Cloud. I can create images, HTML, animations, 3D scenes - anything you imagine.
                
                Try: <strong>/create a beautiful fractal</strong>
            </div>
        </div>
        
        <!-- 🔥 THINKING INDICATOR - Generative art while you wait! -->
        <div class="thinking-indicator" id="thinking-indicator">
            <canvas id="thinking-canvas" width="600" height="120"></canvas>
            <div class="thinking-text" id="thinking-text">Ember is thinking...</div>
            <div class="thinking-model" id="thinking-model"></div>
        </div>
