            if all_memories:
                print(f"[MESH] Total: {len(all_memories)} memories found")
                mesh_context = "\n\n" + "="*60 + "\n"
                mesh_context += "SEMANTIC MESH RECALL - USE THIS INFORMATION\n"
                mesh_context += "="*60 + "\n"
                seen = set()
