def vr_world(filename):
    """Serve VR worlds"""
    paths = [
        THEPOD / "ember6" / "_archive" / "ember5" / filename,
        THEPOD / "ember6" / "voice" / filename,
        THEPOD / filename
    ]
    
    for path in paths:
        if path.exists():
            return send_file(str(path))
    
    return "VR world not found", 404

