                const particle = new THREE.Mesh(geometry, material);
                
                const angle = (i / 150) * Math.PI * 2;
                particle.position.x = 25 + Math.cos(angle) * 8;
                particle.position.y = Math.sin(angle) * 8;
                particle.position.z = (Math.random() - 0.5) * 5;
                
                particle.userData.baseX = particle.position.x;
                particle.userData.baseY = particle.position.y;
                particle.userData.offset = i * 0.05;
                
                scene.add(particle);
                parentBParticles.push(particle);
            }

            window.addEventListener('resize', onWindowResize);
