            flex-direction: column;
        }

        .html-preview-header {
            padding: 15px 30px;
            background: #1a1a1a;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .html-preview-header h3 {
            margin: 0;
            color: #ff6b35;
            font-size: 16px;
        }

        .html-preview-actions {
            display: flex;
            gap: 10px;
        }

        .html-preview-btn {
            padding: 8px 16px;
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .html-preview-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .html-preview-iframe {
            flex: 1;
            border: none;
            background: white;
        }
        
        /* 3D Model Viewer Modal */
        .model-viewer-modal {
            position: fixed;
            top: 0;
            left: 0;
