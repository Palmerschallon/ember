// HAND TRACKING with detailed joint access
const handModelFactory = new XRHandModelFactory();
const hand1 = renderer.xr.getHand(0);
const hand2 = renderer.xr.getHand(1);

hand1.add(handModelFactory.createHandModel(hand1, 'mesh'));
hand2.add(handModelFactory.createHandModel(hand2, 'mesh'));

scene.add(hand1, hand2);

let handsTracked = false;
hand1.addEventListener('connected', (event) => {
  handsTracked = true;
  document.getElementById('hands').textContent = '👋 Hands tracked! Use gestures!';
  document.getElementById('hands').style.color = '#8f8';
  console.log('Hand 1 connected:', event.data);
});

hand2.addEventListener('connected', (event) => {
  console.log('Hand 2 connected:', event.data);
});

// Gesture detection functions
function detectFist(hand) {
  const joints = hand.joints;
  if (!joints['index-finger-tip'] || !joints['middle-finger-tip']) return false;
  
  const indexTip = joints['index-finger-tip'];
  const middleTip = joints['middle-finger-tip'];
  const palm = joints['palm'] || joints['wrist'];
  
  if (!indexTip.visible || !middleTip.visible || !palm.visible) return false;
  
  // If fingertips are close to palm = fist
  const indexDist = indexTip.position.distanceTo(palm.position);
  const middleDist = middleTip.position.distanceTo(palm.position);
  
  return (indexDist < 0.06 && middleDist < 0.06);
}

function detectOpenHand(hand) {
  const joints = hand.joints;
  if (!joints['index-finger-tip'] || !joints['middle-finger-tip']) return false;
  
  const indexTip = joints['index-finger-tip'];
  const middleTip = joints['middle-finger-tip'];
  const palm = joints['palm'] || joints['wrist'];
  
  if (!indexTip.visible || !middleTip.visible || !palm.visible) return false;
  
  // If fingertips are far from palm = open
  const indexDist = indexTip.position.distanceTo(palm.position);
  const middleDist = middleTip.position.distanceTo(palm.position);
  
  return (indexDist > 0.08 && middleDist > 0.08);
}

function detectPointing(hand) {
  const joints = hand.joints;
  if (!joints['index-finger-tip'] || !joints['middle-finger-tip']) return null;
  
  const indexTip = joints['index-finger-tip'];
  const middleTip = joints['middle-finger-tip'];
  const palm = joints['palm'] || joints['wrist'];
  
  if (!indexTip.visible || !middleTip.visible || !palm.visible) return null;
  
  // Index extended, middle curled = pointing
  const indexDist = indexTip.position.distanceTo(palm.position);
  const middleDist = middleTip.position.distanceTo(palm.position);
  
  if (indexDist > 0.09 && middleDist < 0.07) {
    // Get pointing direction
    const direction = new THREE.Vector3().subVectors(indexTip.position, palm.position).normalize();
    return direction;
  }
  
  return null;
}

function detectPinch(hand) {
  const joints = hand.joints;
  if (!joints['index-finger-tip'] || !joints['thumb-tip']) return false;
  
  const indexTip = joints['index-finger-tip'];
  const thumbTip = joints['thumb-tip'];
  
  if (!indexTip.visible || !thumbTip.visible) return false;
  
  const distance = indexTip.position.distanceTo(thumbTip.position);
  return distance < 0.02;
}

// Gesture state
let moveSpeed = 0;
let turnSpeed = 0;
let verticalSpeed = 0;

// Sky
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 0.1, 1);

// Lighting
scene.add(new THREE.AmbientLight(0xf0e8d0, 0.6));

const sun = new THREE.DirectionalLight(0xffeedd, 1.2);
sun.position.set(0.5, 1, 0.3);
sun.castShadow = true;
sun.shadow.mapSize.width = 2048;
sun.shadow.mapSize.height = 2048;
scene.add(sun);

const fillLight = new THREE.DirectionalLight(0x88ccff, 0.4);
fillLight.position.set(-0.5, 0.3, -0.5);
scene.add(fillLight);

// GROUND - Sphere terrarium
const sphereRadius = 0.5;
const groundGeo = new THREE.SphereGeometry(sphereRadius, 128, 128, 0, Math.PI * 2, 0, Math.PI / 2);
const groundVerts = groundGeo.attributes.position.array;

for (let i = 0; i < groundVerts.length; i += 3) {
  const x = groundVerts[i];
  const y = groundVerts[i + 1];
  const z = groundVerts[i + 2];
  const dist = Math.sqrt(x * x + y * y + z * z);
  const noise = 
    Math.sin(x * 100) * 0.002 +
    Math.cos(z * 100) * 0.002 +
    Math.random() * 0.0003;
  
  groundVerts[i] *= (1 + noise / dist);
  groundVerts[i + 1] *= (1 + noise / dist);
  groundVerts[i + 2] *= (1 + noise / dist);
}
groundGeo.computeVertexNormals();

const ground = new THREE.Mesh(
  groundGeo,
  new THREE.MeshStandardMaterial({
    color: 0x5a4a3a,
    roughness: 0.85,
    side: THREE.DoubleSide
  })
);
ground.receiveShadow = true;
scene.add(ground);

// Transparent dome
const dome = new THREE.Mesh(
  new THREE.SphereGeometry(sphereRadius * 1.01, 64, 64),
  new THREE.MeshPhysicalMaterial({
    color: 0xffffff,
    transparent: true,
    opacity: 0.05,
    roughness: 0,
    transmission: 0.95,
    side: THREE.BackSide
  })
);
scene.add(dome);

// Helper function for sphere positioning
function positionOnSphere(radius, angle, distance) {
  const x = Math.cos(angle) * distance;
  const z = Math.sin(angle) * distance;
  const y = Math.sqrt(Math.max(0, radius * radius - x * x - z * z));
  const normal = new THREE.Vector3(x, y, z).normalize();
  return { pos: new THREE.Vector3(x, y, z), normal };
}

// GRASS - 800 blades
const grassBlades = [];
for (let i = 0; i < 800; i++) {
  const bladeHeight = 0.008 + Math.random() * 0.025;
  const bladeGeo = new THREE.CylinderGeometry(0.0004, 0.0007, bladeHeight, 4, 6);
  
  const bladeMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color().setHSL(0.28 + Math.random() * 0.12, 0.65, 0.35 + Math.random() * 0.25),
    roughness: 0.75,
    side: THREE.DoubleSide
  });
  
  const blade = new THREE.Mesh(bladeGeo, bladeMat);
  
  const angle = Math.random() * Math.PI * 2;
  const distance = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.85;
  const surface = positionOnSphere(sphereRadius, angle, distance);
  
  blade.position.copy(surface.pos);
  blade.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), surface.normal);
  blade.translateY(bladeHeight / 2);
  blade.castShadow = true;
  
  scene.add(blade);
  grassBlades.push({ mesh: blade, phase: Math.random() * Math.PI * 2 });
}

// WILDFLOWERS - 150 colorful
for (let i = 0; i < 150; i++) {
  const stemHeight = 0.006 + Math.random() * 0.010;
  const angle = Math.random() * Math.PI * 2;
  const distance = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.85;
  const surface = positionOnSphere(sphereRadius, angle, distance);
  
  const flowerColor = new THREE.Color().setHSL(Math.random(), 0.85, 0.55);
  const petalCount = 5 + Math.floor(Math.random() * 3);
  
  for (let p = 0; p < petalCount; p++) {
    const petal = new THREE.Mesh(
      new THREE.SphereGeometry(0.0008, 6, 6),
      new THREE.MeshStandardMaterial({ 
        color: flowerColor,
        emissive: flowerColor,
        emissiveIntensity: 0.4
      })
    );
    
    petal.position.copy(surface.pos);
    petal.quaternion.copy(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), surface.normal));
    petal.translateY(stemHeight);
    
    const petalAngle = (p / petalCount) * Math.PI * 2;
    petal.translateX(Math.cos(petalAngle) * 0.001);
    petal.translateZ(Math.sin(petalAngle) * 0.001);
    
    scene.add(petal);
  }
}

// MUSHROOMS - 25
for (let i = 0; i < 25; i++) {
  const stemHeight = 0.012 + Math.random() * 0.020;
  const capRadius = 0.006 + Math.random() * 0.012;
  
  const angle = Math.random() * Math.PI * 2;
  const distance = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.75;
  const surface = positionOnSphere(sphereRadius, angle, distance);
  
  const stem = new THREE.Mesh(
    new THREE.CylinderGeometry(0.0012, 0.0018, stemHeight, 8),
    new THREE.MeshStandardMaterial({ color: 0xf5f0e8 })
  );
  
  stem.position.copy(surface.pos);
  stem.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), surface.normal);
  stem.translateY(stemHeight / 2);
  stem.castShadow = true;
  
  const cap = new THREE.Mesh(
    new THREE.SphereGeometry(capRadius, 16, 10, 0, Math.PI * 2, 0, Math.PI / 1.8),
    new THREE.MeshStandardMaterial({ 
      color: new THREE.Color().setHSL(Math.random() * 0.15, 0.75, 0.45),
      emissive: new THREE.Color().setHSL(Math.random() * 0.15, 0.5, 0.1),
      emissiveIntensity: 0.2
    })
  );
  
  cap.position.copy(stem.position);
  cap.quaternion.copy(stem.quaternion);
  cap.translateY(stemHeight / 2 + capRadius * 0.3);
  cap.castShadow = true;
  
  scene.add(stem, cap);
}

// Desktop controls
const move = { f: 0, b: 0, l: 0, r: 0, u: 0, d: 0 };
document.addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (k === 'w') move.f = 1;
  if (k === 's') move.b = 1;
  if (k === 'a') move.l = 1;
  if (k === 'd') move.r = 1;
  if (k === ' ') move.u = 1;
  if (k === 'shift') move.d = 1;
});

document.addEventListener('keyup', e => {
  const k = e.key.toLowerCase();
  if (k === 'w') move.f = 0;
  if (k === 's') move.b = 0;
  if (k === 'a') move.l = 0;
  if (k === 'd') move.r = 0;
  if (k === ' ') move.u = 0;
  if (k === 'shift') move.d = 0;
});

let mouseX = 0, mouseY = 0, pointerLocked = false;
document.addEventListener('click', () => {
  if (!renderer.xr.isPresenting) document.body.requestPointerLock();
});
document.addEventListener('pointerlockchange', () => {
  pointerLocked = document.pointerLockElement === document.body;
});
document.addEventListener('mousemove', e => {
  if (pointerLocked) {
    mouseX += e.movementX * 0.002;
    mouseY += e.movementY * 0.002;
    mouseY = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, mouseY));
  }
});

// Animation
const clock = new THREE.Clock();

function animate() {
  const delta = clock.getDelta();
  const time = clock.getElapsedTime();
  
  // Grass swaying
  grassBlades.forEach(blade => {
    blade.mesh.rotation.z = Math.sin(time * 0.5 + blade.phase) * 0.1;
  });
  
  // GESTURE NAVIGATION in VR
  if (renderer.xr.isPresenting && handsTracked) {
    const leftFist = detectFist(hand1);
    const rightFist = detectFist(hand2);
    const leftOpen = detectOpenHand(hand1);
    const rightOpen = detectOpenHand(hand2);
    const leftPoint = detectPointing(hand1);
    const rightPoint = detectPointing(hand2);
    
    // Both fists = move forward
    if (leftFist && rightFist) {
      moveSpeed = 0.01;
    } else if (leftOpen && rightOpen) {
      // Both open = stop/hover
      moveSpeed = 0;
      verticalSpeed = 0;
    } else {
      moveSpeed *= 0.9; // Decay
    }
    
    // Pointing gestures
    if (leftPoint && leftPoint.x < -0.5) {
      turnSpeed = 0.02; // Point left = turn left
    } else if (rightPoint && rightPoint.x > 0.5) {
      turnSpeed = -0.02; // Point right = turn right
    } else {
      turnSpeed *= 0.9;
    }
    
    if (leftPoint && leftPoint.y > 0.6) {
      verticalSpeed = 0.005; // Point up = fly up
    } else if (leftPoint && leftPoint.y < -0.6) {
      verticalSpeed = -0.005; // Point down = fly down
    }
    
    // Apply gesture movement
    const forward = new THREE.Vector3(0, 0, -1);
    forward.applyQuaternion(camera.quaternion);
    camera.position.addScaledVector(forward, moveSpeed);
    camera.position.y += verticalSpeed;
    camera.rotation.y += turnSpeed;
    
    // Keep above ground
    if (camera.position.y < 0.001) camera.position.y = 0.001;
  }
  
  // Desktop movement
  if (!renderer.xr.isPresenting) {
    const speed = playerScale * 5 * delta * 60;
    const forward = new THREE.Vector3(0, 0, -1);
    const right = new THREE.Vector3(1, 0, 0);
    
    forward.applyQuaternion(camera.quaternion);
    right.applyQuaternion(camera.quaternion);
    
    camera.position.addScaledVector(forward, (move.f - move.b) * speed);
    camera.position.addScaledVector(right, (move.r - move.l) * speed);
    camera.position.y += (move.u - move.d) * speed;
    
    if (camera.position.y < playerScale * 0.5) {
      camera.position.y = playerScale * 0.5;
    }
    
    camera.rotation.order = 'YXZ';
    camera.rotation.y = -mouseX;
    camera.rotation.x = -mouseY;
  }
  
  renderer.render(scene, camera);
}

renderer.setAnimationLoop(animate);

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
