            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, 256, 128);
            ctx.fillStyle = '#fff';
            ctx.font = 'bold 40px monospace';
            ctx.textAlign = 'center';
            ctx.fillText(data.name, 128, 70);
            
            const texture = new THREE.CanvasTexture(canvas);
            const labelMat = new THREE.MeshBasicMaterial({ map: texture, transparent: true });
            const labelGeo = new THREE.PlaneGeometry(1.2, 0.6);
            const label = new THREE.Mesh(labelGeo, labelMat);
            label.position.z = 0.01;
            group.add(label);
            
            group.position.set(...data.pos);
            group.lookAt(camera.position);
            scene.add(group);
            windows.push(group);
        });
        
        // Grid floor
        // Grid floor - MASSIVE EXPANSION
        const gridHelper = new THREE.GridHelper(1000, 100, 0x444444, 0x222222); // 1km × 1km grid!
        gridHelper.position.y = 0;
        scene.add(gridHelper);
        
        // Add multiple grid layers for depth perception
        const grid2 = new THREE.GridHelper(500, 50, 0x333333, 0x111111);
        grid2.position.y = -50;
        scene.add(grid2);
        
        const grid3 = new THREE.GridHelper(2000, 100, 0x222222, 0x111111);
        grid3.position.y = -100;
        scene.add(grid3);
        
        // Stars background - FILL THE VOID
