const cityCtx = cityCanvas.getContext('2d');

function drawCityView(time) {
    const hour = (time * 0.0001) % 24;
    const isDaytime = hour > 6 && hour < 18;
    
    // Sky
    const skyTop = isDaytime ? '#4a6fa5' : '#0a0a2a';
    const skyBottom = isDaytime ? '#87ceeb' : '#1a1a3a';
    const skyGrad = cityCtx.createLinearGradient(0, 0, 0, 256);
    skyGrad.addColorStop(0, skyTop);
    skyGrad.addColorStop(1, skyBottom);
    cityCtx.fillStyle = skyGrad;
    cityCtx.fillRect(0, 0, 512, 256);
    
    // Buildings
    for (let i = 0; i < 18; i++) {
        const x = i * 30 - 20;
        const h = 120 + Math.sin(i * 0.6) * 80;
        const buildingColor = isDaytime ? '#2a2a3a' : '#0a0a0a';
        cityCtx.fillStyle = buildingColor;
        cityCtx.fillRect(x, 256 - h, 26, h);
        
        // Windows
        for (let j = 0; j < h / 18; j++) {
            for (let k = 0; k < 2; k++) {
                const lit = Math.random() > (isDaytime ? 0.7 : 0.3);
                if (lit || (Math.sin(time * 0.001 + i + j) > 0.6)) {
                    cityCtx.fillStyle = Math.random() > 0.95 ? '#ff6600' : '#ffff88';
                    cityCtx.fillRect(x + 4 + k * 12, 256 - h + 8 + j * 18, 6, 10);
                }
            }
        }
    }
    
    // Street
    cityCtx.fillStyle = isDaytime ? '#3a3a4a' : '#1a1a2a';
    cityCtx.fillRect(0, 256, 512, 256);
    
    // Cars
    const carX = (time * 0.15) % 612 - 50;
    cityCtx.fillStyle = '#cc0000';
    cityCtx.fillRect(carX, 280, 32, 16);
    cityCtx.fillStyle = '#ffff00';
    cityCtx.fillRect(carX + 2, 284, 4, 4);
    cityCtx.fillRect(carX + 26, 284, 4, 4);
    
    const carX2 = 512 - ((time * 0.12) % 612 - 50);
    cityCtx.fillStyle = '#0044cc';
    cityCtx.fillRect(carX2, 310, 32, 16);
    
    // NPCs
    for (let i = 0; i < 6; i++) {
        const npcX = ((time * 0.06 + i * 85) % 512);
        cityCtx.fillStyle = ['#ffffff', '#ffddaa', '#aaffaa'][i % 3];
        cityCtx.fillRect(npcX, 340 + (i % 2) * 30, 4, 10);
    }
}

