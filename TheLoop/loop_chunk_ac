// 4. Occasional Wind Gusts (random events)
function windGust() {
    const wind = audioCtx.createBufferSource();
    const windBuffer = audioCtx.createBuffer(1, audioCtx.sampleRate * 2, audioCtx.sampleRate);
    const windData = windBuffer.getChannelData(0);
    
    for (let i = 0; i < windData.length; i++) {
        const env = Math.sin((i / windData.length) * Math.PI * 0.5);
        windData[i] = (Math.random() * 2 - 1) * env * 0.3;
    }
    
    wind.buffer = windBuffer;
    const windFilter = audioCtx.createBiquadFilter();
    windFilter.type = 'highpass';
    windFilter.frequency.value = 400;
    const windGain = audioCtx.createGain();
    windGain.gain.value = 0.05;
    
    wind.connect(windFilter).connect(windGain).connect(masterGain);
    wind.start();
}

// Random wind every 10-30 seconds
function scheduleWind() {
    setTimeout(() => {
        windGust();
        scheduleWind();
    }, 10000 + Math.random() * 20000);
}
