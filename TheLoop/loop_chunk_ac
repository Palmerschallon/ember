    if (k === 's') movement.backward = 1;
    if (k === 'a') movement.left = 1;
    if (k === 'd') movement.right = 1;
    if (k === ' ') e.preventDefault();
    
    if (k === 'e') {
        const dist = camera.position.distanceTo(door.position);
        if (dist < 3) toggleDoor();
    }
});

window.addEventListener('keyup', (e) => {
    const k = e.key.toLowerCase();
    if (k === 'w') movement.forward = 0;
    if (k === 's') movement.backward = 0;
    if (k === 'a') movement.left = 0;
    if (k === 'd') movement.right = 0;
});

document.addEventListener('mousemove', (e) => {
    if (!pointerLocked) return;
    yaw -= e.movementX * 0.002;
    pitch -= e.movementY * 0.002;
    pitch = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, pitch));
});

document.addEventListener('click', () => {
    if (document.getElementById('instructions').style.display !== 'none') {
        document.getElementById('instructions').style.display = 'none';
        document.body.requestPointerLock();
    }
});

document.addEventListener('pointerlockchange', () => {
    pointerLocked = document.pointerLockElement === document.body;
});

// ═══════════════════════════════════════════════════════════════
// ANIMATION LOOP
// ═══════════════════════════════════════════════════════════════

const clock = new THREE.Clock();
let frames = 0;
let lastTime = performance.now();

function animate() {
    renderer.setAnimationLoop(animate);
    
    const delta = clock.getDelta();
    const time = performance.now();
    
    // Update procedural audio
    drone.update(time);
    
    // Desktop movement
    if (!renderer.xr.isPresenting) {
        const speed = 2.5 * delta;
        const direction = new THREE.Vector3();
        direction.z = movement.backward - movement.forward;
        direction.x = movement.right - movement.left;
        direction.normalize();
        
        const forward = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(0, yaw, 0));
        const right = new THREE.Vector3(1, 0, 0).applyEuler(new THREE.Euler(0, yaw, 0));
        
        const velocity = forward.multiplyScalar(direction.z).add(right.multiplyScalar(direction.x)).multiplyScalar(speed);
        
        camera.position.add(velocity);
        camera.position.x = Math.max(-4.5, Math.min(4.5, camera.position.x));
        camera.position.z = Math.max(-5.5, Math.min(5.5, camera.position.z));
        camera.position.y = 1.7;
        camera.rotation.set(pitch, yaw, 0);
    } else {
        updateBody();
    }
    
    // Update city window
    drawCityView(time);
    cityTexture.needsUpdate = true;
    
    // Animate particles
    const positions = particleGeo.attributes.position.array;
    for (let i = 0; i < positions.length; i += 3) {
        positions[i] += particleVelocities[i];
        positions[i + 1] += particleVelocities[i + 1];
        positions[i + 2] += particleVelocities[i + 2];
        
        if (positions[i + 1] > 4.5) {
            positions[i + 1] = 0;
            positions[i] = (Math.random() - 0.5) * 9;
            positions[i + 2] = (Math.random() - 0.5) * 11;
        }
        if (Math.abs(positions[i]) > 5) particleVelocities[i] *= -1;
        if (Math.abs(positions[i + 2]) > 6) particleVelocities[i + 2] *= -1;
    }
    particleGeo.attributes.position.needsUpdate = true;
    
    // Door hint
    const distToDoor = camera.position.distanceTo(door.position);
    const hint = document.getElementById('hint');
    if (distToDoor < 3 && !doorOpen) {
        hint.textContent = '🚪 Press E to open door and enter the city';
        hint.style.color = '#ff6600';
    } else if (distToDoor < 2.5) {
        hint.textContent = '🪟 Look right to see the city through the window';
        hint.style.color = '#ffff00';
    } else {
        hint.textContent = '';
    }
    
    // FPS
    frames++;
    const now = performance.now();
    if (now >= lastTime + 1000) {
        document.getElementById('fps').textContent = `FPS: ${frames}`;
        frames = 0;
        lastTime = now;
    }
    
    renderer.render(scene, camera);
}

animate();

window.addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
});
</script>
