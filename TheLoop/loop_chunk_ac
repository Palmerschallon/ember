#!/usr/bin/env python3
"""
Convert warehouse point cloud to web-friendly format
Downsample 6.7M points → 2M points for VR performance
"""

import numpy as np
import struct
from pathlib import Path

def read_pts(filepath, max_points=2_000_000):
    """Read .pts file and downsample"""
    print(f"📖 Reading {filepath}...")
    
    with open(filepath, 'r') as f:
        # First line is count
        total_points = int(f.readline().strip())
        print(f"   Total points in file: {total_points:,}")
        
        # Calculate skip factor
        skip = max(1, total_points // max_points)
        print(f"   Downsampling: keeping every {skip}th point")
        
        # Read points
        points = []
        colors = []
        
        for i, line in enumerate(f):
            if i % skip == 0:
                parts = line.strip().split()
                if len(parts) >= 6:
                    x, y, z = float(parts[0]), float(parts[1]), float(parts[2])
                    r, g, b = int(parts[3]), int(parts[4]), int(parts[5])
                    
                    points.append([x, y, z])
                    colors.append([r, g, b])
            
            if i % 100000 == 0:
                print(f"   Progress: {i:,} / {total_points:,} ({i/total_points*100:.1f}%)")
    
    print(f"✅ Loaded {len(points):,} points")
    return np.array(points, dtype=np.float32), np.array(colors, dtype=np.uint8)

def write_ply(points, colors, output_path):
    """Write binary PLY file"""
    print(f"💾 Writing {output_path}...")
    
    n_points = len(points)
    
    # PLY header
    header = f"""ply
format binary_little_endian 1.0
comment Warehouse point cloud - 2315 E 8th St, Arts District LA
element vertex {n_points}
property float x
property float y
property float z
property uchar red
property uchar green
property uchar blue
end_header
"""
    
    with open(output_path, 'wb') as f:
        # Write header
        f.write(header.encode('ascii'))
        
        # Write points (binary)
        for i in range(n_points):
            # Pack: 3 floats (x,y,z) + 3 unsigned bytes (r,g,b)
            data = struct.pack('fffBBB',
                points[i][0], points[i][1], points[i][2],
                colors[i][0], colors[i][1], colors[i][2]
            )
            f.write(data)
            
            if i % 100000 == 0:
                print(f"   Progress: {i:,} / {n_points:,} ({i/n_points*100:.1f}%)")
    
    file_size = Path(output_path).stat().st_size / (1024**2)
    print(f"✅ Wrote {n_points:,} points ({file_size:.1f} MB)")

def get_stats(points):
    """Get point cloud statistics"""
    mins = np.min(points, axis=0)
    maxs = np.max(points, axis=0)
    center = (mins + maxs) / 2
    size = maxs - mins
    
    return {
        'min': mins,
        'max': maxs,
        'center': center,
        'size': size,
        'bounds': f"{size[0]:.1f}m x {size[1]:.1f}m x {size[2]:.1f}m"
    }

