import * as THREE from 'three';
import { VRButton } from 'three/addons/webxr/VRButton.js';
import { XRHandModelFactory } from 'three/addons/webxr/XRHandModelFactory.js';

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.00001, 1000);
const renderer = new THREE.WebGLRenderer({ antialias: true });

// Start ANT-SIZED (1mm tall camera) - positioned ON THE GROUND looking around
let playerScale = 0.001;
camera.position.set(0, 0.0005, 0); // 0.5mm above ground (ant eye level)
camera.lookAt(0.1, 0.001, 0.1); // Look towards vegetation at ground level

renderer.setSize(window.innerWidth, window.innerHeight);
