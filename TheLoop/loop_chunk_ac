      vNormal=normalize(normalMatrix*normal);
      gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);
    }
  `,
  fragmentShader:`
    varying vec2 vUv;
    varying vec3 vNormal;
    
    float noise(vec2 p){
      return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);
    }
    
    void main(){
      float n1=noise(vUv*50.0);
      float n2=noise(vUv*100.0);
      float n3=noise(vUv*200.0);
      
      vec3 concrete=vec3(0.5+n1*.1+n2*.05+n3*.02);
      
      // Stains
      float stain=smoothstep(.4,.6,noise(vUv*10.0));
      concrete-=stain*.15;
      
      // Lighting
      float light=max(dot(vNormal,normalize(vec3(1,1,1))),.3);
      concrete*=light;
      
      gl_FragColor=vec4(concrete,1.0);
    }
  `
};

