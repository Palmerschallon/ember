function toggleDoor() {
    doorOpen = !doorOpen;
    const targetRot = doorOpen ? -Math.PI / 2.2 : 0;
    const targetX = doorOpen ? -0.5 : 0;
    
    function animateDoor() {
        door.rotation.y += (targetRot - door.rotation.y) * 0.12;
        door.position.x += (targetX - door.position.x) * 0.12;
        handle.rotation.y = door.rotation.y;
        handle.position.x = door.position.x - 0.45;
        
        if (Math.abs(targetRot - door.rotation.y) > 0.01) {
            requestAnimationFrame(animateDoor);
        }
    }
    animateDoor();
    
    if (doorOpen) {
        setTimeout(() => {
            document.getElementById('ui').innerHTML = '<div style="font-size:28px;color:#ff6600;text-align:center;margin-top:180px;">🏙️ EXITING TO GTA 7 CITY...<br><br><div style="font-size:18px;color:#0f0;">The world you built awaits...</div></div>';
