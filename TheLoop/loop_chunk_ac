        // ═══════════════════════════════════════════════════════════════
        // NETWORK GRAPH RENDERING
        // ═══════════════════════════════════════════════════════════════
        
        class RelationshipNetwork {
            constructor(canvas) {
                this.canvas = canvas;
                this.ctx = canvas.getContext('2d');
                this.nodes = [];
                this.edges = [];
                this.resize();
                window.addEventListener('resize', () => this.resize());
            }
            
            resize() {
                const rect = this.canvas.parentElement.getBoundingClientRect();
                this.canvas.width = rect.width;
                this.canvas.height = rect.height - 80; // Stats bar
                this.width = this.canvas.width;
                this.height = this.canvas.height;
            }
            
            update(npcs) {
                // Convert NPCs to nodes
                this.nodes = Object.entries(npcs).map(([id, npc], i) => {
                    const angle = (i / Object.keys(npcs).length) * Math.PI * 2;
                    const radius = Math.min(this.width, this.height) * 0.35;
                    const centerX = this.width / 2;
                    const centerY = this.height / 2;
                    
                    return {
                        id: id,
                        name: npc.name,
                        role: npc.role,
                        x: centerX + Math.cos(angle) * radius,
                        y: centerY + Math.sin(angle) * radius,
                        relationship: npc.relationship || 0,
                        mood: npc.mood || 'neutral'
                    };
                });
                
                // Add player at center
                this.nodes.push({
                    id: 'player',
                    name: 'PLAYER',
                    role: 'Protagonist',
                    x: this.width / 2,
                    y: this.height / 2,
                    relationship: 0,
                    mood: 'active'
                });
                
                // Create edges (relationships)
                this.edges = [];
                this.nodes.forEach(node => {
                    if (node.id !== 'player') {
                        this.edges.push({
                            from: 'player',
                            to: node.id,
                            strength: node.relationship
                        });
                    }
                });
            }
            
            draw() {
                this.ctx.clearRect(0, 0, this.width, this.height);
                
                // Draw edges
                this.edges.forEach(edge => {
                    const from = this.nodes.find(n => n.id === edge.from);
                    const to = this.nodes.find(n => n.id === edge.to);
                    if (!from || !to) return;
                    
                    this.ctx.beginPath();
                    this.ctx.moveTo(from.x, from.y);
                    this.ctx.lineTo(to.x, to.y);
                    
                    // Color based on relationship
                    const strength = edge.strength;
                    if (strength > 20) {
                        this.ctx.strokeStyle = `rgba(0, 255, 0, ${Math.min(strength / 100, 0.8)})`;
                        this.ctx.lineWidth = 2;
                    } else if (strength < -20) {
                        this.ctx.strokeStyle = `rgba(255, 0, 0, ${Math.min(Math.abs(strength) / 100, 0.8)})`;
                        this.ctx.lineWidth = 2;
                    } else {
                        this.ctx.strokeStyle = 'rgba(255, 255, 0, 0.3)';
                        this.ctx.lineWidth = 1;
                    }
                    
                    this.ctx.stroke();
                });
                
                // Draw nodes
                this.nodes.forEach(node => {
                    // Node circle
                    this.ctx.beginPath();
                    this.ctx.arc(node.x, node.y, node.id === 'player' ? 15 : 10, 0, Math.PI * 2);
                    
                    if (node.id === 'player') {
                        this.ctx.fillStyle = '#ff6600';
                    } else if (node.relationship > 20) {
                        this.ctx.fillStyle = '#0f0';
                    } else if (node.relationship < -20) {
                        this.ctx.fillStyle = '#f00';
                    } else {
                        this.ctx.fillStyle = '#ffff00';
                    }
                    
                    this.ctx.fill();
                    this.ctx.strokeStyle = '#000';
                    this.ctx.lineWidth = 2;
                    this.ctx.stroke();
                    
                    // Label
                    this.ctx.fillStyle = '#0f0';
                    this.ctx.font = '10px "Courier New"';
                    this.ctx.textAlign = 'center';
                    this.ctx.fillText(node.name, node.x, node.y - 15);
                    
                    // Role
                    this.ctx.fillStyle = '#666';
                    this.ctx.font = '8px "Courier New"';
                    this.ctx.fillText(node.role, node.x, node.y + 25);
                });
            }
        }
        
