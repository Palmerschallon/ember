### 6. **WANTED SYSTEM** (The Famous Stars!)

**How RAGE Implements It:**

```javascript
class WantedSystem {
    constructor() {
        this.stars = 0; // 0-5 stars
        this.timer = 0;
    }
    
    onCrime(severity) {
        // Increase stars based on crime
        const crimes = {
            'jaywalking': 0,
            'punch': 1,
            'carjack': 2,
            'shoot': 3,
            'murder': 4,
            'rampage': 5
        };
        
        this.stars = Math.min(5, this.stars + crimes[severity]);
        this.timer = 0; // Reset cooldown
        
        // Spawn cops based on stars
        this.spawnResponse();
    }
    
    spawnResponse() {
        switch(this.stars) {
            case 1:
                this.spawnCops(2, 'on_foot');
                break;
            case 2:
                this.spawnCops(4, 'cars');
                break;
            case 3:
                this.spawnCops(8, 'cars');
                this.spawnHelicopter(1);
                break;
            case 4:
                this.spawnSWAT(10);
                this.spawnHelicopter(2);
                break;
            case 5:
                this.spawnArmy(20);
                this.spawnTanks(3);
                this.spawnHelicopter(3);
                break;
        }
    }
    
    update(delta) {
        // Decay over time if out of sight
        if (this.playerHidden()) {
            this.timer += delta;
            if (this.timer > 10) { // 10 seconds hidden
                this.stars = Math.max(0, this.stars - 1);
                this.timer = 0;
            }
        }
    }
}
