}

// Animation
const clock=new T.Clock();
let fps=0,frames=0,lastTime=0;

function animate(){
  const delta=clock.getDelta();
  const time=clock.getElapsedTime();
  
  frames++;
  if(time-lastTime>1){
    fps=frames;
    frames=0;
    lastTime=time;
    document.getElementById('fps').textContent='FPS: '+fps;
  }
  
  // Update shader time
  windowShader.uniforms.time.value=time;
  
  // Update cars
  for(let i=0;i<carCount;i++){
    const car=carData[i];
    car.x+=car.dirX*car.speed*delta;
    car.z+=car.dirZ*car.speed*delta;
    
    if(car.x>400)car.x=-400;
    if(car.x<-400)car.x=400;
    if(car.z>400)car.z=-400;
    if(car.z<-400)car.z=400;
    
    dummy.position.set(car.x,1.5,car.z);
    dummy.rotation.y=car.dirX!=0?0:Math.PI/2;
    dummy.updateMatrix();
    cars.setMatrixAt(i,dummy.matrix);
  }
  cars.instanceMatrix.needsUpdate=true;
  
  // Camera movement
  if(locked){
    const speed=50*delta;
    const forward=new T.Vector3();
    const right=new T.Vector3();
    
    camera.getWorldDirection(forward);
    forward.y=0;
    forward.normalize();
    right.crossVectors(forward,new T.Vector3(0,1,0));
    
    if(keys.w)camera.position.addScaledVector(forward,speed);
    if(keys.s)camera.position.addScaledVector(forward,-speed);
    if(keys.a)camera.position.addScaledVector(right,-speed);
    if(keys.d)camera.position.addScaledVector(right,speed);
    if(keys.space)camera.position.y+=speed;
    if(keys.shift)camera.position.y-=speed;
    
    if(camera.position.y<2)camera.position.y=2;
    
    camera.rotation.order='YXZ';
    camera.rotation.y=mouseX;
    camera.rotation.x=mouseY;
  }
  
  document.getElementById('pos').textContent=`Position: ${Math.round(camera.position.x)}, ${Math.round(camera.position.z)}`;
  document.getElementById('height').textContent=Math.round(camera.position.y);
  
  renderer.render(scene,camera);
  requestAnimationFrame(animate);
}

animate();

window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>
