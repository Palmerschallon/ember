// Load sections as player moves
function updateVisibleSections() {
    const playerPos = camera.position;
    const visibleRadius = 100; // meters
    
    sections.forEach(section => {
        const distance = playerPos.distanceTo(section.center);
        
        if (distance < visibleRadius && !section.loaded) {
            loadSection(section);
        } else if (distance > visibleRadius * 1.5 && section.loaded) {
            unloadSection(section);
        }
    });
}
