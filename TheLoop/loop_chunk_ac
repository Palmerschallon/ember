  const scaleNames = {
    0.0001: '🦠 Microscopic (0.1mm)',
    0.001: '🐜 Ant-sized (1mm)',
    0.01: '🐛 Bug-sized (1cm)',
    0.1: '🐭 Mouse-sized (10cm)',
    1: '🧍 Human-sized (1m)'
  };
  document.getElementById('scale').textContent = 'Scale: ' + (scaleNames[newScale] || `${newScale}m`);
  
  // Adjust fog for scale
  if (newScale >= 0.1) {
    // At large scales, fog is far away
