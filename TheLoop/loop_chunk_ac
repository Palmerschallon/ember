// Filmic tone mapping (Uncharted 2)
function tonemap(color) {
    const A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
    return ((color*(A*color+C*B)+D*E)/(color*(A*color+B)+D*F))-E/F;
}

// Apply warmth
function warmGrade(color) {
    color.r *= 1.1; // Boost reds
