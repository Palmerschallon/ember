            });
            document.getElementById('connection-count').textContent = connections;
            
            // Factions (simplified - count hostile/friendly groups)
            const factions = new Set();
            Object.values(worldState.npcs || {}).forEach(npc => {
                if (npc.relationship > 20) factions.add('friendly');
                if (npc.relationship < -20) factions.add('hostile');
            });
            document.getElementById('faction-count').textContent = factions.size;
            
            // Update network graph
            if (networkGraph && worldState.npcs) {
                networkGraph.update(worldState.npcs);
                networkGraph.draw();
            }
        }
        
        function renderStoryArcs(arcs) {
            const container = document.getElementById('story-arcs-content');
            
            if (!arcs || arcs.length === 0) {
                container.innerHTML = '<div class="no-data">No active story arcs yet.<br>Talk to NPCs to trigger emergence!</div>';
                document.getElementById('arc-count').textContent = '0';
                document.getElementById('episode-count').textContent = '0';
                document.getElementById('emergence-score').textContent = '0%';
                return;
