        const leftDelta = hand1.position.clone().sub(prevLeftHandPos);
        const rightDelta = hand2.position.clone().sub(prevRightHandPos);
        
        // Average movement = locomotion
        const avgDelta = leftDelta.add(rightDelta).multiplyScalar(0.5);
        camera.position.add(avgDelta.multiplyScalar(movementMultiplier));
    }
}
