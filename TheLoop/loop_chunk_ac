            npc.position.set(
                Math.cos(angle) * radius,
                1.5,
                Math.sin(angle) * radius
            );
            
            npc.userData = {
                ...npcData,
                id: `npc_${i}`,
                memory: [],
                questsGiven: [],
                lastInteraction: null
            };
            
            scene.add(npc);
            npcs.push(npc);
            gameState.relationships[npc.userData.id] = 0; // Neutral
        });

        // ═══════════════════════════════════════════════════════════════
        // BACKEND API CONNECTION
        // ═══════════════════════════════════════════════════════════════
        
        const API_BASE = 'http://localhost:5555';
        let backendAvailable = false;
        
        async function checkBackend() {
            try {
                const response = await fetch(`${API_BASE}/status`);
                const data = await response.json();
                backendAvailable = data.status === 'running';
                console.log('🔥 Backend connected:', data);
                return true;
            } catch (error) {
                backendAvailable = false;
                console.warn('⚠️  Backend not available, using fallback dialogue');
                return false;
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // NPC DIALOGUE (Real AI Integration)
        // ═══════════════════════════════════════════════════════════════
        
        async function generateNPCDialogue(npc, playerMessage = null) {
            if (backendAvailable) {
                try {
                    const response = await fetch(`${API_BASE}/talk`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            npc_id: npc.userData.id,
                            message: playerMessage
                        })
                    });
                    
                    const data = await response.json();
                    console.log('🦙 Llama response:', data);
                    
                    return {
                        dialogue: data.dialogue,
                        quest: data.quest,
                        relationshipChange: 0, // Backend handles this
                        mood: data.mood
                    };
                } catch (error) {
                    console.error('Backend dialogue failed:', error);
                    // Fall through to fallback
                }
            }
            
            // FALLBACK: Simple procedural dialogue when backend unavailable
            const isFirstMeet = npc.userData.memory.length === 0;
            
            if (isFirstMeet) {
                return {
                    dialogue: `Hey, I'm ${npc.userData.name}. ${npc.userData.role}. What do you want?`,
                    relationshipChange: 1
                };
            } else if (playerMessage) {
                return {
                    dialogue: `Interesting... I'll have to think about that. Check back later.`,
                    relationshipChange: 1
                };
            } else {
                const quests = [
                    {
                        dialogue: `I've got a job for you. Interested in making some cash?`,
                        quest: {
                            title: "Delivery Run",
                            description: "Take a package to the docks. Don't ask questions.",
                            type: "delivery",
                            reward: "$5,000"
                        },
                        relationshipChange: 5
                    },
                    {
                        dialogue: `You look like someone who can handle themselves. I need help.`,
                        quest: {
                            title: "Missing Person",
                            description: `${npc.userData.name}'s friend vanished. Find them.`,
                            type: "investigation",
                            reward: "Information + $3,000"
                        },
                        relationshipChange: 10
                    },
                    {
                        dialogue: `Glad to see you again. Things have been quiet. Too quiet.`,
                        relationshipChange: 2
                    }
                ];
                
                return quests[Math.floor(Math.random() * quests.length)];
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // PLAYER CONTROLS
        // ═══════════════════════════════════════════════════════════════
        
        const movement = { forward: 0, backward: 0, left: 0, right: 0, up: 0, down: 0 };
        const velocity = new THREE.Vector3();
        const direction = new THREE.Vector3();
        let pointerLocked = false;
        let mouseX = 0, mouseY = 0;
        let yaw = 0, pitch = 0;
        
        window.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') movement.forward = 1;
            if (k === 's') movement.backward = 1;
            if (k === 'a') movement.left = 1;
            if (k === 'd') movement.right = 1;
            if (k === ' ') { movement.up = 1; e.preventDefault(); }
            if (k === 'shift') movement.down = 1;
            if (k === 't') {
                gameState.time = (gameState.time + 1) % 24;
                updateTimeOfDay(gameState.time);
            }
            if (k === 'tab') {
                e.preventDefault();
                const questLog = document.getElementById('quest-log');
                questLog.style.display = questLog.style.display === 'none' ? 'block' : 'none';
            }
        });
        
        window.addEventListener('keyup', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') movement.forward = 0;
            if (k === 's') movement.backward = 0;
            if (k === 'a') movement.left = 0;
            if (k === 'd') movement.right = 0;
            if (k === ' ') movement.up = 0;
            if (k === 'shift') movement.down = 0;
        });
        
        document.addEventListener('mousemove', (e) => {
            if (!pointerLocked) return;
            mouseX = e.movementX || 0;
            mouseY = e.movementY || 0;
            yaw -= mouseX * 0.002;
            pitch -= mouseY * 0.002;
            pitch = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, pitch));
        });
        
        document.addEventListener('click', async (e) => {
            if (document.getElementById('instructions').style.display !== 'none') {
                document.getElementById('instructions').style.display = 'none';
                document.body.requestPointerLock();
                updateTimeOfDay(gameState.time);
                return;
            }
            
            // NPC interaction
            if (pointerLocked) {
                const raycaster = new THREE.Raycaster();
                raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
                const intersects = raycaster.intersectObjects(npcs);
                
                if (intersects.length > 0) {
                    const clickedNPC = intersects[0].object;
                    await interactWithNPC(clickedNPC);
                }
            }
        });
        
        document.addEventListener('pointerlockchange', () => {
            pointerLocked = document.pointerLockElement === document.body;
        });

        // ═══════════════════════════════════════════════════════════════
        // NPC INTERACTION
        // ═══════════════════════════════════════════════════════════════
        
        let currentNPC = null;
        
        async function interactWithNPC(npc) {
            currentNPC = npc;
            const dialogue = await generateNPCDialogue(npc);
            
            // Update relationship
            if (dialogue.relationshipChange) {
                gameState.relationships[npc.userData.id] += dialogue.relationshipChange;
                gameState.relationships[npc.userData.id] = Math.max(-100, Math.min(100, gameState.relationships[npc.userData.id]));
            }
            
            // Record memory
            npc.userData.memory.push({
                time: gameState.time,
                interaction: dialogue.dialogue
            });
            
            // Show dialogue
            document.getElementById('dialogue-speaker').textContent = npc.userData.name;
            document.getElementById('dialogue-text').textContent = dialogue.dialogue;
            document.getElementById('dialogue-box').style.display = 'block';
            document.getElementById('dialogue-input').value = '';
            document.getElementById('dialogue-input').focus();
            
            // Speak dialogue
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(dialogue.dialogue);
                utterance.rate = 0.9;
                speechSynthesis.speak(utterance);
            }
            
            // Add quest if offered
            if (dialogue.quest) {
                gameState.activeQuests.push(dialogue.quest);
                updateQuestLog();
                showNotification(`New Quest: ${dialogue.quest.title}`);
            }
        }
        
        document.getElementById('dialogue-input').addEventListener('keydown', async (e) => {
            if (e.key === 'Enter' && currentNPC) {
                const playerMessage = e.target.value;
                if (playerMessage.trim()) {
                    gameState.playerActions.push({
                        type: 'dialogue',
                        npc: currentNPC.userData.id,
                        message: playerMessage,
                        time: gameState.time
                    });
                    
                    const response = await generateNPCDialogue(currentNPC, playerMessage);
                    document.getElementById('dialogue-text').textContent = response.dialogue;
                    
                    if ('speechSynthesis' in window) {
                        const utterance = new SpeechSynthesisUtterance(response.dialogue);
                        utterance.rate = 0.9;
                        speechSynthesis.speak(utterance);
                    }
                    
                    e.target.value = '';
                }
            }
            if (e.key === 'Escape') {
                document.getElementById('dialogue-box').style.display = 'none';
                currentNPC = null;
            }
        });

        function updateQuestLog() {
            const questList = document.getElementById('quest-list');
            questList.innerHTML = gameState.activeQuests.map(q => 
                `<div class="quest-item">• ${q.title}</div>`
            ).join('');
        }

        function showNotification(message) {
            const notif = document.getElementById('notification');
            notif.textContent = message;
            notif.style.display = 'block';
            setTimeout(() => {
                notif.style.display = 'none';
            }, 3000);
        }

        // ═══════════════════════════════════════════════════════════════
        // RENDER LOOP
        // ═══════════════════════════════════════════════════════════════
        
        const clock = new THREE.Clock();
        let lastTime = performance.now();
        let frames = 0;
        
        function animate() {
            requestAnimationFrame(animate);
            
            const delta = clock.getDelta();
            const time = clock.getElapsedTime();
            
            // Update shaders
            brickShader.uniforms.time.value = time;
            glassShader.uniforms.time.value = time;
            concreteShader.uniforms.time.value = time;
            
            // Movement
            const speed = 20 * delta;
            
            direction.set(
                movement.right - movement.left,
                movement.up - movement.down,
                movement.backward - movement.forward
            );
            direction.normalize();
            
            // Apply camera rotation to movement
            const forward = new THREE.Vector3(0, 0, -1);
            const right = new THREE.Vector3(1, 0, 0);
            forward.applyEuler(new THREE.Euler(0, yaw, 0));
            right.applyEuler(new THREE.Euler(0, yaw, 0));
            
            velocity.copy(forward).multiplyScalar(direction.z);
            velocity.add(right.clone().multiplyScalar(direction.x));
            velocity.y = direction.y;
            velocity.multiplyScalar(speed);
            
            camera.position.add(velocity);
            
            // Keep above ground
            if (camera.position.y < 2) camera.position.y = 2;
            
            // Camera rotation
            camera.rotation.set(pitch, yaw, 0);
            
            // Check nearby NPCs
            let nearestNPC = null;
            let minDist = Infinity;
            npcs.forEach(npc => {
                const dist = camera.position.distanceTo(npc.position);
                if (dist < 10 && dist < minDist) {
                    minDist = dist;
                    nearestNPC = npc;
                }
            });
            
            if (nearestNPC) {
                document.getElementById('hint').textContent = 
                    `Click to talk to ${nearestNPC.userData.name} (${nearestNPC.userData.role})`;
            } else {
                document.getElementById('hint').textContent = '';
            }
            
            // FPS counter
            frames++;
            const now = performance.now();
            if (now >= lastTime + 1000) {
                document.getElementById('fps').textContent = `FPS: ${frames}`;
                frames = 0;
                lastTime = now;
            }
            
            // Update reputation display
            let repText = 'Neutral';
            if (gameState.reputation > 30) repText = 'Hero';
            else if (gameState.reputation > 10) repText = 'Good';
            else if (gameState.reputation < -30) repText = 'Criminal';
            else if (gameState.reputation < -10) repText = 'Suspicious';
            document.getElementById('reputation').textContent = `Reputation: ${repText}`;
            
            renderer.render(scene, camera);
        }
        
        // Initialize
        checkBackend();
        animate();
        
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>


