            buildings.forEach(b => b.visible = true);
            door.visible = true;
            ground.visible = true;
            scene.background = new THREE.Color(0x87ceeb);
            scene.fog = new THREE.Fog(0x87ceeb, 50, 200);
            
            // Move camera outside
            camera.position.set(0, 1.7, 0);
            camera.rotation.set(0, 0, 0);
            mx = 0;
            my = 0;
            
