class GameMaster:
    def __init__(self, mesh_db_path: str):
        self.mesh = SemanticMesh(mesh_db_path)
        self.llama_actor = LlamaActor()
        self.gpt4_director = GPT4Director()
        
        # Initialize world
        self.world_state = self.mesh.load_world_state() or WorldState(
            time=12.0,
            weather="clear",
            reputation=0,
            active_quests=[],
            completed_quests=[],
            world_events=[],
            faction_standings={},
            player_actions=[]
        )
        
        # Initialize NPCs
        self.npcs: Dict[str, NPCState] = {}
        self._init_npcs()
        
        # Director runs every 5 minutes
        self.director_interval = 300  # seconds
        self.last_director_run = 0
        
        print("✅ Game Master initialized!")
    
    def _init_npcs(self):
        """Initialize NPC states"""
        npc_templates = [
            {"id": "npc_0", "name": "Marcus", "role": "Street Vendor", "personality": "friendly, knows gossip, helpful"},
            {"id": "npc_1", "name": "Dr. Chen", "role": "Scientist", "personality": "brilliant, paranoid, investigating conspiracy"},
            {"id": "npc_2", "name": "Sofia", "role": "Journalist", "personality": "curious, brave, looking for truth"},
            {"id": "npc_3", "name": "Rico", "role": "Gang Member", "personality": "tough, loyal to crew, distrustful"},
            {"id": "npc_4", "name": "Maya", "role": "Hacker", "personality": "sarcastic, genius, wants revenge"},
            {"id": "npc_5", "name": "Detective Kane", "role": "Cop", "personality": "jaded, seen too much, secretly good"},
            {"id": "npc_6", "name": "Luna", "role": "Artist", "personality": "eccentric, visionary, knows secrets"},
            {"id": "npc_7", "name": "Tomas", "role": "Bartender", "personality": "wise, knows everyone, neutral"},
        ]
        
        for template in npc_templates:
            npc = self.mesh.load_npc(template['id'])
            if not npc:
                npc = NPCState(
                    id=template['id'],
                    name=template['name'],
                    role=template['role'],
                    personality=template['personality'],
                    position={"x": 0, "y": 0, "z": 0},
                    goals=["survive", "help player if trusted"],
                    memory=[],
                    relationships={"player": 0}
                )
                self.mesh.save_npc(npc)
            self.npcs[npc.id] = npc
    
    def talk_to_npc(self, npc_id: str, player_message: Optional[str] = None) -> Dict:
        """Handle player-NPC interaction"""
        npc = self.npcs.get(npc_id)
        if not npc:
            return {"error": "NPC not found"}
        
        # Build context
        context = {
            "player_reputation": self.world_state.reputation,
            "location": "Downtown",
            "time": self.world_state.time
        }
        
        # Generate dialogue
        dialogue = self.llama_actor.generate_dialogue(npc, context, player_message)
        
        # Update NPC memory
        npc.memory.append({
            "time": self.world_state.time,
            "interaction": dialogue,
            "player_message": player_message
        })
        npc.last_interaction = time.time()
        
        # Update relationship
        if player_message:
            npc.relationships["player"] = min(100, npc.relationships.get("player", 0) + 1)
        
        # Save state
        self.mesh.save_npc(npc)
        
        # Log event
        self.mesh.log_event("npc_interaction", {
            "npc": npc_id,
            "dialogue": dialogue,
            "player_message": player_message
        })
        
        # Maybe generate quest
        quest = None
        if npc.relationships.get("player", 0) > 20 and len(npc.memory) > 3:
            quest = self._maybe_generate_quest(npc)
        
        return {
            "dialogue": dialogue,
            "speaker": npc.name,
            "relationship": npc.relationships["player"],
            "mood": npc.mood,
            "quest": quest
        }
    
    def _maybe_generate_quest(self, npc: NPCState) -> Optional[Dict]:
        """NPC might offer a quest"""
        import random
        if random.random() < 0.3:  # 30% chance
            return {
                "title": f"{npc.name}'s Request",
                "description": f"Help {npc.name} with something important.",
                "type": random.choice(["delivery", "investigation", "rescue"]),
                "reward": "$5,000"
            }
        return None
    
    def run_director(self):
        """Director analyzes world state and creates story arcs"""
        now = time.time()
        if now - self.last_director_run < self.director_interval:
            return
        
        print("🎬 Director analyzing world state...")
        
        recent_events = self.mesh.get_recent_events(50)
        npcs = list(self.npcs.values())
        
        # Generate story arc
        arc = self.gpt4_director.generate_story_arc(self.world_state, recent_events, npcs)
        
        if arc:
            self.mesh.save_story_arc(arc)
            self.mesh.log_event("story_arc_created", {"arc_id": arc.id, "title": arc.title})
            print(f"✨ New story arc: {arc.title}")
        
        self.last_director_run = now
    
    def get_world_state(self) -> Dict:
        """Get current world state for visualization"""
        return {
            "time": self.world_state.time,
            "weather": self.world_state.weather,
            "reputation": self.world_state.reputation,
            "active_quests": self.world_state.active_quests,
            "npcs": {npc_id: asdict(npc) for npc_id, npc in self.npcs.items()},
            "story_arcs": [asdict(arc) for arc in self.mesh.get_active_story_arcs()],
            "recent_events": self.mesh.get_recent_events(20)
        }
    
    def update_world_time(self, new_time: float):
        """Update world time"""
        self.world_state.time = new_time % 24
        self.mesh.save_world_state(self.world_state)

