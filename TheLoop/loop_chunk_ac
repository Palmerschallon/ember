        function initModelViewer(canvas, modelPath) {
            // Scene
            modelScene = new THREE.Scene();
            modelScene.background = new THREE.Color(0x0a0a0a);
            
            // Camera
            modelCamera = new THREE.PerspectiveCamera(
                75,
                canvas.clientWidth / canvas.clientHeight,
                0.1,
                1000
            );
            modelCamera.position.z = 5;
            
            // Renderer
            modelRenderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
            modelRenderer.setSize(canvas.clientWidth, canvas.clientHeight);
            
            // Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
            modelScene.add(ambientLight);
            
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 5, 5);
            modelScene.add(directionalLight);
            
            // Load OBJ model
            const loader = new THREE.OBJLoader();
            loader.load(
                `http://localhost:8080/model/${modelPath}`,
                function (object) {
                    // Apply material
                    object.traverse(function (child) {
                        if (child instanceof THREE.Mesh) {
                            child.material = new THREE.MeshPhongMaterial({
                                color: 0xff6b35,
                                shininess: 30
                            });
                        }
                    });
                    
                    // Center and scale model
                    const box = new THREE.Box3().setFromObject(object);
                    const center = box.getCenter(new THREE.Vector3());
                    const size = box.getSize(new THREE.Vector3());
                    
                    const maxDim = Math.max(size.x, size.y, size.z);
                    const scale = 4 / maxDim;
                    
                    object.position.sub(center);
                    object.scale.multiplyScalar(scale);
                    
                    modelMesh = object;
                    modelScene.add(object);
                },
                function (xhr) {
                    console.log((xhr.loaded / xhr.total * 100) + '% loaded');
                },
                function (error) {
                    console.error('Error loading model:', error);
                }
            );
            
            // Animation loop
            function animate() {
                requestAnimationFrame(animate);
                
                if (modelMesh && isModelRotating) {
                    modelMesh.rotation.y += 0.01;
                }
                
                modelRenderer.render(modelScene, modelCamera);
            }
            animate();
            
            // Handle window resize
            window.addEventListener('resize', () => {
                modelCamera.aspect = canvas.clientWidth / canvas.clientHeight;
                modelCamera.updateProjectionMatrix();
                modelRenderer.setSize(canvas.clientWidth, canvas.clientHeight);
            });
            
            window.modelViewerRenderer = modelRenderer;
        }
        
        function resetModelView() {
            if (modelCamera) {
                modelCamera.position.set(0, 0, 5);
                modelCamera.lookAt(0, 0, 0);
            }
            if (modelMesh) {
                modelMesh.rotation.set(0, 0, 0);
            }
        }
        
        function toggleModelRotation() {
            isModelRotating = !isModelRotating;
            const btn = event.target;
            btn.textContent = isModelRotating ? '⏸️ Pause' : '▶️ Play';
        }
        
        function toggleWireframe() {
            if (modelMesh) {
                modelMesh.traverse(function (child) {
                    if (child instanceof THREE.Mesh) {
                        child.material.wireframe = !child.material.wireframe;
                    }
                });
            }
        }
        
