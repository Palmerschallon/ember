// Building generator with zones
function makeBuilding(x,z,seed,zone){
  const rng=()=>{seed=(seed*9301+49297)%233280;return seed/233280};
  const w=15+rng()*15;
  const d=15+rng()*15;
  
  let h,material;
  
  // Zone-based generation
  const distFromCenter=Math.sqrt(x*x+z*z);
  
  if(zone=='commercial'||distFromCenter<100){
    // Downtown - tall glass towers
    h=80+rng()*120;
    material=new T.ShaderMaterial(windowShader);
  }else if(zone=='industrial'){
    // Industrial - concrete warehouses
    h=20+rng()*30;
    material=new T.ShaderMaterial(concreteShader);
  }else{
    // Residential - brick buildings
    h=30+rng()*50;
    material=new T.ShaderMaterial(brickShader);
  }
  
  const building=new T.Mesh(new T.BoxGeometry(w,h,d),material);
  building.position.set(x,h/2,z);
  building.castShadow=true;
  building.receiveShadow=true;
  building.userData={enterable:true,zone};
  
  return building;
}

