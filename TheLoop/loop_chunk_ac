    // At tiny scales, fog is proportionally closer
    scene.fog.near = newScale * 300;
    scene.fog.far = newScale * 2000;
  }
};

// Sky color
scene.background = new THREE.Color(0x87ceeb);

// Very light fog (won't obscure nearby objects)
scene.fog = new THREE.Fog(0x87ceeb, 0.3, 2); // Linear fog: starts at 30cm, full at 2m

// LIGHTING - Warm and natural
scene.add(new THREE.AmbientLight(0xf0e8d0, 0.5));

// Sun rays (warm sunlight)
const sun = new THREE.DirectionalLight(0xffeedd, 1.2);
sun.position.set(0.5, 1, 0.3);
sun.castShadow = true;
sun.shadow.mapSize.width = 2048;
sun.shadow.mapSize.height = 2048;
sun.shadow.camera.near = 0.00001;
sun.shadow.camera.far = 10;
sun.shadow.camera.left = -0.5;
sun.shadow.camera.right = 0.5;
sun.shadow.camera.top = 0.5;
sun.shadow.camera.bottom = -0.5;
scene.add(sun);

// Fill light (blue sky reflection)
const fillLight = new THREE.DirectionalLight(0x88ccff, 0.3);
fillLight.position.set(-0.5, 0.3, -0.5);
scene.add(fillLight);

// GROUND - Curved sphere interior (terrarium!)
const sphereRadius = 0.5;
const groundGeo = new THREE.SphereGeometry(sphereRadius, 128, 128, 0, Math.PI * 2, 0, Math.PI / 2);
const groundVerts = groundGeo.attributes.position.array;

// Add procedural terrain bumps
for (let i = 0; i < groundVerts.length; i += 3) {
  const x = groundVerts[i];
  const y = groundVerts[i + 1];
  const z = groundVerts[i + 2];
  const dist = Math.sqrt(x * x + y * y + z * z);
  const noise = 
    Math.sin(x * 100) * 0.002 +
    Math.cos(z * 100) * 0.002 +
    Math.sin(x * 300) * 0.0005 +
    Math.random() * 0.0003;
  
  groundVerts[i] *= (1 + noise / dist);
  groundVerts[i + 1] *= (1 + noise / dist);
  groundVerts[i + 2] *= (1 + noise / dist);
}
groundGeo.computeVertexNormals();

const groundMat = new THREE.MeshStandardMaterial({
  color: 0x5a4a3a,
  roughness: 0.85,
  metalness: 0.05,
  side: THREE.DoubleSide
});

const ground = new THREE.Mesh(groundGeo, groundMat);
ground.receiveShadow = true;
scene.add(ground);

// Transparent dome (terrarium glass)
const domeGeo = new THREE.SphereGeometry(sphereRadius * 1.01, 64, 64);
const domeMat = new THREE.MeshPhysicalMaterial({
  color: 0xffffff,
  transparent: true,
  opacity: 0.1,
  roughness: 0,
  metalness: 0.1,
  transmission: 0.9,
  thickness: 0.5,
  side: THREE.BackSide
});
const dome = new THREE.Mesh(domeGeo, domeMat);
scene.add(dome);

// GRASS BLADES (become trees at ant scale) - LOTS OF THEM!
const grassBlades = [];
for (let i = 0; i < 800; i++) {
  const bladeHeight = 0.008 + Math.random() * 0.025;
  const bladeWidth = 0.0004;
  
  const bladeGeo = new THREE.CylinderGeometry(bladeWidth, bladeWidth * 1.8, bladeHeight, 4, 6);
  const bladeVerts = bladeGeo.attributes.position.array;
  
  // Bend the blade
  for (let j = 0; j < bladeVerts.length; j += 3) {
    const heightRatio = (bladeVerts[j + 1] + bladeHeight / 2) / bladeHeight;
    bladeVerts[j] += Math.sin(heightRatio * Math.PI) * 0.0012 * heightRatio;
  }
  bladeGeo.computeVertexNormals();
  
  const bladeMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color().setHSL(0.28 + Math.random() * 0.12, 0.65, 0.35 + Math.random() * 0.25),
    roughness: 0.75,
    side: THREE.DoubleSide
  });
  
  const blade = new THREE.Mesh(bladeGeo, bladeMat);
  
  // Random position in circle
  const angle = Math.random() * Math.PI * 2;
  const radius = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.85;
  const x = Math.cos(angle) * radius;
  const z = Math.sin(angle) * radius;
  const y = Math.sqrt(Math.max(0, sphereRadius * sphereRadius - x * x - z * z));
  
  blade.position.set(x, y, z);
  
  // Orient perpendicular to sphere surface
  const normal = new THREE.Vector3(x, y, z).normalize();
  blade.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
  blade.translateY(bladeHeight / 2);
  
  blade.castShadow = true;
  blade.receiveShadow = true;
  
  scene.add(blade);
  grassBlades.push({ mesh: blade, phase: Math.random() * Math.PI * 2, speed: 0.3 + Math.random() * 0.4 });
}

// TWIGS (like fallen trees at ant scale)
for (let i = 0; i < 15; i++) {
  const twigLength = 0.02 + Math.random() * 0.04;
  const twigRadius = 0.0008;
  
  const twigGeo = new THREE.CylinderGeometry(twigRadius, twigRadius * 1.2, twigLength, 6);
  const twigMat = new THREE.MeshStandardMaterial({
    color: 0x4a3a2a,
    roughness: 0.9
  });
  
  const twig = new THREE.Mesh(twigGeo, twigMat);
  twig.position.set(
    (Math.random() - 0.5) * 0.5,
    twigRadius,
    (Math.random() - 0.5) * 0.5
  );
  twig.rotation.z = Math.PI / 2;
  twig.rotation.y = Math.random() * Math.PI * 2;
  twig.castShadow = true;
  twig.receiveShadow = true;
  
  scene.add(twig);
}

// PEBBLES (like boulders at ant scale)
for (let i = 0; i < 30; i++) {
  const size = 0.002 + Math.random() * 0.006;
  const pebbleGeo = new THREE.DodecahedronGeometry(size, 0);
  const pebbleMat = new THREE.MeshStandardMaterial({
    color: new THREE.Color().setHSL(0.1, 0.2, 0.3 + Math.random() * 0.2),
    roughness: 0.7,
    flatShading: true
  });
  
  const pebble = new THREE.Mesh(pebbleGeo, pebbleMat);
  pebble.position.set(
    (Math.random() - 0.5) * 0.5,
    size * 0.5,
    (Math.random() - 0.5) * 0.5
  );
  pebble.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
  pebble.castShadow = true;
  pebble.receiveShadow = true;
  
  scene.add(pebble);
}

// MUSHROOMS (massive structures at ant scale) - MORE!
for (let i = 0; i < 25; i++) {
  const stemHeight = 0.012 + Math.random() * 0.020;
  const capRadius = 0.006 + Math.random() * 0.012;
  
  // Position on sphere
  const angle = Math.random() * Math.PI * 2;
  const radius = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.75;
  const x = Math.cos(angle) * radius;
  const z = Math.sin(angle) * radius;
  const y = Math.sqrt(Math.max(0, sphereRadius * sphereRadius - x * x - z * z));
  
  const stem = new THREE.Mesh(
    new THREE.CylinderGeometry(0.0012, 0.0018, stemHeight, 8),
    new THREE.MeshStandardMaterial({ color: 0xf5f0e8, roughness: 0.85 })
  );
  
  // Orient stem perpendicular to sphere
  const normal = new THREE.Vector3(x, y, z).normalize();
  stem.position.set(x, y, z);
  stem.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
  stem.translateY(stemHeight / 2);
  stem.castShadow = true;
  
  const cap = new THREE.Mesh(
    new THREE.SphereGeometry(capRadius, 16, 10, 0, Math.PI * 2, 0, Math.PI / 1.8),
    new THREE.MeshStandardMaterial({ 
      color: new THREE.Color().setHSL(Math.random() * 0.15, 0.75, 0.45),
      roughness: 0.65,
      emissive: new THREE.Color().setHSL(Math.random() * 0.15, 0.5, 0.1),
      emissiveIntensity: 0.2
    })
  );
  
  cap.position.copy(stem.position);
  cap.quaternion.copy(stem.quaternion);
  cap.translateY(stemHeight / 2 + capRadius * 0.3);
  cap.castShadow = true;
  
  scene.add(stem, cap);
}

// WILDFLOWERS (pops of color!)
for (let i = 0; i < 150; i++) {
  const stemHeight = 0.006 + Math.random() * 0.010;
  
  // Position on sphere
  const angle = Math.random() * Math.PI * 2;
  const radius = Math.random() * Math.sqrt(Math.random()) * sphereRadius * 0.85;
  const x = Math.cos(angle) * radius;
  const z = Math.sin(angle) * radius;
  const y = Math.sqrt(Math.max(0, sphereRadius * sphereRadius - x * x - z * z));
  
  const stem = new THREE.Mesh(
    new THREE.CylinderGeometry(0.0001, 0.0001, stemHeight, 4),
    new THREE.MeshStandardMaterial({ color: 0x4a6a3a })
  );
  
  const normal = new THREE.Vector3(x, y, z).normalize();
  stem.position.set(x, y, z);
  stem.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);
  stem.translateY(stemHeight / 2);
  
  // Flower petals
  const petalCount = 5 + Math.floor(Math.random() * 3);
  const flowerColor = new THREE.Color().setHSL(Math.random(), 0.85, 0.55);
  
  for (let p = 0; p < petalCount; p++) {
    const petal = new THREE.Mesh(
      new THREE.SphereGeometry(0.0008, 6, 6),
      new THREE.MeshStandardMaterial({ 
        color: flowerColor,
        emissive: flowerColor,
        emissiveIntensity: 0.3
      })
    );
    
    const petalAngle = (p / petalCount) * Math.PI * 2;
    petal.position.copy(stem.position);
    petal.quaternion.copy(stem.quaternion);
    petal.translateY(stemHeight / 2);
    petal.translateX(Math.cos(petalAngle) * 0.001);
    petal.translateZ(Math.sin(petalAngle) * 0.001);
    
    scene.add(petal);
  }
  
  scene.add(stem);
}

// FLYING INSECTS (like helicopters at ant scale)
const insects = [];
const insectCount = 100;
const insectGeo = new THREE.BufferGeometry();
const insectPos = new Float32Array(insectCount * 3);
const insectColors = new Float32Array(insectCount * 3);

for (let i = 0; i < insectCount; i++) {
  const i3 = i * 3;
  insectPos[i3] = (Math.random() - 0.5) * 0.5;
  insectPos[i3 + 1] = Math.random() * 0.05 + 0.005;
  insectPos[i3 + 2] = (Math.random() - 0.5) * 0.5;
  
  const color = new THREE.Color().setHSL(Math.random(), 0.8, 0.5);
  insectColors[i3] = color.r;
  insectColors[i3 + 1] = color.g;
  insectColors[i3 + 2] = color.b;
  
  insects.push({
    vel: new THREE.Vector3(
      (Math.random() - 0.5) * 0.0001,
      (Math.random() - 0.5) * 0.00005,
      (Math.random() - 0.5) * 0.0001
    )
  });
}

insectGeo.setAttribute('position', new THREE.BufferAttribute(insectPos, 3));
insectGeo.setAttribute('color', new THREE.BufferAttribute(insectColors, 3));

const insectSystem = new THREE.Points(
  insectGeo,
  new THREE.PointsMaterial({
    size: 0.0005,
    vertexColors: true,
    transparent: true,
    opacity: 0.8
  })
);
scene.add(insectSystem);
let insectsPaused = false;

// Audio - Forest ambience
const audioCtx = new AudioContext();
const masterGain = audioCtx.createGain();
masterGain.gain.value = 0.15;
masterGain.connect(audioCtx.destination);
let audioStarted = false;

document.addEventListener('click', () => {
  if (!audioStarted) {
    audioStarted = true;
    
    // Wind rustle
    const noise = audioCtx.createBufferSource();
    const buffer = audioCtx.createBuffer(1, audioCtx.sampleRate * 2, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < data.length; i++) {
      data[i] = (Math.random() - 0.5) * 0.1;
    }
    noise.buffer = buffer;
    noise.loop = true;
    const noiseFilter = audioCtx.createBiquadFilter();
    noiseFilter.type = 'lowpass';
    noiseFilter.frequency.value = 300;
    noise.connect(noiseFilter);
    noiseFilter.connect(masterGain);
    noise.start();
    
    // Bird chirps (far away)
    setInterval(() => {
      const chirp = audioCtx.createOscillator();
      const chirpGain = audioCtx.createGain();
      chirp.frequency.value = 2000 + Math.random() * 1000;
      chirpGain.gain.value = 0.02;
      chirpGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
      chirp.connect(chirpGain);
      chirpGain.connect(masterGain);
      chirp.start();
      chirp.stop(audioCtx.currentTime + 0.1);
    }, 3000 + Math.random() * 5000);
  }
}, { once: true });

// Movement
const move = { f: 0, b: 0, l: 0, r: 0, u: 0, d: 0 };

document.addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (k === 'w') move.f = 1;
  if (k === 's') move.b = 1;
  if (k === 'a') move.l = 1;
  if (k === 'd') move.r = 1;
  if (k === ' ') move.u = 1;
  if (k === 'shift') move.d = 1;
  if (k === 'p') insectsPaused = !insectsPaused;
  if (k === 'escape') {
    document.exitPointerLock();
    document.getElementById('ui').style.display = 'block';
  }
});

document.addEventListener('keyup', e => {
  const k = e.key.toLowerCase();
  if (k === 'w') move.f = 0;
  if (k === 's') move.b = 0;
  if (k === 'a') move.l = 0;
  if (k === 'd') move.r = 0;
  if (k === ' ') move.u = 0;
  if (k === 'shift') move.d = 0;
});

// Mouse
let mouseX = 0, mouseY = 0, pointerLocked = false;

document.addEventListener('click', () => {
  if (!renderer.xr.isPresenting) {
    document.body.requestPointerLock();
    document.getElementById('ui').style.display = 'none';
  }
});

document.addEventListener('pointerlockchange', () => {
  pointerLocked = document.pointerLockElement === document.body;
  if (!pointerLocked) document.getElementById('ui').style.display = 'block';
});

document.addEventListener('mousemove', e => {
  if (pointerLocked) {
    mouseX += e.movementX * 0.002;
    mouseY += e.movementY * 0.002;
    mouseY = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, mouseY));
  }
});

// Animation
const clock = new THREE.Clock();
let fps = 0, frames = 0, lastTime = 0;

function animate() {
  const delta = clock.getDelta();
  const time = clock.getElapsedTime();
  
  frames++;
  if (time - lastTime > 1) {
    fps = frames;
    frames = 0;
    lastTime = time;
    document.getElementById('fps').textContent = 'FPS: ' + fps;
  }
  
  // Grass swaying
  grassBlades.forEach(blade => {
    blade.mesh.rotation.z = Math.sin(time * blade.speed + blade.phase) * 0.1;
  });
  
  // Insects flying
  if (!insectsPaused) {
    const pos = insectSystem.geometry.attributes.position.array;
    for (let i = 0; i < insectCount; i++) {
      const i3 = i * 3;
      const insect = insects[i];
      
      // Random wandering
      insect.vel.x += (Math.random() - 0.5) * 0.000001;
      insect.vel.y += (Math.random() - 0.5) * 0.0000005;
      insect.vel.z += (Math.random() - 0.5) * 0.000001;
      
      // Speed limit
      const speed = insect.vel.length();
      if (speed > 0.0002) insect.vel.multiplyScalar(0.0002 / speed);
      
      pos[i3] += insect.vel.x;
      pos[i3 + 1] += insect.vel.y;
      pos[i3 + 2] += insect.vel.z;
      
      // Boundaries
      if (Math.abs(pos[i3]) > 0.3) insect.vel.x *= -1;
      if (pos[i3 + 1] < 0.003 || pos[i3 + 1] > 0.06) insect.vel.y *= -1;
      if (Math.abs(pos[i3 + 2]) > 0.3) insect.vel.z *= -1;
    }
    insectSystem.geometry.attributes.position.needsUpdate = true;
  }
  
  // Sun rays moving (wind)
  sun.position.x = 0.3 + Math.sin(time * 0.5) * 0.1;
  
  // Movement scaled to player size
  if (!renderer.xr.isPresenting) {
    const speed = playerScale * 5 * delta * 60; // 5x height per second, frame-independent
    const forward = new THREE.Vector3(0, 0, -1);
    const right = new THREE.Vector3(1, 0, 0);
    
    forward.applyQuaternion(camera.quaternion);
    right.applyQuaternion(camera.quaternion);
    
    camera.position.addScaledVector(forward, (move.f - move.b) * speed);
    camera.position.addScaledVector(right, (move.r - move.l) * speed);
    camera.position.y += (move.u - move.d) * speed;
    
    // Ground collision (keep above surface)
    const minHeight = playerScale * 0.5; // Half player height above ground
    if (camera.position.y < minHeight) {
      camera.position.y = minHeight;
    }
    
    camera.rotation.order = 'YXZ';
    camera.rotation.y = -mouseX;
    camera.rotation.x = -mouseY;
  }
  
  renderer.render(scene, camera);
}

renderer.setAnimationLoop(animate);

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
