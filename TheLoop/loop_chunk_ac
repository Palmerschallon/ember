        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 2000);
        camera.position.set(0, 5, 0);
        
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.2;
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        document.body.appendChild(renderer.domElement);

        // ═══════════════════════════════════════════════════════════════
        // PHOTOREALISTIC SHADERS
        // ═══════════════════════════════════════════════════════════════

        // ADVANCED BRICK SHADER with Normal Mapping
        const brickShader = {
            vertexShader: `
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                varying vec3 vViewPosition;
                
                void main() {
                    vUv = uv * vec2(4.0, 8.0);
                    vNormal = normalize(normalMatrix * normal);
                    vPosition = position;
                    
                    vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                    vViewPosition = -mvPosition.xyz;
                    
                    gl_Position = projectionMatrix * mvPosition;
                }
            `,
            fragmentShader: `
                uniform float time;
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                varying vec3 vViewPosition;
                
                // Noise functions
                float hash(vec2 p) {
                    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
                }
                
                float noise(vec2 p) {
                    vec2 i = floor(p);
                    vec2 f = fract(p);
                    f = f * f * (3.0 - 2.0 * f);
                    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
                               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
                }
                
                void main() {
                    // Brick pattern with mortar
                    vec2 uv = vUv;
                    vec2 brickSize = vec2(2.0, 1.0);
                    vec2 brickUV = fract(uv / brickSize);
                    
                    // Offset every other row
                    float row = floor(uv.y / brickSize.y);
                    brickUV.x += mod(row, 2.0) * 0.5;
                    brickUV = fract(brickUV);
                    
                    // Mortar lines
                    float mortarWidth = 0.05;
                    float isMortar = step(brickUV.x, mortarWidth) + 
                                    step(1.0 - mortarWidth, brickUV.x) + 
                                    step(brickUV.y, mortarWidth) + 
                                    step(1.0 - mortarWidth, brickUV.y);
                    isMortar = clamp(isMortar, 0.0, 1.0);
                    
                    // Brick color variation
                    float variation = noise(floor(uv / brickSize) * 10.0);
                    vec3 brickColor = vec3(0.6, 0.2, 0.1) * (0.8 + variation * 0.4);
                    vec3 mortarColor = vec3(0.7, 0.7, 0.65);
                    
                    // Weathering - darker near bottom
                    float weathering = smoothstep(0.0, 20.0, vPosition.y);
                    brickColor *= (0.6 + weathering * 0.4);
                    
                    // Dirt accumulation
                    float dirt = noise(vUv * 20.0) * (1.0 - weathering) * 0.3;
                    brickColor *= (1.0 - dirt);
                    
                    vec3 color = mix(brickColor, mortarColor, isMortar);
                    
                    // Fake normal mapping for depth
                    float normalOffset = (1.0 - isMortar) * 0.3;
                    vec3 normal = normalize(vNormal + vec3(0.0, 0.0, normalOffset));
                    
                    // Lighting
                    vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));
                    float diff = max(dot(normal, lightDir), 0.0);
                    vec3 ambient = vec3(0.3);
                    vec3 diffuse = vec3(1.0, 0.95, 0.9) * diff;
                    
                    color *= (ambient + diffuse);
                    
                    // Roughness
                    float roughness = 0.9;
                    
                    gl_FragColor = vec4(color, 1.0);
                }
            `,
            uniforms: {
                time: { value: 0 }
            }
        };

        // ADVANCED GLASS SHADER with Reflections & PBR
        const glassShader = {
            vertexShader: `
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                varying vec3 vReflect;
                varying vec3 vViewPosition;
                
                void main() {
                    vUv = uv * vec2(10.0, 20.0);
                    vNormal = normalize(normalMatrix * normal);
                    vPosition = position;
                    
                    vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
                    vViewPosition = -mvPosition.xyz;
                    
                    vec3 worldNormal = normalize(mat3(modelMatrix) * normal);
                    vec3 worldPosition = (modelMatrix * vec4(position, 1.0)).xyz;
                    vec3 cameraToVertex = normalize(worldPosition - cameraPosition);
                    vReflect = reflect(cameraToVertex, worldNormal);
                    
                    gl_Position = projectionMatrix * mvPosition;
                }
            `,
            fragmentShader: `
                uniform float time;
                uniform vec3 skyColor;
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                varying vec3 vReflect;
                varying vec3 vViewPosition;
                
                float hash(vec2 p) {
                    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
                }
                
                void main() {
                    // Window grid pattern
                    vec2 windowGrid = fract(vUv);
                    float frameWidth = 0.03;
                    float isFrame = step(windowGrid.x, frameWidth) + 
                                   step(1.0 - frameWidth, windowGrid.x) + 
                                   step(windowGrid.y, frameWidth) + 
                                   step(1.0 - frameWidth, windowGrid.y);
                    isFrame = clamp(isFrame, 0.0, 1.0);
                    
                    // Random window lights (some on, some off)
                    vec2 windowID = floor(vUv);
                    float lightOn = step(0.6, hash(windowID));
                    
                    // Interior glow
                    vec3 interiorColor = vec3(1.0, 0.9, 0.7) * lightOn * 0.3;
                    
                    // Glass base color (slight blue tint)
                    vec3 glassColor = vec3(0.6, 0.7, 0.8);
                    
                    // Sky reflection
                    vec3 reflection = skyColor * 0.5;
                    
                    // Fresnel effect (more reflective at angles)
                    vec3 viewDir = normalize(vViewPosition);
                    float fresnel = pow(1.0 - abs(dot(viewDir, vNormal)), 3.0);
                    
                    // Combine
                    vec3 color = mix(glassColor + interiorColor, reflection, fresnel * 0.7);
                    
                    // Window frames
                    vec3 frameColor = vec3(0.2, 0.2, 0.25);
                    color = mix(color, frameColor, isFrame);
                    
                    // Metalness for frames
                    float metalness = isFrame;
                    
                    gl_FragColor = vec4(color, 1.0);
                }
            `,
            uniforms: {
                time: { value: 0 },
                skyColor: { value: new THREE.Color(0x87ceeb) }
            }
        };

        // ADVANCED CONCRETE SHADER with Weathering
        const concreteShader = {
            vertexShader: `
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                
                void main() {
                    vUv = uv * 5.0;
                    vNormal = normalize(normalMatrix * normal);
                    vPosition = position;
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                }
            `,
            fragmentShader: `
                uniform float time;
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vPosition;
                
                float hash(vec2 p) {
                    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
                }
                
                float noise(vec2 p) {
                    vec2 i = floor(p);
                    vec2 f = fract(p);
                    f = f * f * (3.0 - 2.0 * f);
                    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
                               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
                }
                
                float fbm(vec2 p) {
                    float value = 0.0;
                    float amplitude = 0.5;
                    for(int i = 0; i < 4; i++) {
                        value += amplitude * noise(p);
                        p *= 2.0;
                        amplitude *= 0.5;
                    }
                    return value;
                }
                
                void main() {
                    // Base concrete color
                    vec3 baseColor = vec3(0.5, 0.52, 0.50);
                    
                    // Surface roughness
                    float roughness = fbm(vUv * 10.0);
                    baseColor *= (0.8 + roughness * 0.4);
                    
                    // Cracks
                    float cracks = step(0.95, noise(vUv * 30.0));
                    baseColor *= (1.0 - cracks * 0.5);
                    
                    // Weathering - stains near bottom
                    float stain = smoothstep(5.0, 0.0, vPosition.y) * noise(vUv * 5.0);
                    baseColor *= (1.0 - stain * 0.4);
                    
                    // Rust stains
                    float rust = step(0.8, noise(vUv * 15.0 + vec2(0.5))) * 
                                smoothstep(10.0, 0.0, vPosition.y);
                    vec3 rustColor = vec3(0.6, 0.3, 0.1);
                    baseColor = mix(baseColor, rustColor, rust * 0.3);
                    
                    // Lighting
                    vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));
                    float diff = max(dot(vNormal, lightDir), 0.0);
                    vec3 ambient = vec3(0.3);
                    vec3 diffuse = vec3(1.0) * diff;
                    
                    vec3 color = baseColor * (ambient + diffuse);
                    
                    gl_FragColor = vec4(color, 1.0);
                }
            `,
            uniforms: {
                time: { value: 0 }
            }
        };

        // ═══════════════════════════════════════════════════════════════
        // DYNAMIC LIGHTING
        // ═══════════════════════════════════════════════════════════════
        
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
        scene.add(ambientLight);
        
        const sun = new THREE.DirectionalLight(0xffffff, 1.2);
        sun.position.set(50, 100, 50);
        sun.castShadow = true;
        sun.shadow.camera.left = -200;
        sun.shadow.camera.right = 200;
        sun.shadow.camera.top = 200;
        sun.shadow.camera.bottom = -200;
        sun.shadow.camera.far = 500;
        sun.shadow.mapSize.width = 2048;
        sun.shadow.mapSize.height = 2048;
        scene.add(sun);

        function updateTimeOfDay(hour) {
            gameState.time = hour;
            
            // Sun position
            const angle = (hour / 24) * Math.PI * 2 - Math.PI / 2;
            sun.position.x = Math.cos(angle) * 100;
            sun.position.y = Math.sin(angle) * 100 + 20;
            sun.position.z = 50;
            
            // Sky color
            let skyColor, sunIntensity, ambientIntensity;
            if (hour >= 6 && hour < 8) {
                // Dawn
                skyColor = new THREE.Color(0xff9966);
                sunIntensity = 0.6;
                ambientIntensity = 0.3;
            } else if (hour >= 8 && hour < 18) {
                // Day
                skyColor = new THREE.Color(0x87ceeb);
                sunIntensity = 1.2;
                ambientIntensity = 0.4;
            } else if (hour >= 18 && hour < 20) {
                // Dusk
                skyColor = new THREE.Color(0xff6633);
                sunIntensity = 0.4;
                ambientIntensity = 0.2;
            } else {
                // Night
                skyColor = new THREE.Color(0x001122);
                sunIntensity = 0.1;
                ambientIntensity = 0.1;
            }
            
            scene.background = skyColor;
            scene.fog.color = skyColor;
            sun.intensity = sunIntensity;
            ambientLight.intensity = ambientIntensity;
            sun.color = skyColor;
            
            // Update glass shader to reflect current sky
            glassShader.uniforms.skyColor.value = skyColor;
            
            // Time display
            const displayHour = Math.floor(hour);
            const displayMinute = Math.floor((hour % 1) * 60);
            const ampm = displayHour >= 12 ? 'PM' : 'AM';
            const hour12 = displayHour % 12 || 12;
            document.getElementById('time').textContent = 
                `${hour12}:${displayMinute.toString().padStart(2, '0')} ${ampm}`;
        }

        // ═══════════════════════════════════════════════════════════════
        // CITY GENERATION
        // ═══════════════════════════════════════════════════════════════
        
        const buildings = [];
        const citySize = 20;
        const blockSize = 40;
        const streetWidth = 15;
        
        for (let x = -citySize; x <= citySize; x++) {
            for (let z = -citySize; z <= citySize; z++) {
                // Skip streets
                if (x % 3 === 0 || z % 3 === 0) continue;
                
                const posX = x * blockSize;
                const posZ = z * blockSize;
                
                // Distance from center for zoning
                const distFromCenter = Math.sqrt(posX * posX + posZ * posZ);
                
                let geometry, material, height;
                
                if (distFromCenter < 150) {
                    // Downtown - Glass towers
                    height = 40 + Math.random() * 80;
                    geometry = new THREE.BoxGeometry(
                        30 + Math.random() * 10,
                        height,
                        30 + Math.random() * 10
                    );
                    material = new THREE.ShaderMaterial(glassShader);
                } else if (distFromCenter < 400) {
                    // Residential - Brick
                    height = 15 + Math.random() * 25;
                    geometry = new THREE.BoxGeometry(
                        25 + Math.random() * 15,
                        height,
                        25 + Math.random() * 15
                    );
                    material = new THREE.ShaderMaterial(brickShader);
                } else {
                    // Industrial - Concrete
                    height = 10 + Math.random() * 20;
                    geometry = new THREE.BoxGeometry(
                        35 + Math.random() * 20,
                        height,
                        35 + Math.random() * 20
                    );
                    material = new THREE.ShaderMaterial(concreteShader);
                }
                
                const building = new THREE.Mesh(geometry, material);
                building.position.set(posX, height / 2, posZ);
                building.castShadow = true;
                building.receiveShadow = true;
                scene.add(building);
                buildings.push(building);
            }
        }

        // Ground
        const groundGeo = new THREE.PlaneGeometry(5000, 5000);
        const groundMat = new THREE.MeshStandardMaterial({ 
            color: 0x333333,
            roughness: 0.8,
            metalness: 0.2
        });
        const ground = new THREE.Mesh(groundGeo, groundMat);
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        scene.add(ground);

        // ═══════════════════════════════════════════════════════════════
        // NPCs WITH AI
        // ═══════════════════════════════════════════════════════════════
        
        const npcs = [];
        const npcPersonalities = [
            { name: "Marcus", role: "Street Vendor", personality: "friendly, knows gossip, helpful" },
            { name: "Dr. Chen", role: "Scientist", personality: "brilliant, paranoid, investigating conspiracy" },
            { name: "Sofia", role: "Journalist", personality: "curious, brave, looking for truth" },
            { name: "Rico", role: "Gang Member", personality: "tough, loyal to crew, distrustful" },
            { name: "Maya", role: "Hacker", personality: "sarcastic, genius, wants revenge" },
            { name: "Detective Kane", role: "Cop", personality: "jaded, seen too much, secretly good" },
            { name: "Luna", role: "Artist", personality: "eccentric, visionary, knows secrets" },
            { name: "Tomas", role: "Bartender", personality: "wise, knows everyone, neutral" },
        ];
        
        npcPersonalities.forEach((npcData, i) => {
            const npcGeo = new THREE.CapsuleGeometry(0.5, 1.5, 4, 8);
            const npcMat = new THREE.MeshStandardMaterial({ 
                color: 0x00ffff,
                emissive: 0x00ffff,
                emissiveIntensity: 0.5
            });
            const npc = new THREE.Mesh(npcGeo, npcMat);
            
            // Scatter around city
            const angle = (i / npcPersonalities.length) * Math.PI * 2;
            const radius = 50 + Math.random() * 100;
            npc.position.set(
                Math.cos(angle) * radius,
                1.5,
                Math.sin(angle) * radius
            );
            
            npc.userData = {
                ...npcData,
                id: `npc_${i}`,
                memory: [],
                questsGiven: [],
                lastInteraction: null
            };
            
            scene.add(npc);
            npcs.push(npc);
            gameState.relationships[npc.userData.id] = 0; // Neutral
        });

        // ═══════════════════════════════════════════════════════════════
        // BACKEND API CONNECTION
        // ═══════════════════════════════════════════════════════════════
        
        const API_BASE = 'http://localhost:5555';
        let backendAvailable = false;
        
        async function checkBackend() {
            try {
                const response = await fetch(`${API_BASE}/status`);
                const data = await response.json();
                backendAvailable = data.status === 'running';
                console.log('🔥 Backend connected:', data);
                return true;
            } catch (error) {
                backendAvailable = false;
                console.warn('⚠️  Backend not available, using fallback dialogue');
                return false;
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // NPC DIALOGUE (Real AI Integration)
        // ═══════════════════════════════════════════════════════════════
        
        async function generateNPCDialogue(npc, playerMessage = null) {
            if (backendAvailable) {
                try {
                    const response = await fetch(`${API_BASE}/talk`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            npc_id: npc.userData.id,
                            message: playerMessage
                        })
                    });
                    
                    const data = await response.json();
                    console.log('🦙 Llama response:', data);
                    
                    return {
                        dialogue: data.dialogue,
                        quest: data.quest,
                        relationshipChange: 0, // Backend handles this
                        mood: data.mood
                    };
                } catch (error) {
                    console.error('Backend dialogue failed:', error);
                    // Fall through to fallback
                }
            }
            
            // FALLBACK: Simple procedural dialogue when backend unavailable
            const isFirstMeet = npc.userData.memory.length === 0;
            
            if (isFirstMeet) {
                return {
                    dialogue: `Hey, I'm ${npc.userData.name}. ${npc.userData.role}. What do you want?`,
                    relationshipChange: 1
                };
            } else if (playerMessage) {
                return {
                    dialogue: `Interesting... I'll have to think about that. Check back later.`,
                    relationshipChange: 1
                };
            } else {
                const quests = [
                    {
                        dialogue: `I've got a job for you. Interested in making some cash?`,
                        quest: {
                            title: "Delivery Run",
                            description: "Take a package to the docks. Don't ask questions.",
                            type: "delivery",
                            reward: "$5,000"
                        },
                        relationshipChange: 5
                    },
                    {
                        dialogue: `You look like someone who can handle themselves. I need help.`,
                        quest: {
                            title: "Missing Person",
                            description: `${npc.userData.name}'s friend vanished. Find them.`,
                            type: "investigation",
                            reward: "Information + $3,000"
                        },
                        relationshipChange: 10
                    },
                    {
                        dialogue: `Glad to see you again. Things have been quiet. Too quiet.`,
                        relationshipChange: 2
                    }
                ];
                
                return quests[Math.floor(Math.random() * quests.length)];
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // PLAYER CONTROLS
        // ═══════════════════════════════════════════════════════════════
        
        const movement = { forward: 0, backward: 0, left: 0, right: 0, up: 0, down: 0 };
        const velocity = new THREE.Vector3();
        const direction = new THREE.Vector3();
        let pointerLocked = false;
        let mouseX = 0, mouseY = 0;
        let yaw = 0, pitch = 0;
        
        window.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') movement.forward = 1;
            if (k === 's') movement.backward = 1;
            if (k === 'a') movement.left = 1;
            if (k === 'd') movement.right = 1;
            if (k === ' ') { movement.up = 1; e.preventDefault(); }
            if (k === 'shift') movement.down = 1;
            if (k === 't') {
                gameState.time = (gameState.time + 1) % 24;
                updateTimeOfDay(gameState.time);
            }
            if (k === 'tab') {
                e.preventDefault();
                const questLog = document.getElementById('quest-log');
                questLog.style.display = questLog.style.display === 'none' ? 'block' : 'none';
            }
        });
        
        window.addEventListener('keyup', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') movement.forward = 0;
            if (k === 's') movement.backward = 0;
            if (k === 'a') movement.left = 0;
            if (k === 'd') movement.right = 0;
            if (k === ' ') movement.up = 0;
            if (k === 'shift') movement.down = 0;
        });
        
        document.addEventListener('mousemove', (e) => {
            if (!pointerLocked) return;
            mouseX = e.movementX || 0;
            mouseY = e.movementY || 0;
            yaw -= mouseX * 0.002;
            pitch -= mouseY * 0.002;
            pitch = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, pitch));
        });
        
        document.addEventListener('click', async (e) => {
            if (document.getElementById('instructions').style.display !== 'none') {
                document.getElementById('instructions').style.display = 'none';
                document.body.requestPointerLock();
                updateTimeOfDay(gameState.time);
                return;
            }
            
            // NPC interaction
            if (pointerLocked) {
                const raycaster = new THREE.Raycaster();
                raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
                const intersects = raycaster.intersectObjects(npcs);
                
                if (intersects.length > 0) {
                    const clickedNPC = intersects[0].object;
                    await interactWithNPC(clickedNPC);
                }
            }
        });
        
        document.addEventListener('pointerlockchange', () => {
            pointerLocked = document.pointerLockElement === document.body;
        });

        // ═══════════════════════════════════════════════════════════════
        // NPC INTERACTION
        // ═══════════════════════════════════════════════════════════════
        
        let currentNPC = null;
        
        async function interactWithNPC(npc) {
            currentNPC = npc;
            const dialogue = await generateNPCDialogue(npc);
            
            // Update relationship
            if (dialogue.relationshipChange) {
                gameState.relationships[npc.userData.id] += dialogue.relationshipChange;
                gameState.relationships[npc.userData.id] = Math.max(-100, Math.min(100, gameState.relationships[npc.userData.id]));
            }
            
            // Record memory
            npc.userData.memory.push({
                time: gameState.time,
                interaction: dialogue.dialogue
            });
            
            // Show dialogue
            document.getElementById('dialogue-speaker').textContent = npc.userData.name;
            document.getElementById('dialogue-text').textContent = dialogue.dialogue;
            document.getElementById('dialogue-box').style.display = 'block';
            document.getElementById('dialogue-input').value = '';
            document.getElementById('dialogue-input').focus();
            
            // Speak dialogue
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(dialogue.dialogue);
                utterance.rate = 0.9;
                speechSynthesis.speak(utterance);
            }
            
            // Add quest if offered
            if (dialogue.quest) {
                gameState.activeQuests.push(dialogue.quest);
                updateQuestLog();
                showNotification(`New Quest: ${dialogue.quest.title}`);
            }
        }
        
        document.getElementById('dialogue-input').addEventListener('keydown', async (e) => {
            if (e.key === 'Enter' && currentNPC) {
                const playerMessage = e.target.value;
                if (playerMessage.trim()) {
                    gameState.playerActions.push({
                        type: 'dialogue',
                        npc: currentNPC.userData.id,
                        message: playerMessage,
                        time: gameState.time
                    });
                    
                    const response = await generateNPCDialogue(currentNPC, playerMessage);
                    document.getElementById('dialogue-text').textContent = response.dialogue;
                    
                    if ('speechSynthesis' in window) {
                        const utterance = new SpeechSynthesisUtterance(response.dialogue);
                        utterance.rate = 0.9;
                        speechSynthesis.speak(utterance);
                    }
                    
                    e.target.value = '';
                }
            }
            if (e.key === 'Escape') {
                document.getElementById('dialogue-box').style.display = 'none';
                currentNPC = null;
            }
        });

        function updateQuestLog() {
            const questList = document.getElementById('quest-list');
            questList.innerHTML = gameState.activeQuests.map(q => 
                `<div class="quest-item">• ${q.title}</div>`
            ).join('');
        }

        function showNotification(message) {
            const notif = document.getElementById('notification');
            notif.textContent = message;
            notif.style.display = 'block';
            setTimeout(() => {
                notif.style.display = 'none';
