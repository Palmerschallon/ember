function animate() {
    renderer.setAnimationLoop(animate);
    
    const delta = clock.getDelta();
    const time = performance.now();
    
    // Desktop movement
    if (!renderer.xr.isPresenting) {
        const speed = 3 * delta;
        const direction = new THREE.Vector3();
        direction.z = movement.backward - movement.forward;
        direction.x = movement.right - movement.left;
        direction.normalize();
        
        const forward = new THREE.Vector3(0, 0, -1);
        const right = new THREE.Vector3(1, 0, 0);
        forward.applyEuler(new THREE.Euler(0, yaw, 0));
        right.applyEuler(new THREE.Euler(0, yaw, 0));
        
        velocity.copy(forward).multiplyScalar(direction.z);
        velocity.add(right.clone().multiplyScalar(direction.x));
        velocity.multiplyScalar(speed);
        
        camera.position.add(velocity);
        camera.position.x = Math.max(-4.5, Math.min(4.5, camera.position.x));
        camera.position.z = Math.max(-5.5, Math.min(5.5, camera.position.z));
        camera.position.y = 1.7;
        camera.rotation.set(pitch, yaw, 0);
    }
    
    // Update body in VR
    if (renderer.xr.isPresenting) {
        updateBody();
    }
    
    // Update city view
    drawCityView(time);
    cityTexture.needsUpdate = true;
    
    // Animate particles
    const positions = particleGeo.attributes.position.array;
    for (let i = 0; i < positions.length; i += 3) {
        positions[i] += particleVelocities[i];
        positions[i + 1] += particleVelocities[i + 1];
        positions[i + 2] += particleVelocities[i + 2];
        
        if (positions[i + 1] > 4) positions[i + 1] = 0;
        if (positions[i] < -5 || positions[i] > 5) particleVelocities[i] *= -1;
        if (positions[i + 2] < -6 || positions[i + 2] > 6) particleVelocities[i + 2] *= -1;
    }
    particleGeo.attributes.position.needsUpdate = true;
    
    // Door hint
    const distToDoor = camera.position.distanceTo(door.position);
    const hint = document.getElementById('hint');
    if (distToDoor < 2.5 && !doorOpen) {
        hint.textContent = '🚪 Press E to open door';
        hint.style.color = '#ff6600';
    } else {
        hint.textContent = '';
    }
    
    // FPS counter
    frames++;
    const now = performance.now();
    if (now >= lastTime + 1000) {
        document.getElementById('fps').textContent = `FPS: ${frames}`;
        frames = 0;
        lastTime = now;
    }
    
    renderer.render(scene, camera);
}

animate();

