class GPT4Director:
    def __init__(self, api_key: Optional[str] = None):
        self.client = None
        
        if GPT4_AVAILABLE:
            api_key = api_key or os.getenv('OPENAI_API_KEY')
            if api_key:
                self.client = OpenAI(api_key=api_key)
                print("✅ GPT-4 Director initialized!")
            else:
                print("⚠️  No OpenAI API key - Director disabled")
    
    def generate_story_arc(self, world_state: WorldState, recent_events: List[Dict], npcs: List[NPCState]) -> Optional[StoryArc]:
        """Generate a multi-episode story arc based on world state"""
        if not self.client:
            return self._fallback_story_arc(world_state, recent_events, npcs)
        
        # Build context
        context = self._build_director_context(world_state, recent_events, npcs)
        
        system_prompt = """You are the narrative director for GTA 7: Ember Edition.
Your job is to create emergent, multi-episode story arcs based on player actions and world state.

Rules:
1. Stories emerge from player actions, not scripts
2. NPCs have goals and react to player
3. Create consequences and cascading effects
4. Stories should feel organic, not forced
5. Each arc has 5-15 episodes

Generate a story arc as JSON:
{
  "title": "Story arc name",
  "episodes": [
    {
      "id": 1,
      "title": "Episode title",
      "trigger": "What starts this episode",
      "npcs": ["npc_ids involved"],
      "events": ["What happens"],
      "consequences": ["How world changes"]
    }
  ],
  "involved_npcs": ["npc_ids"],
  "themes": ["revenge", "corruption", etc]
}"""

        try:
            response = self.client.chat.completions.create(
                model="gpt-4",
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": context}
                ],
                temperature=0.9,
                max_tokens=2000
            )
            
            arc_data = json.loads(response.choices[0].message.content)
            
            return StoryArc(
                id=f"arc_{int(time.time())}",
                title=arc_data['title'],
                episodes=arc_data['episodes'],
                involved_npcs=arc_data['involved_npcs'],
                status="active",
                created_at=time.time()
            )
        
        except Exception as e:
            print(f"❌ GPT-4 story generation failed: {e}")
            return self._fallback_story_arc(world_state, recent_events, npcs)
    
    def _build_director_context(self, world_state: WorldState, recent_events: List[Dict], npcs: List[NPCState]) -> str:
        return f"""Current World State:
- Time: {world_state.time}
- Player reputation: {world_state.reputation}
- Active quests: {len(world_state.active_quests)}
- Recent events: {len(recent_events)}

Recent Player Actions:
{json.dumps(world_state.player_actions[-5:], indent=2)}

NPC States:
{self._format_npcs(npcs)}

Recent Events:
{json.dumps(recent_events[-10:], indent=2)}

Based on this, what story arc should emerge?"""
    
    def _format_npcs(self, npcs: List[NPCState]) -> str:
        return "\n".join([
            f"- {npc.name} ({npc.role}): Mood {npc.mood}, Goals: {', '.join(npc.goals[:2])}"
            for npc in npcs
        ])
    
    def _fallback_story_arc(self, world_state: WorldState, recent_events: List[Dict], npcs: List[NPCState]) -> StoryArc:
        """Simple fallback story when GPT-4 isn't available"""
        return StoryArc(
            id=f"arc_{int(time.time())}",
            title="The City's Secrets",
            episodes=[
                {
                    "id": 1,
                    "title": "Strange Encounters",
                    "trigger": "Player explores city",
                    "npcs": [npcs[0].id if npcs else "npc_0"],
                    "events": ["NPC approaches with mysterious information"],
                    "consequences": ["New quest available"]
                }
            ],
            involved_npcs=[npcs[0].id if npcs else "npc_0"],
            status="active",
            created_at=time.time()
        )

