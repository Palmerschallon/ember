      const px=bx*40+jitter();
      const pz=bz*40+jitter();
      const dist=Math.sqrt(px*px+pz*pz);
      
      let zone;
      if(dist<100)zone='commercial';
      else if(Math.abs(bx)>7||Math.abs(bz)>7)zone='industrial';
      else zone='residential';
      
      const b=makeBuilding(px,pz,buildingSeed++,zone);
      buildings.push(b);
      scene.add(b);
    }
  }
}

