            gap: 8px;
            padding: 10px 20px;
            background: rgba(255, 107, 53, 0.1);
            border: 1px solid rgba(255, 107, 53, 0.3);
            border-radius: 8px;
            color: #ff6b35;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            margin-left: auto;
            margin-right: 20px;
        }

        .gallery-btn:hover {
            background: rgba(255, 107, 53, 0.2);
            border-color: #ff6b35;
        }

        /* Gallery Modal */
        .gallery-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(10px);
        }

        .gallery-header {
            padding: 30px;
            border-bottom: 1px solid #333;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .gallery-header h2 {
            margin: 0;
            font-size: 24px;
            color: #ff6b35;
        }

        .gallery-filters {
            display: flex;
            gap: 10px;
        }

        .filter-btn {
            padding: 8px 16px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 6px;
            color: #888;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .filter-btn.active {
            background: rgba(255, 107, 53, 0.1);
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .gallery-close {
            margin-left: auto;
            background: none;
            border: none;
            font-size: 32px;
            color: #888;
            cursor: pointer;
            transition: color 0.2s;
        }

        .gallery-close:hover {
            color: #ff6b35;
        }

        .gallery-grid {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            align-content: start;
        }

        .gallery-item {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .gallery-item.broken {
            border-color: #ef4444;
            opacity: 0.6;
        }

        .gallery-item.broken::after {
            content: '⚠️ BROKEN';
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }

        .gallery-item:hover {
            border-color: #ff6b35;
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(255, 107, 53, 0.3);
        }

        .repair-btn {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: #ef4444;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            cursor: pointer;
            z-index: 10;
        }

        .repair-btn:hover {
            background: #dc2626;
        }

        .social-actions {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(10px);
            padding: 10px;
            display: flex;
            gap: 8px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .gallery-item:hover .social-actions {
            opacity: 1;
        }

        .social-btn {
            flex: 1;
            padding: 6px;
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 6px;
            color: #888;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .social-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .social-btn.liked {
            border-color: #ef4444;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }

        .social-count {
            font-weight: 600;
        }

        .gallery-item-preview {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: #0a0a0a;
        }

        .gallery-item-info {
            padding: 15px;
        }

        .gallery-item-name {
            font-size: 13px;
            color: #e0e0e0;
            margin-bottom: 5px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .gallery-item-date {
            font-size: 11px;
            color: #666;
        }

        .gallery-pagination {
            padding: 20px 30px;
            border-top: 1px solid #333;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .page-btn {
            padding: 8px 16px;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 6px;
            color: #888;
            cursor: pointer;
            transition: all 0.2s;
        }

        .page-btn:hover {
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .page-btn.active {
            background: rgba(255, 107, 53, 0.1);
            border-color: #ff6b35;
            color: #ff6b35;
        }

        .page-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        /* HTML Preview Modal */
        .html-preview-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.98);
            z-index: 10001;
            display: flex;
            flex-direction: column;
        }

        .html-preview-header {
            padding: 15px 30px;
            background: #1a1a1a;
            border-bottom: 1px solid #333;
            display: flex;
