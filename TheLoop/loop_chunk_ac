### 5. **SPATIAL PARTITIONING** (Fast Collision/Queries)

**The Concept:**
> "Organize world spatially for O(log n) queries instead of O(n)"

**Octree Example:**
```javascript
class Octree {
    constructor(bounds, capacity = 8) {
        this.bounds = bounds;
        this.capacity = capacity;
        this.objects = [];
        this.divided = false;
        this.children = [];
    }
    
    insert(object) {
        if (!this.bounds.containsPoint(object.position)) return false;
        
        if (this.objects.length < this.capacity) {
            this.objects.push(object);
            return true;
        }
        
        if (!this.divided) this.subdivide();
        
        for (const child of this.children) {
            if (child.insert(object)) return true;
        }
    }
    
    query(range, found = []) {
        if (!this.bounds.intersectsBox(range)) return found;
        
        for (const obj of this.objects) {
            if (range.containsPoint(obj.position)) {
                found.push(obj);
            }
        }
        
        if (this.divided) {
            for (const child of this.children) {
                child.query(range, found);
            }
        }
        
        return found;
    }
}
```

