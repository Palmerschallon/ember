# SEMANTIC MESH (World Memory)
# ═══════════════════════════════════════════════════════════════

class SemanticMesh:
    def __init__(self, db_path: str):
        self.db_path = db_path
        self.init_db()
    
    def init_db(self):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        
        # NPC states
        c.execute('''CREATE TABLE IF NOT EXISTS npc_states (
            id TEXT PRIMARY KEY,
            data TEXT
        )''')
        
        # World state
        c.execute('''CREATE TABLE IF NOT EXISTS world_state (
            key TEXT PRIMARY KEY,
            value TEXT
        )''')
        
        # Events log (for emergence tracking)
        c.execute('''CREATE TABLE IF NOT EXISTS events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp REAL,
            event_type TEXT,
            data TEXT
        )''')
        
        # Story arcs
        c.execute('''CREATE TABLE IF NOT EXISTS story_arcs (
            id TEXT PRIMARY KEY,
            data TEXT,
            status TEXT,
            created_at REAL
        )''')
        
        # NPC interactions (for gossip network)
        c.execute('''CREATE TABLE IF NOT EXISTS interactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp REAL,
            npc1 TEXT,
            npc2 TEXT,
            interaction_type TEXT,
            data TEXT
        )''')
        
        conn.commit()
        conn.close()
    
    def save_npc(self, npc: NPCState):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('INSERT OR REPLACE INTO npc_states VALUES (?, ?)',
                  (npc.id, json.dumps(asdict(npc))))
        conn.commit()
        conn.close()
    
    def load_npc(self, npc_id: str) -> Optional[NPCState]:
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('SELECT data FROM npc_states WHERE id = ?', (npc_id,))
        row = c.fetchone()
        conn.close()
        if row:
            return NPCState(**json.loads(row[0]))
        return None
    
    def log_event(self, event_type: str, data: Dict):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('INSERT INTO events (timestamp, event_type, data) VALUES (?, ?, ?)',
                  (time.time(), event_type, json.dumps(data)))
        conn.commit()
        conn.close()
    
    def get_recent_events(self, limit: int = 50) -> List[Dict]:
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('SELECT timestamp, event_type, data FROM events ORDER BY id DESC LIMIT ?', (limit,))
        rows = c.fetchall()
        conn.close()
        return [{'timestamp': r[0], 'type': r[1], 'data': json.loads(r[2])} for r in rows]
    
    def save_world_state(self, state: WorldState):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('INSERT OR REPLACE INTO world_state VALUES (?, ?)',
                  ('current', json.dumps(asdict(state))))
        conn.commit()
        conn.close()
    
    def load_world_state(self) -> Optional[WorldState]:
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('SELECT value FROM world_state WHERE key = ?', ('current',))
        row = c.fetchone()
        conn.close()
        if row:
            return WorldState(**json.loads(row[0]))
        return None
    
    def save_story_arc(self, arc: StoryArc):
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('INSERT OR REPLACE INTO story_arcs VALUES (?, ?, ?, ?)',
                  (arc.id, json.dumps(asdict(arc)), arc.status, arc.created_at))
        conn.commit()
        conn.close()
    
    def get_active_story_arcs(self) -> List[StoryArc]:
        conn = sqlite3.connect(self.db_path)
        c = conn.cursor()
        c.execute('SELECT data FROM story_arcs WHERE status = ?', ('active',))
        rows = c.fetchall()
        conn.close()
        return [StoryArc(**json.loads(r[0])) for r in rows]

