## 🔄 POINT CLOUD IMPORT PIPELINE

### Step 1: Prepare the Data

```python
# If you have .e57 or .las, convert to .ply
import laspy
import numpy as np

# Load LAS file
las = laspy.read('warehouse.las')

# Extract points
points = np.vstack((las.x, las.y, las.z)).T
colors = np.vstack((las.red, las.green, las.blue)).T / 65535  # Normalize

# Save as PLY
from plyfile import PlyData, PlyElement

vertices = np.empty(len(points), dtype=[
    ('x', 'f4'), ('y', 'f4'), ('z', 'f4'),
    ('red', 'u1'), ('green', 'u1'), ('blue', 'u1')
])
vertices['x'] = points[:, 0]
vertices['y'] = points[:, 1]
vertices['z'] = points[:, 2]
vertices['red'] = (colors[:, 0] * 255).astype(np.uint8)
vertices['green'] = (colors[:, 1] * 255).astype(np.uint8)
vertices['blue'] = (colors[:, 2] * 255).astype(np.uint8)

el = PlyElement.describe(vertices, 'vertex')
PlyData([el]).write('warehouse.ply')
```

### Step 2: Optimize for Web

```python
# Reduce point count (if needed)
import open3d as o3d

pcd = o3d.io.read_point_cloud('warehouse.ply')

# Downsample if too large (>10M points)
if len(pcd.points) > 10_000_000:
    pcd = pcd.voxel_down_sample(voxel_size=0.05)  # 5cm voxels

# Remove outliers
pcd, _ = pcd.remove_statistical_outlier(nb_neighbors=20, std_ratio=2.0)

# Save optimized version
o3d.io.write_point_cloud('warehouse_optimized.ply', pcd)
```

### Step 3: Convert to Three.js Format

```javascript
// Use PLYLoader in Three.js
import { PLYLoader } from 'three/addons/loaders/PLYLoader.js';

const loader = new PLYLoader();
loader.load('warehouse_optimized.ply', (geometry) => {
    const material = new THREE.PointsMaterial({
        size: 0.01,
        vertexColors: true
    });
    
    const pointCloud = new THREE.Points(geometry, material);
    
    // Center and scale
    geometry.computeBoundingBox();
    const center = geometry.boundingBox.getCenter(new THREE.Vector3());
    pointCloud.position.sub(center);
    
    // Scale to fit your VR space
    const size = geometry.boundingBox.getSize(new THREE.Vector3());
    const scale = 10 / Math.max(size.x, size.y, size.z);  // Fit in 10m
    pointCloud.scale.set(scale, scale, scale);
    
    scene.add(pointCloud);
    
    console.log(`Loaded ${geometry.attributes.position.count} points`);
});
```

