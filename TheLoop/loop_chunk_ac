                    <div class="arc-episodes">
                        ${arc.episodes.slice(0, 5).map((ep, i) => `
                            <div class="episode">
                                <div class="episode-title">${i + 1}. ${ep.title}</div>
                                <div class="episode-trigger">Trigger: ${ep.trigger}</div>
                            </div>
                        `).join('')}
                        ${arc.episodes.length > 5 ? `<div style="text-align: center; color: #666; margin-top: 5px; font-size: 10px;">... ${arc.episodes.length - 5} more episodes</div>` : ''}
                    </div>
                </div>
            `).join('');
        }
        
        function renderEventStream() {
            const container = document.getElementById('event-stream');
            
            if (!events || events.length === 0) {
                container.innerHTML = '<div class="no-data">No events yet. Start interacting to see emergence!</div>';
                return;
            }
            
            // Show last 20 events
            const recentEvents = events.slice(0, 20);
            
            container.innerHTML = recentEvents.map(event => {
                const time = new Date(event.timestamp * 1000).toLocaleTimeString();
                const data = typeof event.data === 'string' ? event.data : JSON.stringify(event.data);
                
                return `
                    <div class="event">
                        <div class="event-time">${time}</div>
                        <div class="event-type">${event.type}</div>
                        <div class="event-data">${data.substring(0, 100)}${data.length > 100 ? '...' : ''}</div>
                    </div>
                `;
            }).join('');
        }
        
        // ═══════════════════════════════════════════════════════════════
        // INITIALIZATION
        // ═══════════════════════════════════════════════════════════════
        
        function init() {
            const canvas = document.getElementById('network-canvas');
            networkGraph = new RelationshipNetwork(canvas);
            
            // Initial fetch
            fetchWorldState();
            fetchEvents();
            fetchStoryArcs();
            
            // Update every 2 seconds
            setInterval(() => {
                fetchWorldState();
                fetchEvents();
                fetchStoryArcs();
            }, 2000);
        }
        
        // Start
        init();
    </script>
