        grain.playbackRate.value = 0.8 + Math.random() * 0.4;
        grain.connect(this.filter);
        grain.start(audioCtx.currentTime);
        grain.stop(audioCtx.currentTime + 0.1);
        
        this.grains.push(grain);
        setTimeout(() => {
            this.grains.shift();
        }, 100);
    }
}

