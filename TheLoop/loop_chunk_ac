                        }
                    }
                    
                    input.disabled = false;
                    input.focus();
                }
            }
        });
        
        // ═══════════════════════════════════════════════════════════════
        // INITIALIZATION
        // ═══════════════════════════════════════════════════════════════
        
        async function init() {
            const connected = await checkStatus();
            if (connected) {
                await loadNPCs();
                
                // Auto-select first NPC
                const firstNPC = Object.keys(allNPCs)[0];
                if (firstNPC) {
                    selectNPC(firstNPC);
                }
            } else {
                setTimeout(init, 2000); // Retry
            }
        }
        
        // Start
        init();
        
        // Periodic status check
        setInterval(checkStatus, 5000);
    </script>
