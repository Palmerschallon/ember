        if npc.relationships.get("player", 0) > 20 and len(npc.memory) > 3:
            quest = self._maybe_generate_quest(npc)
        
        return {
            "dialogue": dialogue,
            "speaker": npc.name,
            "relationship": npc.relationships["player"],
            "mood": npc.mood,
            "quest": quest
        }
    
    def _maybe_generate_quest(self, npc: NPCState) -> Optional[Dict]:
        """NPC might offer a quest"""
        import random
        if random.random() < 0.3:  # 30% chance
            return {
                "title": f"{npc.name}'s Request",
                "description": f"Help {npc.name} with something important.",
                "type": random.choice(["delivery", "investigation", "rescue"]),
                "reward": "$5,000"
            }
        return None
    
    def run_director(self):
        """Director analyzes world state and creates story arcs"""
        now = time.time()
        if now - self.last_director_run < self.director_interval:
            return
        
        print("🎬 Director analyzing world state...")
        
        recent_events = self.mesh.get_recent_events(50)
        npcs = list(self.npcs.values())
        
        # Generate story arc
        arc = self.gpt4_director.generate_story_arc(self.world_state, recent_events, npcs)
        
        if arc:
            self.mesh.save_story_arc(arc)
            self.mesh.log_event("story_arc_created", {"arc_id": arc.id, "title": arc.title})
            print(f"✨ New story arc: {arc.title}")
        
        self.last_director_run = now
    
    def get_world_state(self) -> Dict:
        """Get current world state for visualization"""
        return {
            "time": self.world_state.time,
            "weather": self.world_state.weather,
            "reputation": self.world_state.reputation,
            "active_quests": self.world_state.active_quests,
            "npcs": {npc_id: asdict(npc) for npc_id, npc in self.npcs.items()},
            "story_arcs": [asdict(arc) for arc in self.mesh.get_active_story_arcs()],
            "recent_events": self.mesh.get_recent_events(20)
        }
    
    def update_world_time(self, new_time: float):
        """Update world time"""
        self.world_state.time = new_time % 24
        self.mesh.save_world_state(self.world_state)

