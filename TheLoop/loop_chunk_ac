#### Option 2: Teleportation (Smooth)
```javascript
// Point with controller, press trigger, teleport

controller.addEventListener('selectstart', (event) => {
    // Cast ray from controller
    raycaster.setFromXRController(controller);
    const intersects = raycaster.intersectObject(floor);
    
    if (intersects.length > 0) {
        // Show teleport marker
        teleportMarker.position.copy(intersects[0].point);
        teleportMarker.visible = true;
    }
});

controller.addEventListener('selectend', (event) => {
    // Teleport to marker
    if (teleportMarker.visible) {
        camera.position.copy(teleportMarker.position);
        camera.position.y = 1.7; // Standing height
        teleportMarker.visible = false;
    }
});
