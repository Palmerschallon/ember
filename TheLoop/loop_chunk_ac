    chunk_size = 50
    chunks = {}
    
    print(f"🔪 Splitting into {chunk_size}m x {chunk_size}m chunks...")
    
    for i, point in enumerate(points):
        x, y, z = point
        cx = int((x - mins[0]) // chunk_size)
        cz = int((z - mins[2]) // chunk_size)
        chunk_id = f"{cx}_{cz}"
        
        if chunk_id not in chunks:
            chunks[chunk_id] = {'points': [], 'colors': [], 'cx': cx, 'cz': cz}
        
        chunks[chunk_id]['points'].append(point)
        chunks[chunk_id]['colors'].append(colors[i])
        
        if i % 1000000 == 0:
            print(f"   Processed: {i:,} / {len(points):,} ({i/len(points)*100:.1f}%)")
    
    print(f"✅ Created {len(chunks)} chunks")
    print()
    
