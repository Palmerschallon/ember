            let totalEpisodes = 0;
            arcs.forEach(arc => totalEpisodes += arc.episodes.length);
            document.getElementById('episode-count').textContent = totalEpisodes;
            
            // Emergence score (based on number of interconnected stories)
            const emergenceScore = Math.min(100, arcs.length * 20 + totalEpisodes * 5);
            document.getElementById('emergence-score').textContent = emergenceScore + '%';
            
            container.innerHTML = arcs.map(arc => `
                <div class="story-arc">
