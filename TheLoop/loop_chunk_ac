        // ═══════════════════════════════════════════════════════════════
        // RENDERING
        // ═══════════════════════════════════════════════════════════════
        
        function updateVisualizations() {
            if (!worldState) return;
            
            // Update stats
            const npcCount = Object.keys(worldState.npcs || {}).length;
            document.getElementById('npc-count').textContent = npcCount;
            
            // Calculate connections (relationships with player)
