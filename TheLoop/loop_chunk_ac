class LlamaActor:
    def __init__(self, model_path: str = "meta-llama/Llama-3.2-3B-Instruct"):
        self.model = None
        self.tokenizer = None
        self.device = "cuda" if torch.cuda.is_available() else "cpu"
        
        if LLAMA_AVAILABLE:
            print(f"🦙 Loading Llama 3B Actor on {self.device}...")
            try:
                self.tokenizer = AutoTokenizer.from_pretrained(model_path)
                self.model = AutoModelForCausalLM.from_pretrained(
                    model_path,
                    torch_dtype=torch.float16 if self.device == "cuda" else torch.float32,
                    device_map="auto" if self.device == "cuda" else None
                )
                if self.device == "cpu":
                    self.model = self.model.to(self.device)
                print("✅ Llama 3B Actor loaded!")
            except Exception as e:
                print(f"❌ Failed to load Llama: {e}")
                self.model = None
    
    def generate_dialogue(self, npc: NPCState, context: Dict, player_message: Optional[str] = None) -> str:
        """Generate NPC dialogue based on context"""
        if not self.model:
            # Fallback for testing
            return self._fallback_dialogue(npc, player_message)
        
        # Build prompt
        system_prompt = f"""You are {npc.name}, a {npc.role} in a living city.
Personality: {npc.personality}
Current mood: {npc.mood}
Current goal: {npc.goals[0] if npc.goals else 'None'}

Context:
- Player reputation: {context.get('player_reputation', 0)}
- Your relationship with player: {npc.relationships.get('player', 0)}
- Location: {context.get('location', 'Unknown')}
- Time: {context.get('time', 12.0)}

Recent memories:
{self._format_memories(npc.memory[-3:])}

Respond naturally and in-character. Keep responses under 50 words."""

        if player_message:
            user_prompt = f"Player says: '{player_message}'\n\nRespond as {npc.name}:"
        else:
            user_prompt = f"The player approaches you. Greet them as {npc.name}:"
        
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ]
        
        try:
            # Generate
            inputs = self.tokenizer.apply_chat_template(
                messages,
                return_tensors="pt"
            ).to(self.device)
            
            start_time = time.time()
            
            with torch.no_grad():
                outputs = self.model.generate(
                    inputs,
                    max_new_tokens=100,
                    temperature=0.8,
                    top_p=0.9,
                    do_sample=True,
                    pad_token_id=self.tokenizer.eos_token_id
                )
            
            response_time = (time.time() - start_time) * 1000  # ms
            
            response = self.tokenizer.decode(outputs[0][inputs.shape[1]:], skip_special_tokens=True)
            
            print(f"🦙 Llama response time: {response_time:.0f}ms")
            
            return response.strip()
        
        except Exception as e:
            print(f"❌ Llama generation failed: {e}")
            return self._fallback_dialogue(npc, player_message)
    
    def _format_memories(self, memories: List[Dict]) -> str:
        if not memories:
            return "None"
        return "\n".join([f"- {m.get('interaction', 'Unknown')}" for m in memories[-3:]])
    
    def _fallback_dialogue(self, npc: NPCState, player_message: Optional[str]) -> str:
        """Simple fallback when Llama isn't available"""
        if player_message:
            responses = [
                f"Interesting point. Let me think about that.",
                f"I hear you. That's worth considering.",
                f"Hmm, never thought of it that way.",
            ]
            return responses[hash(player_message) % len(responses)]
        else:
            greetings = [
                f"Hey, I'm {npc.name}. What do you want?",
                f"You talking to me? I'm {npc.name}.",
                f"Yeah? {npc.name} here. What's up?",
            ]
            return greetings[hash(npc.id) % len(greetings)]

