                    this.vy = (this.vy / speed) * maxSpeed;
                }
                
                // Update position
                this.x += this.vx;
                this.y += this.vy;
                
                // Wrap edges
                if (this.x < 0) this.x = canvas.width;
                if (this.x > canvas.width) this.x = 0;
                if (this.y < 0) this.y = canvas.height;
                if (this.y > canvas.height) this.y = 0;
            }
            
            separate(boids) {
                const desiredSeparation = 25;
                let steer = {x: 0, y: 0};
                let count = 0;
                
                for (let other of boids) {
                    const d = this.distance(other);
                    if (d > 0 && d < desiredSeparation) {
                        let diff = {
                            x: this.x - other.x,
                            y: this.y - other.y
                        };
                        diff.x /= d;
                        diff.y /= d;
                        steer.x += diff.x;
                        steer.y += diff.y;
                        count++;
                    }
                }
                
                if (count > 0) {
                    steer.x /= count;
                    steer.y /= count;
                }
                
                return steer;
            }
            
            align(boids) {
                const neighborDist = 50;
                let sum = {x: 0, y: 0};
                let count = 0;
                
                for (let other of boids) {
                    const d = this.distance(other);
                    if (d > 0 && d < neighborDist) {
                        sum.x += other.vx;
                        sum.y += other.vy;
                        count++;
                    }
                }
                
                if (count > 0) {
                    sum.x /= count;
                    sum.y /= count;
                    return {x: sum.x * 0.1, y: sum.y * 0.1};
                }
                
                return {x: 0, y: 0};
            }
            
            cohere(boids) {
                const neighborDist = 50;
                let sum = {x: 0, y: 0};
                let count = 0;
                this.neighbors = [];
                
                for (let other of boids) {
                    const d = this.distance(other);
                    if (d > 0 && d < neighborDist) {
                        sum.x += other.x;
                        sum.y += other.y;
                        count++;
                        this.neighbors.push(other);
                    }
                }
                
                if (count > 0) {
                    sum.x /= count;
                    sum.y /= count;
                    return {x: (sum.x - this.x) * 0.05, y: (sum.y - this.y) * 0.05};
                }
                
                return {x: 0, y: 0};
            }
            
            distance(other) {
                const dx = this.x - other.x;
                const dy = this.y - other.y;
                return Math.sqrt(dx * dx + dy * dy);
            }
            
            draw() {
                // Apply camera transform
                const screenX = (this.x + camera.x) * camera.zoom;
                const screenY = (this.y + camera.y) * camera.zoom;
                const screenSize = this.size * camera.zoom;
                
                // Draw connections to neighbors
                ctx.strokeStyle = this.color + '22';
                ctx.lineWidth = 0.5 * camera.zoom;
                for (let neighbor of this.neighbors) {
                    const neighborX = (neighbor.x + camera.x) * camera.zoom;
                    const neighborY = (neighbor.y + camera.y) * camera.zoom;
                    ctx.beginPath();
                    ctx.moveTo(screenX, screenY);
                    ctx.lineTo(neighborX, neighborY);
                    ctx.stroke();
                }
                
                // Draw boid
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(screenX, screenY, screenSize, 0, Math.PI * 2);
                ctx.fill();
                
                // Glow effect
                ctx.shadowBlur = 10 * camera.zoom;
                ctx.shadowColor = this.color;
                ctx.beginPath();
                ctx.arc(screenX, screenY, screenSize, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }
        }
        
        // Load files from mesh
        fetch('http://localhost:8080/social/creations')
            .then(r => r.json())
            .then(data => {
                // Sample 200 files for performance
                const files = data.creations.slice(0, 200);
                boids = files.map(f => new Boid(f));
                document.getElementById('boid-count').textContent = boids.length;
            });
        
        function animate() {
            if (!isPaused) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                let totalConnections = 0;
                for (let boid of boids) {
                    boid.update(boids);
                    boid.draw();
                    totalConnections += boid.neighbors.length;
                }
                
                document.getElementById('connection-count').textContent = Math.floor(totalConnections / 2);
                
                // FPS counter
                frameCount++;
                if (frameCount % 60 === 0) {
                    const now = Date.now();
                    const fps = Math.round(1000 / ((now - lastTime) / 60));
                    document.getElementById('fps').textContent = fps;
                    lastTime = now;
                }
            }
            
            requestAnimationFrame(animate);
        }
        
        function togglePause() {
            isPaused = !isPaused;
            event.target.textContent = isPaused ? '▶️ Play' : '⏸️ Pause';
        }
        
        function zoomIn() {
            camera.zoom = Math.min(camera.zoom * 1.3, 5);
            document.getElementById('zoom-level').textContent = Math.round(camera.zoom * 100) + '%';
        }
        
        function zoomOut() {
            camera.zoom = Math.max(camera.zoom / 1.3, 0.2);
            document.getElementById('zoom-level').textContent = Math.round(camera.zoom * 100) + '%';
        }
        
        function resetCamera() {
            camera.x = 0;
            camera.y = 0;
            camera.zoom = 1;
            document.getElementById('zoom-level').textContent = '100%';
        }
        
        // Mouse controls
        canvas.addEventListener('mousedown', (e) => {
            camera.isDragging = true;
            camera.dragStartX = e.clientX;
            camera.dragStartY = e.clientY;
            canvas.style.cursor = 'grabbing';
        });
        
        canvas.addEventListener('mousemove', (e) => {
            if (camera.isDragging) {
                const dx = e.clientX - camera.dragStartX;
                const dy = e.clientY - camera.dragStartY;
                camera.x += dx / camera.zoom;
                camera.y += dy / camera.zoom;
                camera.dragStartX = e.clientX;
                camera.dragStartY = e.clientY;
            }
        });
        
        canvas.addEventListener('mouseup', () => {
            camera.isDragging = false;
            canvas.style.cursor = 'grab';
        });
        
        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (e.deltaY < 0) {
                zoomIn();
            } else {
                zoomOut();
            }
        });
        
        canvas.style.cursor = 'grab';
        
        animate();
        
        // Resize handling
        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    </script>
