    update() {
        // Blend animation + physics
        const animPose = this.animator.getPose();
        const physicsPose = this.physicsBody.getPose();
        
        this.finalPose = this.blend(animPose, physicsPose, 
                                     this.animationWeight, this.physicsWeight);
        
        // If hit hard, shift to physics
        if (this.impactForce > threshold) {
            this.animationWeight = 0;
            this.physicsWeight = 1;
        }
    }
}
