[Unit]
Description=Pod Gardener V2 - Learning & Website Improvement Service
After=network.target

[Service]
Type=oneshot
User=palmerschallon
WorkingDirectory=/media/palmerschallon/ThePod1
ExecStart=/usr/bin/python3 /media/palmerschallon/ThePod1/pod_gardener_v2.py
StandardOutput=append:/media/palmerschallon/ThePod1/logs/pod_gardener_v2.log
StandardError=append:/media/palmerschallon/ThePod1/logs/pod_gardener_v2.error.log

# Environment
Environment="ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}"
Environment="EMBER_PORT=8083"
Environment="EMBER_WORKING_DIR=/media/palmerschallon/ThePod1"

[Install]
WantedBy=multi-user.target
